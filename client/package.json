{
  "name": "@agentos/client",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "The AgentOS client: an installable PWA shell (Vite + Svelte) that talks to the Bun server over WebSocket JSON-RPC",
  "author": "AgentOS",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.web.json",
    "typecheck": "bun run typecheck:node && bun run svelte-check",
    "test": "bun test ./src",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:web": "vite --port 6200",
    "build:web": "vite build",
    "preview:web": "vite preview --port 6200",
    "storybook": "storybook dev -p 6008 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "dependencies": {
    "@agentos/sdk": "workspace:*",
    "@agentos/ui": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "@agentos/storybook": "workspace:*",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "storybook": "10.6.7"
  }
}
