// SYNTAX.md §6.3: a block-bounded match arm may omit the comma before the next
// arm (its `}` already delimits it); a non-block arm still needs the comma.
fn classify(n: number) -> string {
    match n {
        0 => {
            let label = "zero";
            label
        }
        1 => if n > 0 { "pos" } else { "neg" }
        _ => "many",
    }
}
