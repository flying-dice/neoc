// SYNTAX.md §2-3 + EXTERN.md: the item forms — use, const, type alias, struct,
// enum, trait, impl, fn — and an `extern { }` block, all parse.
use math::vec::Vec3;
const LIMIT: number = 10;
type Id = number;

struct Marker;
struct UserId(number);
struct Point { x: number, y: number }

enum Shape { Circle { radius: number }, Move(number, number), Origin }

trait Show { fn show(self) -> string; fn name(self) -> string { "?" } }

impl Show for Point { fn show(self) -> string { "p" } }
impl Point { fn origin() -> Point { Point { x: 0, y: 0 } } }

extern {
    fn now() -> number;
    struct Response;
    struct Changes { changes: number }
    impl Changes {
        fn total(self) -> number;
    }
    #[extern(path = "vnd:rusqlite")]
    mod rusqlite {
        fn open(path: string) -> Unknown;
    }
}

fn main() {
    let p = Point::origin();
}
