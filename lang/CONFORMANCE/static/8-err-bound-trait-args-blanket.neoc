// STATIC.md §3.4, §3.5: a blanket impl satisfies a bound only at the arguments
// it applies — `Source<number>`, not `Source<string>`.
trait Named {
    fn name(self) -> string;
}

trait Source<T> {
    fn next(self) -> T;
}

impl<U: Named> Source<number> for U {
    fn next(self) -> number {
        1
    }
}

struct A {
    n: string,
}

impl Named for A {
    fn name(self) -> string {
        self.n
    }
}

fn pull<S: Source<string>>(s: S) -> string {
    s.next()
}

fn main() {
    pull(A { n: "a" });
}
