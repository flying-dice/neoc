// STATIC.md §3.4: the existential is type-erasing — a trait-typed value is not
// assignable back to a concrete type (no implicit downcast).
trait Drawable {
  fn draw(self) -> string;
}

struct Circle;

impl Drawable for Circle {
  fn draw(self) -> string {
    "o"
  }
}

fn get() -> Drawable {
  Circle
}

fn use_it() -> string {
  let c: Circle = get();
  "x"
}
