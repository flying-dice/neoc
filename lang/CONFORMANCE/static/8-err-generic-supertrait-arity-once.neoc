// STATIC.md §3.4: a supertrait spelled with the wrong arity is reported once,
// on the trait — not again as a missing supertrait at each impl.
trait Base<T> {
    fn base(self) -> T;
}

trait Sub<T>: Base {
    fn sub(self) -> T;
}

struct C {
    n: number,
}

impl Sub<number> for C {
    fn sub(self) -> number {
        self.n
    }
}
