// STATIC.md §4.3 (D-ALIAS-ARITY): an impl header is a use, so its target's
// type arguments are held to alias arity, inherent and trait impl alike.
type Pair<T> = [T];

struct Box<T> {
    v: T,
}

impl Box<Pair> {
    fn get(self) -> number {
        1
    }
}

trait Tr {
    fn f(self) -> number;
}

impl Tr for Box<Pair<number, number>> {
    fn f(self) -> number {
        1
    }
}
