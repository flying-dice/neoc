// STATIC.md §3.4, §3.5: a bound `S: Source<number>` is satisfied by a direct
// impl, a generic impl read at its target, a blanket impl, a parameter whose
// own bound agrees, and a subtrait; `next` through it yields `number`.
trait Named {
    fn name(self) -> string;
}

trait Source<T> {
    fn next(self) -> T;
}

trait Rate<T> {
    fn rate(self) -> T;
}

trait Sub<T>: Source<T> {
    fn peek(self) -> T;
}

struct C {
    n: number,
}

impl Source<number> for C {
    fn next(self) -> number {
        self.n
    }
}

impl Sub<number> for C {
    fn peek(self) -> number {
        self.n
    }
}

struct Box<U> {
    v: U,
}

impl<U> Source<U> for Box<U> {
    fn next(self) -> U {
        self.v
    }
}

struct A {
    n: string,
}

impl Named for A {
    fn name(self) -> string {
        self.n
    }
}

impl<U: Named> Rate<number> for U {
    fn rate(self) -> number {
        1
    }
}

fn pull<S: Source<number>>(s: S) -> number {
    s.next()
}

fn rated<S: Rate<number>>(s: S) -> number {
    s.rate()
}

fn pull_where<S>(s: S) -> number where S: Source<number> {
    s.next()
}

fn forward<S: Source<number>>(s: S) -> number {
    pull(s)
}

fn from_sub<S: Sub<number>>(s: S) -> number {
    pull(s) + s.peek()
}

struct Holder<S: Source<number>> {
    s: S,
}

fn main() {
    pull(C { n: 1 });
    pull(Box { v: 2 });
    rated(A { n: "a" });
    pull_where(C { n: 1 });
    forward(C { n: 1 });
    from_sub(C { n: 1 });
    Holder { s: C { n: 1 } };
}
