// STATIC.md §3.5: a callee's `Source<T>` parameter binds `T` from the
// argument's application — a `Source<number>` value, or a `C` whose impl
// applies `Source<number>`.
trait Source<T> {
    fn next(self) -> T;
}

struct C {
    n: number,
}

impl Source<number> for C {
    fn next(self) -> number {
        self.n
    }
}

fn pull<T>(s: Source<T>) -> T {
    s.next()
}

fn go(s: Source<number>) -> number {
    pull(s)
}

fn go_impl(c: C) -> number {
    pull(c)
}
