// STATIC.md §3.4, §3.5: a type implements a trait at most once — two impls of
// `Source` for `C` conflict even at different arguments.
trait Source<T> {
    fn next(self) -> T;
}

struct C {
    n: number,
}

impl Source<number> for C {
    fn next(self) -> number {
        self.n
    }
}

impl Source<string> for C {
    fn next(self) -> string {
        "c"
    }
}
