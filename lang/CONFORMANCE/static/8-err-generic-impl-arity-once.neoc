// STATIC.md §3.4, §8: an impl header with the wrong arity is reported once, at
// the impl — not again at a call passing its target into `Source<number>`.
trait Source<T> {
    fn next(self) -> T;
}

struct C {
    n: number,
}

impl Source<number, string> for C {
    fn next(self) -> number {
        self.n
    }
}

fn pull(s: Source<number>) -> number {
    s.next()
}

fn main() {
    pull(C { n: 1 });
}
