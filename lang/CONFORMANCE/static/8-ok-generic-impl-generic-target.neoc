// STATIC.md §3.4: reading `impl<U> Source<U> for Box<U>` for `Box<number>` fixes
// `U` as `number`, so `Box<number>` flows into `Source<number>`.
trait Source<T> {
    fn next(self) -> T;
}

struct Box<U> {
    v: U,
}

impl<U> Source<U> for Box<U> {
    fn next(self) -> U {
        self.v
    }
}

fn pull(source: Source<number>) -> number {
    source.next()
}

fn main() {
    pull(Box { v: 1 });
}
