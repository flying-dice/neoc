// STATIC.md §8: an impl method is checked against the trait's signature with
// the trait's parameters read as the impl's arguments — `next` returns `string`
// where `Source<number>` requires `number`.
trait Source<T> {
    fn next(self) -> T;
}

struct Counter {
    n: number,
}

impl Source<number> for Counter {
    fn next(self) -> string {
        "x"
    }
}
