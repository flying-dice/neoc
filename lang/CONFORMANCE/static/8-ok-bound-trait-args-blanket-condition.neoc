// STATIC.md §3.5: `C` implements `Source<number>`, so it meets the blanket
// condition `U: Source<number>` and satisfies `Rate`.
trait Source<T> {
    fn next(self) -> T;
}

trait Rate {
    fn rate(self) -> number;
}

impl<U: Source<number>> Rate for U {
    fn rate(self) -> number {
        self.next()
    }
}

struct C {
    n: number,
}

impl Source<number> for C {
    fn next(self) -> number {
        self.n
    }
}

fn rated<S: Rate>(s: S) -> number {
    s.rate()
}

fn main() {
    rated(C { n: 1 });
}
