// STATIC.md §8: a type has one method table, so two implemented traits may not
// both give it a default of the same name. Each inheriting impl is an error.
trait A {
    fn a(self) -> string {
        "A"
    }
}

trait B {
    fn a(self) -> number {
        1
    }
}

struct D;

impl A for D {}

impl B for D {}
