// STATIC.md §3.5: a call whose argument type satisfies the parameter's bound
// (here `Wrap` implements `Sink`) is well-typed.
trait Sink {
    fn take(self, x: string) -> bool;
}

struct Wrap(number);

impl Sink for Wrap {
    fn take(self, x: string) -> bool {
        true
    }
}

fn run<T: Sink>(s: T) -> bool {
    s.take("hi")
}

fn go() -> bool {
    run(Wrap(1))
}
