// STATIC.md §3.4, §3.5: `C` implements `Source<string>`, so it does not satisfy
// the bound `Source<number>`.
trait Source<T> {
    fn next(self) -> T;
}

struct C {
    n: string,
}

impl Source<string> for C {
    fn next(self) -> string {
        self.n
    }
}

fn pull<S: Source<number>>(s: S) -> number {
    s.next()
}

fn main() {
    pull(C { n: "c" });
}
