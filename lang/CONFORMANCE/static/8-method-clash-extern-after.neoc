// STATIC.md §8: a neoc `impl` method may not redeclare a method of an extern
// `impl` on the same type, in either declaration order.
extern {
    struct Settings {}
}

extern {
    impl Settings {
        fn rename(self, t: string) -> string;
    }
}

impl Settings {
    fn rename(self, t: string) -> string {
        t
    }
}
