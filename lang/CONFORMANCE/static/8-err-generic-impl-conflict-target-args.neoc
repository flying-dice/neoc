// STATIC.md §3.4, §3.5: a type implements a trait at most once — `Box<number>`
// and `Box<string>` are one type constructor with erased arguments, so two
// impls of `Source` for them conflict.
trait Source<T> {
    fn next(self) -> T;
}

struct Box<U> {
    v: U,
}

impl Source<number> for Box<number> {
    fn next(self) -> number {
        self.v
    }
}

impl Source<string> for Box<string> {
    fn next(self) -> string {
        self.v
    }
}
