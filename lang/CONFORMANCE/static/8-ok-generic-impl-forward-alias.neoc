// STATIC.md §3.4: an impl's trait arguments expand aliases declared later in
// the module — `Num` names `number`, so `Counter` flows into `Source<number>`.
trait Source<T> {
    fn next(self) -> T;
}

struct Counter {
    n: number,
}

impl Source<Num> for Counter {
    fn next(self) -> number {
        self.n
    }
}

type Num = number;

fn pull(source: Source<number>) -> number {
    source.next()
}

fn main() {
    pull(Counter { n: 1 });
}
