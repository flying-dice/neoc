// STATIC.md §3.4: `Self` among an impl header's trait arguments is the target —
// `impl Source<Self> for C` applies `Source<C>`.
trait Source<T> {
    fn next(self) -> T;
}

struct C {
    n: number,
}

impl Source<Self> for C {
    fn next(self) -> C {
        self
    }
}

fn via(s: Source<C>) -> C {
    s.next()
}

fn main() {
    via(C { n: 1 });
}
