// STATIC.md §8: a default of a generic trait is checked once with `T` as the
// trait's parameter; inherited through `impl Source<number> for Counter`, its
// signature reads `T` as `number`, so `peek` returns `number` and `twice`
// takes one.
trait Source<T> {
    fn next(self) -> T;

    fn peek(self) -> T {
        self.next()
    }

    fn twice(self, item: T) -> [T] {
        [item, self.next()]
    }
}

struct Counter {
    n: number,
}

impl Source<number> for Counter {
    fn next(self) -> number {
        self.n
    }
}

fn main() {
    let c = Counter { n: 1 };
    let a: number = c.peek();
    let b: [number] = c.twice(2);
}
