// STATIC.md §8: an inherited default of `Source<number>` reads `T` as
// `number` — passing a `string`, or reading the result as a `string`, is
// rejected — and an override is checked against the default's signature read
// the same way.
trait Source<T> {
    fn next(self) -> T;

    fn peek(self) -> T {
        self.next()
    }

    fn feed(self, item: T) -> T {
        item
    }
}

struct Counter {
    n: number,
}

impl Source<number> for Counter {
    fn next(self) -> number {
        self.n
    }

    fn feed(self, item: string) -> number {
        self.n
    }
}

struct Meter {
    n: number,
}

impl Source<number> for Meter {
    fn next(self) -> number {
        self.n
    }
}

fn main() {
    let m = Meter { n: 1 };
    let a: string = m.peek();
    let b = m.feed("x");
}
