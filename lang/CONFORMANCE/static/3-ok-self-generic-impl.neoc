// STATIC.md §3.3, §3.5: inside `impl<T> Wrap<T>`, `Self` is `Wrap<T>` — in
// signatures, annotations, nested types, and trait-impl methods.
struct Wrap<T> {
    v: T,
}

enum Opt<T> {
    Some(T),
    None,
}

trait Dup {
    fn dup(self) -> Self;
}

impl<T> Wrap<T> {
    fn new(v: T) -> Self {
        Wrap { v }
    }

    fn make(v: T) -> Self {
        let w: Self = Wrap { v };
        w
    }

    fn lit(v: T) -> Self {
        Self { v }
    }

    fn both(a: Self, b: Self) -> [Self] {
        [a, b]
    }

    fn some(self) -> Opt<Self> {
        Opt::Some(self)
    }
}

impl<T> Opt<T> {
    fn keep(self) -> Self {
        self
    }
}

impl<T> Dup for Wrap<T> {
    fn dup(self) -> Self {
        self
    }
}

impl<T> Wrap<T> {
    fn rebase(self) -> Self {
        Self { ..self }
    }

    fn rebase_named(self) -> Wrap<T> {
        Wrap { ..self }
    }
}
