// EXTERN.md §Option marshalling: host-ness belongs to a declaration. A method
// both the host and a neoc `impl` declare on one type is ambiguous at the call
// site, whichever is written first.
impl Settings {
    fn rename(self, t: Option<string>) -> Option<string> {
        t
    }
}

extern {
    struct Settings {
        size: number,
    }
    impl Settings {
        fn rename(self, t: Option<string>) -> Option<string>;
    }
}

fn main() {}
