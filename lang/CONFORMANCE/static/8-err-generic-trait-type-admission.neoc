// STATIC.md §3.4: an implementor flows into a generic trait type only at the
// arguments its impl applies — `Source<string>`, not `Source<number>`.
trait Source<T> {
    fn next(self) -> T;
}

struct C {
    n: string,
}

impl Source<string> for C {
    fn next(self) -> string {
        self.n
    }
}

fn pull(source: Source<number>) -> number {
    source.next()
}

fn main() {
    pull(C { n: "c" });
}
