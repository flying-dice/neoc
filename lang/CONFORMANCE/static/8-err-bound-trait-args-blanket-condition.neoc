// STATIC.md §3.5: a blanket condition keeps its trait arguments — `C`
// implements `Source<string>`, so it does not meet `U: Source<number>` and the
// blanket impl of `Rate` does not apply.
trait Source<T> {
    fn next(self) -> T;
}

trait Rate {
    fn rate(self) -> number;
}

impl<U: Source<number>> Rate for U {
    fn rate(self) -> number {
        self.next()
    }
}

struct C {
    n: string,
}

impl Source<string> for C {
    fn next(self) -> string {
        self.n
    }
}

fn rated<S: Rate>(s: S) -> number {
    s.rate()
}

fn main() {
    rated(C { n: "c" });
}
