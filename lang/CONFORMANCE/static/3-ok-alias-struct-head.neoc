struct P {
    x: number,
}

type A = P;

impl A {
    fn mk() -> Self {
        Self { x: 7 }
    }
}

fn main() {
    let a = A { x: 4 };
    let b: P = A::mk();
    let c = A { x: 1, ..b };
}

struct Id(number);

type I = Id;

fn g(p: P) -> number {
    match p {
        A { x } => x,
    }
}

fn h(i: Id) -> number {
    match i {
        I(x) => x,
    }
}
