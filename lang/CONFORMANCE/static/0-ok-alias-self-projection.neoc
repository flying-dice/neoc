// STATIC.md §4.3 (D-ALIAS-ARITY): `Self::Item` names an associated type, not
// an alias that shares its name.
type Item<T> = [T];

trait Container {
    type Item;

    fn first(self) -> Self::Item;
}

struct Bag {
    v: number,
}

impl Container for Bag {
    type Item = number;

    fn first(self) -> Self::Item {
        self.v
    }
}
