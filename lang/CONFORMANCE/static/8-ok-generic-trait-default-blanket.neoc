// STATIC.md §3.5, §8: a default of a generic trait is inherited through a
// blanket impl with its trait arguments applied — `peek` returns `number`.
trait Show {
    fn show(self) -> string;
}

trait Source<T> {
    fn next(self) -> T;

    fn peek(self) -> T {
        self.next()
    }
}

struct C {
    n: number,
}

impl Show for C {
    fn show(self) -> string {
        "c"
    }
}

impl<S: Show> Source<number> for S {
    fn next(self) -> number {
        1
    }
}

fn main() {
    let c = C { n: 1 };
    let a: number = c.peek();
}
