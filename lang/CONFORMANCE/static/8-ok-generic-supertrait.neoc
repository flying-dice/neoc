// STATIC.md §3.4: `impl Sub<number> for C` needs `Base<number>`, which `C`
// implements; `Sub<number>` flows into `Base<number>`, and `next` through
// `Sub<number>` yields `number`.
trait Base<T> {
    fn next(self) -> T;
}

trait Sub<T>: Base<T> {
    fn peek(self) -> T;
}

struct C {
    n: number,
}

impl Base<number> for C {
    fn next(self) -> number {
        self.n
    }
}

impl Sub<number> for C {
    fn peek(self) -> number {
        self.n
    }
}

fn take(source: Base<number>) -> number {
    source.next()
}

fn pass(source: Sub<number>) -> number {
    take(source) + source.next()
}

fn main() {
    pass(C { n: 1 });
}
