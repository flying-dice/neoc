// STATIC.md §8: two blanket impls that both land on a type may not both give it
// a default of the same name. Each blanket reports for the type.
trait Show {
    fn show(self) -> string;
}

trait A {
    fn a(self) -> string {
        "A"
    }
}

trait B {
    fn a(self) -> number {
        1
    }
}

impl<T: Show> A for T {}

impl<T: Show> B for T {}

struct D;

impl Show for D {
    fn show(self) -> string {
        "d"
    }
}
