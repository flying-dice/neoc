// STATIC.md §3.4, §3.5: `pull(s)` with `s: Source<number>` binds `T` to
// `number`, so the call is not a `string`; and `Source<number>` still does not
// flow into `Source<string>`.
trait Source<T> {
    fn next(self) -> T;
}

fn pull<T>(s: Source<T>) -> T {
    s.next()
}

fn bad(s: Source<number>) -> string {
    pull(s)
}

fn take(s: Source<string>) {}

fn admit(s: Source<number>) {
    take(s)
}
