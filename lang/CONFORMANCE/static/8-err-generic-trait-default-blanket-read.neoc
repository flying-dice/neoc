// STATIC.md §3.5, §8: a default inherited through `impl<S: Show> Source<number>
// for S` reads `T` as `number`; reading it as a `string` is rejected.
trait Show {
    fn show(self) -> string;
}

trait Source<T> {
    fn next(self) -> T;

    fn peek(self) -> T {
        self.next()
    }
}

struct C {
    n: number,
}

impl Show for C {
    fn show(self) -> string {
        "c"
    }
}

impl<S: Show> Source<number> for S {
    fn next(self) -> number {
        1
    }
}

fn main() {
    let c = C { n: 1 };
    let a: string = c.peek();
}
