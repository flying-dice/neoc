// STATIC.md §3.4: a value whose type does not implement the trait is rejected
// where the trait type is expected — `number` has no `impl Drawable`.
trait Drawable {
    fn draw(self) -> string;
}

struct Circle;

impl Drawable for Circle {
    fn draw(self) -> string {
        "o"
    }
}

fn render(x: Drawable) -> string {
    x.draw()
}

fn go() -> string {
    render(42)
}
