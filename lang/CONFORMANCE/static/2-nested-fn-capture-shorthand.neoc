// STATIC.md §2: a field shorthand names the binding, so it cannot capture an enclosing `let` or parameter.
struct P {
    x: number,
}

fn from_let() -> number {
    let x = 1;
    fn mk() -> P {
        P { x }
    }
    mk().x
}

fn from_param(x: number) -> number {
    fn mk() -> P {
        P { x }
    }
    mk().x
}
