// STATIC.md §3.4: a supertrait reached through `Sub<number>` is read at the
// arguments the declaration maps — `Base<number>` — so `next` yields `number`.
trait Base<T> {
    fn next(self) -> T;
}

trait Sub<T>: Base<T> {
    fn peek(self) -> T;
}

fn pull(source: Sub<number>) -> string {
    source.next()
}
