// DYNAMIC.md §4.5: `match` in statement position — the arms have unit type and
// run for effect rather than yielding a value. It lowers like the expression
// form (scrutinee evaluated once, arms tested in order), wrapped so the matched
// arm's call executes. The `_` arm is the catch-all.
extern {
    fn println(s: string);
}

fn classify(n: number) {
    match n {
        0 => println("zero"),
        1 => println("one"),
        _ => println("many"),
    }
}

fn main() {
    classify(0);
    classify(1);
    classify(7);
}
