// DYNAMIC.md §3.9 + EXTERN.md §Attributes: `#[extern(name = "...")]` renames the
// target identifier, and every lowered reference honours it: the constructor
// (`Flags::new` → `collections.Map.new`), a free `fn` call in an `ambient` `mod`
// (`round_down` → `math.floor`), and a free `fn` outside any `mod`
// (`say` → `print`). Same program declared locally and `use`d from `host`.
use host::Flags;
use host::round_down;

extern {
    #[extern(name = "print")]
    fn say(v: Unknown);
}

pub fn main() {
    say(round_down(7.9));
    let f = Flags::new();
    f.set("a", 1);
    f.set("b", 2);
    say(f.size());
}
