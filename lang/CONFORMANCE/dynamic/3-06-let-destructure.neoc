// DYNAMIC.md §3.6 + §5: an irrefutable `let` pattern destructures a struct,
// binding each field from the initialiser. `let Point { x, y } = p` binds x = 3
// and y = 4, so the sum is 7.
extern {
    fn println(n: number);
}

struct Point {
    x: number,
    y: number,
}

fn main() {
    let p = Point { x: 3, y: 4 };
    let Point { x, y } = p;
    println(x + y);
}
