// DYNAMIC.md §3.6 + §5: a wildcard `let _ = e` discards e's value but still
// runs e for effect. When e is a struct literal the discard keeps its binding
// — `local _ = Point.new({ … })` in the golden — because a bare table literal
// is not a statement in Lua; the constructor still runs, so the Point is built
// and dropped. `println(0)` runs after it to show execution continues past the
// discard.
extern {
    fn println(n: number);
}

struct Point {
    x: number,
    y: number,
}

fn main() {
    let _ = Point { x: 1, y: 2 };
    println(0);
}
