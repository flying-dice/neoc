// DYNAMIC.md §3.6 + §5: a wildcard `let _ = e` discards e's value but still
// runs e for effect. Here e is a struct literal: `Point.new` executes in full
// — field checks and the metatable attach in the golden — with its result
// bound to `_` and never read. `println(0)` printing `0` afterwards shows
// execution continues past the discard: the discard runs e, it does not
// skip it.
extern {
    fn println(n: number);
}

struct Point {
    x: number,
    y: number,
}

fn main() {
    let _ = Point { x: 1, y: 2 };
    println(0);
}
