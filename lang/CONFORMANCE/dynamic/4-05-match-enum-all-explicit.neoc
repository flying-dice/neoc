extern {
    fn print(s: string);
}

enum Shape {
    Dot,
    Move(number, number),
    Circle {
        radius: number,
    },
}

fn describe(s: Shape) -> string {
    match s {
        Shape::Dot => "dot",
        Shape::Move(a, b) => "move",
        Shape::Circle { radius } => "circle",
    }
}

fn main() {
    print(describe(Shape::Dot));
    print(describe(Shape::Move(1, 2)));
    print(describe(Shape::Circle { radius: 5 }));
}
