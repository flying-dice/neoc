// DYNAMIC.md §4.12: `return` in a block, `if`, or `match` used for its value
// leaves the enclosing function, not just the wrapper it lowers to. Each case
// leaves early on one path and runs to the end on the other; the early path
// must skip the code after the wrapper (the `|` suffix) entirely.
extern {
    fn println(s: string);
}

fn in_block(limit: number) -> string {
    let s = "";
    let tag = {
        for i in 0..5 {
            s += "x";
            if i == limit {
                return "early";
            }
        }
        "done"
    };
    s + "|" + tag
}

fn in_if(early: bool) -> string {
    let tag = if early {
        return "early"
    } else {
        "done"
    };
    "|" + tag
}

fn in_match(r: Result<string, string>) -> Result<string, string> {
    let v = match r {
        Ok(v) => v,
        Err(e) => return Err(e),
    };
    Ok("|" + v)
}

fn nested(n: number) -> string {
    let r = if n > 0 {
        {
            if n > 5 {
                return "big";
            }
            "small"
        }
    } else {
        "none"
    };
    "|" + r
}

fn closure_return(n: number) -> string {
    let f = |y| {
        if y > 0 {
            return "pos";
        }
        "other"
    };
    f(n) + "|" + "after"
}

fn show(r: Result<string, string>) -> string {
    match r {
        Ok(v) => v,
        Err(e) => e,
    }
}

fn main() {
    println(in_block(1));
    println(in_block(9));
    println(in_if(true));
    println(in_if(false));
    println(show(in_match(Err("bad"))));
    println(show(in_match(Ok("good"))));
    println(nested(9));
    println(nested(2));
    println(nested(0));
    println(closure_return(1));
    println(closure_return(0));
}
