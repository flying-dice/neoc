// DYNAMIC.md §4.11: `return s` from inside an accumulating loop returns the
// folded string, and a `return` of any other value leaves the function without
// touching it. The fall-through path folds after the loop as usual.
extern {
    fn println(s: string);
}

fn upto(limit: number) -> string {
    let s = "";
    for i in 0..10 {
        s += "x";
        if i == limit {
            return s;
        }
    }
    s + "|end"
}

fn verdict(limit: number) -> string {
    let s = "";
    for i in 0..10 {
        s += "y";
        if i == limit {
            return "early";
        }
    }
    s
}

fn main() {
    println(upto(2));
    println(upto(99));
    println(verdict(3));
    println(verdict(99));
}
