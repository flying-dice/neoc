// DYNAMIC.md §2: a nested fn is hoisted to the head of whichever block declares
// it: a closure body, a loop body that uses `continue`, a `match` arm block.
extern {
    fn println(n: number);
}

fn base() -> number {
    100
}

fn main() {
    let f = |n| {
        let r = n + 1;
        fn twice(k: number) -> number {
            k * 2
        }
        twice(r)
    };
    println(f(4));
    let acc = 0;
    for i in 0..5 {
        fn inc(k: number) -> number {
            k + base()
        }
        if i == 2 {
            continue
        }
        acc = acc + inc(i);
    }
    println(acc);
    let v = match acc > 0 {
        true => {
            fn neg(k: number) -> number {
                0 - k
            }
            neg(acc)
        },
        false => 0,
    };
    println(v);
}
