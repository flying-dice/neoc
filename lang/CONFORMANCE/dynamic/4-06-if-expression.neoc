// DYNAMIC.md §4.6 + §3.6: `if`/`else` in value position (the initialiser of a
// `let`). `let` bindings are reassignable, so the reassignment to `y` is an
// ordinary Lua assignment.
extern {
    fn println(n: number);
}

fn main() {
    let x = 7;
    let y = if x > 5 {
        x * 2
    } else {
        0
    };
    y = y + 1;
    println(y);
}
