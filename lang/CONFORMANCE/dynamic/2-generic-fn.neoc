// A generic function. Type parameters are erased in lowering (DYNAMIC.md §8 —
// neoc's number is Lua's only number type; generics carry no runtime tag), so
// `first` lowers to a plain Lua function returning its first argument. Called at
// `number` it returns 7.
extern {
    fn println(n: number);
}

fn first<T>(a: T, b: T) -> T {
    a
}

fn main() {
    println(first(7, 9));
}
