// STATIC.md §3.3 T-STRUCT-LIT-SELF / DYNAMIC.md §4.4: inside an `impl`, `Self`
// heads a struct literal and names the impl's target — including struct update,
// generic impls, trait impls, and closures in a method body. It lowers exactly
// as the target's own name would.
extern {
    fn println(n: number);
}

struct Point {
    x: number,
    y: number,
}

impl Point {
    fn origin() -> Self {
        Self { x: 0, y: 0 }
    }

    fn at(x: number, y: number) -> Self {
        Self { x, y }
    }

    fn with_x(self, x: number) -> Self {
        Self { x, ..self }
    }

    fn diagonal(n: number) -> Self {
        let make = |k: number| Self { x: k, y: k };
        make(n * 2)
    }
}

trait Make {
    fn make() -> Self;
}

impl Make for Point {
    fn make() -> Self {
        Self { x: 42, y: 0 }
    }
}

struct Wrap<T> {
    v: T,
    n: number,
}

impl<T> Wrap<T> {
    fn of(v: T) -> Wrap<T> {
        Self { v, n: 1 }
    }

    fn with(self, v: T) -> Wrap<T> {
        Self { v, ..self }
    }
}

fn main() {
    let o = Point::origin();
    let p = Point::at(3, 4).with_x(9);
    println(o.x);
    println(p.x);
    println(p.y);
    println(Point::diagonal(4).y);
    println(Point::make().x);
    let w = Wrap::of(5).with(7);
    println(w.v);
    println(w.n);
}
