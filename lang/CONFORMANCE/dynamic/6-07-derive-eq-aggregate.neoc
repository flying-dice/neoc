// DYNAMIC.md §6.2: derived `eq` compares tag and every field structurally, so
// an aggregate field is compared by value, never by table identity. Covers each
// field kind — a nested struct (recursive `eq`), an `Option<number>` and an
// enum payload (tag, then payload), a `[number]` (element-wise) — with the
// unhappy paths: unequal nested value, `None` vs `Some`, differing variant
// tags, differing list length, empty list vs non-empty. Also pins `[Inner]`,
// `Result<number, string>` (`Ok` vs `Err`), nested `Option<Option<Inner>>`, a
// generic `Wrap<T>` at `T = Inner` and `T = number`, and a field whose type has
// a hand-written (not derived) `eq`, which the helper dispatches to.
extern {
    fn println(s: string);
}

#[derive(Eq)]
struct Inner {
    v: number,
}

#[derive(Eq)]
enum Shape {
    Dot,
    Boxed(Inner),
}

#[derive(Eq)]
struct Outer {
    i: Inner,
    o: Option<number>,
    xs: [number],
    s: Shape,
}

#[derive(Eq)]
struct Many {
    ys: [Inner],
    r: Result<number, string>,
    oo: Option<Option<Inner>>,
}

#[derive(Eq)]
struct Wrap<T> {
    v: T,
}

// Equal modulo 10 — a hand-written `eq`, so `1` and `11` compare equal.
struct Mod {
    v: number,
}

impl Mod {
    fn eq(self, o: Mod) -> bool {
        self.v % 10 == o.v % 10
    }
}

#[derive(Eq)]
struct HasMod {
    m: Mod,
}

fn many(y: number, r: Result<number, string>, oo: Option<Option<Inner>>) -> Many {
    Many { ys: [Inner { v: y }], r: r, oo: oo }
}

fn make(v: number, o: Option<number>, xs: [number], s: Shape) -> Outer {
    Outer { i: Inner { v: v }, o: o, xs: xs, s: s }
}

fn main() {
    let base = make(1, Some(1), [1, 2], Shape::Boxed(Inner { v: 2 }));
    let same = make(1, Some(1), [1, 2], Shape::Boxed(Inner { v: 2 }));
    if base == same {
        println("equal");
    }
    if base != make(9, Some(1), [1, 2], Shape::Boxed(Inner { v: 2 })) {
        println("nested-ne");
    }
    if base != make(1, None, [1, 2], Shape::Boxed(Inner { v: 2 })) {
        println("some-vs-none-ne");
    }
    if base != make(1, Some(7), [1, 2], Shape::Boxed(Inner { v: 2 })) {
        println("option-payload-ne");
    }
    if base != make(1, Some(1), [1, 3], Shape::Boxed(Inner { v: 2 })) {
        println("element-ne");
    }
    if base != make(1, Some(1), [1], Shape::Boxed(Inner { v: 2 })) {
        println("length-ne");
    }
    if base != make(1, Some(1), [], Shape::Boxed(Inner { v: 2 })) {
        println("empty-vs-nonempty-ne");
    }
    if base != make(1, Some(1), [1, 2], Shape::Dot) {
        println("tag-ne");
    }
    if base != make(1, Some(1), [1, 2], Shape::Boxed(Inner { v: 3 })) {
        println("enum-payload-ne");
    }
    let none = make(1, None, [], Shape::Dot);
    if none == make(1, None, [], Shape::Dot) {
        println("none-empty-equal");
    }
    let m = many(1, Ok(1), Some(Some(Inner { v: 1 })));
    if m == many(1, Ok(1), Some(Some(Inner { v: 1 }))) {
        println("many-equal");
    }
    if m != many(2, Ok(1), Some(Some(Inner { v: 1 }))) {
        println("list-of-struct-ne");
    }
    if m != many(1, Err("1"), Some(Some(Inner { v: 1 }))) {
        println("ok-vs-err-ne");
    }
    if m != many(1, Ok(2), Some(Some(Inner { v: 1 }))) {
        println("ok-payload-ne");
    }
    if m != many(1, Ok(1), Some(Some(Inner { v: 2 }))) {
        println("nested-option-payload-ne");
    }
    if m != many(1, Ok(1), Some(None)) {
        println("some-some-vs-some-none-ne");
    }
    let w = Wrap { v: Inner { v: 1 } };
    let w_same = Wrap { v: Inner { v: 1 } };
    let w_other = Wrap { v: Inner { v: 2 } };
    if w == w_same {
        println("generic-struct-equal");
    }
    if w != w_other {
        println("generic-struct-ne");
    }
    let n = Wrap { v: 5 };
    let n_same = Wrap { v: 5 };
    let n_other = Wrap { v: 6 };
    if n == n_same {
        println("generic-number-equal");
    }
    if n != n_other {
        println("generic-number-ne");
    }
    let h = HasMod { m: Mod { v: 1 } };
    let h_mod = HasMod { m: Mod { v: 11 } };
    let h_other = HasMod { m: Mod { v: 2 } };
    if h == h_mod {
        println("hand-written-eq");
    }
    if h != h_other {
        println("hand-written-ne");
    }
}
