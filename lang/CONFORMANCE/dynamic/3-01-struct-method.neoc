// DYNAMIC.md §3.1 + §3.3 + §4.7: a `struct` value is a tagged Lua table;
// `impl` methods attach to the type table; field access is `.f` and a method
// call `p.method(...)` lowers to the Lua colon call `p:method(...)`, passing the
// receiver as `self` via the metatable.
ext fn println(n: number);

struct Point {
    x: number,
    y: number,
}

impl Point {
    fn manhattan(self) -> number {
        self.x + self.y
    }
}

fn main() {
    let p = Point { x: 3, y: 4 };
    println(p.x);
    println(p.manhattan());
}
