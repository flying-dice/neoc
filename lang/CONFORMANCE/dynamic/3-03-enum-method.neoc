// DYNAMIC.md §3.2 + §3.3: an enum with an `impl` block gets a method table and
// every variant value is `setmetatable`d onto it, so a method call dispatches
// via the metatable like a struct. `Dir::E` reports "east".
extern {
    fn println(s: string);
}

enum Dir {
    N,
    S,
    E,
    W,
}

impl Dir {
    fn name(self) -> string {
        match self {
            Dir::N => "north",
            Dir::S => "south",
            Dir::E => "east",
            Dir::W => "west",
        }
    }
}

fn main() {
    let d = Dir::E;
    println(d.name());
}
