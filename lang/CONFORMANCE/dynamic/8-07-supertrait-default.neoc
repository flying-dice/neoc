// STATIC.md §3.4: a type implementing `Greet: Show` also implements `Show`, and
// each trait's defaults land on the type. `shout` (a `Show` default) and
// `greet` (a `Greet` default calling the `Show` default) both resolve on `Badger`.
extern {
    fn println(s: string);
}

trait Show {
    fn show(self) -> string;

    fn shout(self) -> string {
        self.show() + "!"
    }
}

trait Greet: Show {
    fn greet(self) -> string {
        "Hi, " + self.shout()
    }
}

struct Badger {
    name: string,
}

impl Show for Badger {
    fn show(self) -> string {
        self.name
    }
}

impl Greet for Badger {}

fn main() {
    let b = Badger { name: "Bram" };
    println(b.shout());
    println(b.greet());
}
