// DYNAMIC.md §4.11: `break` only leaves the loop, so the fold after it still
// runs and the string holds exactly the appends made before the break. `while`
// and `loop` accumulate like `for`, and `continue` skips an append cleanly.
extern {
    fn println(s: string);
}

fn main() {
    let s = "";
    let i = 0;
    loop {
        i = i + 1;
        if i == 2 {
            continue
        }
        s += "x";
        if i == 5 {
            break
        }
    }
    println(s);
    let w = "w";
    let n = 0;
    while n < 3 {
        n = n + 1;
        w += "!";
    }
    println(w);
}
