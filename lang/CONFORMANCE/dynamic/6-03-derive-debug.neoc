// DYNAMIC.md §6.3: `#[derive(Debug)]` emits `Point.debug(self)` producing the
// developer-facing string — the type name and braced field values, the analogue
// of Rust's `{:?}`. The method is called explicitly as `p.debug()`.
ext fn println(s: string);

#[derive(Debug)]
struct Point {
    x: number,
    y: number,
}

fn main() {
    let p = Point { x: 1, y: 2 };
    println(p.debug());
}
