// STATIC.md §3.4, §8; DYNAMIC.md §3.4: defaults of a generic trait are
// inherited at each impl's trait arguments — direct (`Source<number>`, `Source<string>`) and
// generic-target (`impl<U> Source<U> for Box<U>`) — and dispatch through a
// generic `Source<T>` parameter. Trait arguments are erased.
extern {
    fn println(n: number);
}

trait Source<T> {
    fn next(self) -> T;

    fn peek(self) -> T {
        self.next()
    }

    fn twice(self, item: T) -> [T] {
        [item, self.peek()]
    }
}

struct Counter {
    n: number,
}

struct Namer {
    s: string,
}

impl Source<number> for Counter {
    fn next(self) -> number {
        self.n
    }
}

impl Source<string> for Namer {
    fn next(self) -> string {
        self.s
    }
}

struct Box<U> {
    v: U,
}

impl<U> Source<U> for Box<U> {
    fn next(self) -> U {
        self.v
    }
}

fn pull<T>(s: Source<T>) -> [T] {
    s.twice(s.peek())
}

fn main() {
    let c = Counter { n: 4 };
    println(c.peek());
    println(c.twice(9)[0]);
    println(c.twice(9)[1]);
    let n = Namer { s: "a" };
    let t: string = n.peek();
    let b = Box { v: 7 };
    println(b.peek());
    println(pull(c)[0]);
    println(pull(b)[1]);
}
