// DYNAMIC.md §4.5 + §5: a `match` over a `bool` scrutinee with literal arms.
// Both `true` and `false` must be covered for the match to be exhaustive
// (STATIC.md §7).
extern {
    fn println(s: string);
}

fn yes_no(b: bool) -> string {
    match b {
        true => "yes",
        false => "no",
    }
}

fn main() {
    println(yes_no(true));
    println(yes_no(false));
}
