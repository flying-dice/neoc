// DYNAMIC.md §4.3: a range outside a `for` head is a value — the list of its
// numbers. `1..4` is half-open → [1, 2, 3]; `1..=4` is inclusive → [1, 2, 3, 4].
// Binding forces the range into value position (the codegen path a `for` head
// bypasses); iterating the binding proves it materialised to a real list.
extern {
    fn println(n: number);
}

fn main() {
    let half = 1..4;
    let incl = 1..=4;
    let sum = 0;
    for x in half {
        sum = sum + x;
    }
    for y in incl {
        sum = sum + y;
    }
    println(sum);
}
