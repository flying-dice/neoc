// DYNAMIC.md §3.4 / STATIC.md §3.5: a blanket impl `impl<T: Show> Describe for T`
// gives every `Show` type a `Describe`. At codegen the blanket expands to a
// concrete `impl Describe for Dog`, so `d.describe()` dispatches to a real
// method that calls `d.show()`.
ext fn println(s: string);

trait Show {
    fn show(self) -> string;
}

trait Describe {
    fn describe(self) -> string;
}

impl<T: Show> Describe for T {
    fn describe(self) -> string {
        self.show()
    }
}

struct Dog {
    name: string,
}

impl Show for Dog {
    fn show(self) -> string {
        self.name
    }
}

fn main() {
    let d = Dog { name: "Rex" };
    println(d.describe());
}
