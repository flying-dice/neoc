// DYNAMIC.md §4.10: `?` on a `Result`. The guard is hoisted into the enclosing
// function body, so on `Err` it returns the carrier unchanged and on `Ok` it
// yields the wrapped value. `doubled(true)` propagates `Ok`, `doubled(false)`
// short-circuits the `Err` out of `doubled`.
extern {
    fn println(s: string);
}

fn parse(ok: bool) -> Result<number, string> {
    if ok {
        Ok(10)
    } else {
        Err("bad")
    }
}

fn doubled(ok: bool) -> Result<number, string> {
    let n = parse(ok)?;
    Ok(n + n)
}

fn show(r: Result<number, string>) -> string {
    match r {
        Ok(n) => "ok",
        Err(e) => e,
    }
}

fn main() {
    println(show(doubled(true)));
    println(show(doubled(false)));
}
