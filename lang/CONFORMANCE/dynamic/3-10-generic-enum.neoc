// DYNAMIC.md §3.1/§4.5: a generic `enum Tree<T>` erases its type parameter; each
// value is a tagged table (`__enum`/`__tag`, tuple payload at `_0`). `value`
// matches a `Tree<number>`, binding the `Leaf` payload and returning 0 for the
// unit `Empty` variant. Constructs one of each.
extern {
    fn println(n: number);
}

enum Tree<T> {
    Leaf(T),
    Empty,
}

fn value(t: Tree<number>) -> number {
    match t {
        Tree::Leaf(n) => n,
        Tree::Empty => 0,
    }
}

fn main() {
    println(value(Tree::Leaf(5)));
    println(value(Tree::Empty));
}
