// DYNAMIC.md §4.6: an `else if` chain in value position lowers to nested
// value-`if` IIFEs; only the first matching branch's value is produced. The
// existing §4.6 case is a single if/else.
extern {
    fn println(s: string);
}

fn grade(n: number) -> string {
    if n >= 90 {
        "A"
    } else if n >= 80 {
        "B"
    } else if n >= 70 {
        "C"
    } else {
        "F"
    }
}

fn main() {
    println(grade(95));
    println(grade(82));
    println(grade(40));
}
