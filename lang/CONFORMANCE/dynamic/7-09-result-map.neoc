// DYNAMIC.md §7: `Result::map` applies the closure under `Ok` and threads `Err`
// through unchanged. The method-level generic `U` follows the closure.
extern {
    fn println(n: number);
}

fn read(r: Result<number, string>) -> number {
    match r {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn main() {
    let ok: Result<number, string> = Ok(10);
    let err: Result<number, string> = Err("e");
    println(read(ok.map(|x| x + 5)));
    println(read(err.map(|x| x + 5)));
}
