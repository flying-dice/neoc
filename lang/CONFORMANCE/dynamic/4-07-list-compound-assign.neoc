// DYNAMIC.md §9.3 / §4.7: a compound element-assignment `e[i] op= v` desugars
// to `e[i] = e[i] op v`, reading the element before storing back. The desugar
// is visible in the emit: the offset expression appears twice, once as the
// read and once as the store target (`xs[(0) + 1] = xs[(0) + 1] + 10`) —
// unlike a pure write `e[i] = v`, which emits it once (see
// 4-07-list-element-assign). A second op on `xs[0]` folds the first op's
// result and a variable index drives the runtime-resolved read+write, so the
// golden proves the read half landed — a bare overwrite would print the
// operands, not the folded values.
extern {
    fn println(n: number);
}

fn main() {
    let xs = [1, 2, 3];
    xs[0] += 10;
    xs[0] *= 2;
    xs[1] *= 5;
    let i = 2;
    xs[i] -= 1;
    println(xs[0]);
    println(xs[1]);
    println(xs[2]);
}
