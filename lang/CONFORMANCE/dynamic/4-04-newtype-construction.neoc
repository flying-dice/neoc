// DYNAMIC.md §4.4: constructing a tuple/newtype struct by calling it
// (`Wrapper(42)`) routes through the generated `.new`, so the value carries its
// `__struct` tag and metatable. A method then dispatches via `:`, and an
// irrefutable `let` destructures the `[1]` payload. Both read 42 back out.
ext fn println(n: number);

struct Wrapper(number);

impl Wrapper {
    fn get(self) -> number {
        let Wrapper(n) = self;
        n
    }
}

fn main() {
    let w = Wrapper(42);
    println(w.get());
    let Wrapper(m) = w;
    println(m);
}
