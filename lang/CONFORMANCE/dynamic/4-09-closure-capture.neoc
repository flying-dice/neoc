// DYNAMIC.md §4.9: a closure captures its enclosing environment — a returned
// closure reads the captured binding (a Lua upvalue / JS lexical arrow). The
// existing closure case passes a closure as an argument; this returns one.
extern {
    fn println(n: number);
}

fn adder(base: number) -> fn(number) -> number {
    |x| x + base
}

fn main() {
    let add10 = adder(10);
    println(add10(5));
    println(add10(32));
}
