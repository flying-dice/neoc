// DYNAMIC.md §6: the four built-in derives on an *enum*. Slices 1–5 covered
// only struct derives, so the per-variant Clone/Eq/Debug/Display emit paths —
// tag dispatch plus a tuple payload — never ran. `#[derive(Clone, Eq, Debug,
// Display)]` on an enum with a payload variant (`Pulse`) and a unit variant
// (`Idle`) exercises every branch: Clone copies tag and payload; `==`/`!=`
// lower to the derived structural Eq (matching tag + payload, differing tag,
// differing payload); Debug renders `Pulse(7)` and the bare `Idle`; Display
// renders the decoration-free `7` and `Idle`.
extern {
    fn println(s: string);
}

#[derive(Clone, Eq, Debug, Display)]
enum Signal {
    Pulse(number),
    Idle,
}

fn main() {
    let a = Signal::Pulse(7);
    let b = a.clone();
    if a == b {
        println("clone-eq");
    }
    let c = Signal::Idle;
    if a != c {
        println("tag-ne");
    }
    let d = Signal::Pulse(9);
    if a != d {
        println("payload-ne");
    }
    println(a.debug());
    println(c.debug());
    println(a.display());
    println(c.display());
}
