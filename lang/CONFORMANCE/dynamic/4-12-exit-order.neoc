// DYNAMIC.md §4.12: a wrapper that can leave early still evaluates in source
// order. Operands to its left run before it; the right side of `&&` and `||`
// runs only when the left does not decide the result.
extern {
    fn println(s: string);
}

struct Pair {
    a: number,
    b: number,
}

fn mark(s: string) -> number {
    println(s);
    1
}

fn add(a: number, b: number) -> number {
    a + b
}

fn call_args(stop: bool) -> string {
    let n = add(mark("left"), {
        if stop {
            return "stopped";
        }
        mark("right")
    });
    if n == 2 {
        "sum"
    } else {
        "?"
    }
}

fn fields(stop: bool) -> string {
    let p = Pair { a: mark("a"), b: {
        if stop {
            return "stopped";
        }
        mark("b")
    } };
    if p.a + p.b == 2 {
        "pair"
    } else {
        "?"
    }
}

fn lazy_and(a: bool) -> string {
    let ok = a && {
        if a {
            return "rhs ran";
        }
        true
    };
    if ok {
        "true"
    } else {
        "false"
    }
}

fn lazy_or(a: bool) -> string {
    let ok = a || {
        if !a {
            return "rhs ran";
        }
        true
    };
    if ok {
        "true"
    } else {
        "false"
    }
}

struct Pt {
    x: number,
    y: number,
}

fn shorthand(stop: bool) -> string {
    let x = 1;
    let p = Pt { x, y: {
        if stop {
            return "stopped";
        }
        x += 10;
        2
    } };
    if p.x == 1 {
        "bound"
    } else {
        "shifted"
    }
}

fn range_bounds(stop: bool) -> string {
    let s = "";
    for i in mark("lo")..({
        if stop {
            return "stopped";
        }
        mark("hi") + 2
    }) {
        s += "r";
    }
    s
}

fn update(stop: bool) -> string {
    let p = Pt { x: 1, y: 2 };
    let q = Pt { y: mark("y"), ..({
        if stop {
            return "stopped";
        }
        p
    }) };
    if q.x == 1 {
        "kept"
    } else {
        "?"
    }
}

fn main() {
    println(call_args(false));
    println(call_args(true));
    println(fields(false));
    println(fields(true));
    println(lazy_and(false));
    println(lazy_and(true));
    println(lazy_or(true));
    println(lazy_or(false));
    println(shorthand(false));
    println(shorthand(true));
    println(range_bounds(false));
    println(range_bounds(true));
    println(update(false));
    println(update(true));
}
