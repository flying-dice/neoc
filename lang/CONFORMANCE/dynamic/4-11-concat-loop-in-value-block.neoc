// DYNAMIC.md §4.11, condition 5: a loop inside a block, `if`, or `match` used
// for its value keeps the plain `..` lowering. That form lowers to an IIFE,
// where a `return` or `?` leaves through the exit protocol (§4.12) — past any
// fold after the loop. Both the paths that run to the end and the early exits
// run here.
extern {
    fn println(s: string);
}

fn step(i: number, limit: number) -> Result<number, string> {
    if i == limit {
        Err("stop")
    } else {
        Ok(i)
    }
}

fn in_block(limit: number) -> string {
    let s = "";
    let tag = {
        for i in 0..3 {
            s += "x";
            if i == limit {
                return "early";
            }
        }
        "done"
    };
    s + "|" + tag
}

fn in_if(limit: number) -> string {
    let s = "";
    let tag = if limit >= 0 {
        for i in 0..3 {
            s += "y";
            if i == limit {
                return s;
            }
        }
        "done"
    } else {
        "neg"
    };
    s + "|" + tag
}

fn in_try(limit: number) -> Result<string, string> {
    let s = "";
    let tag = {
        for i in 0..3 {
            s += "z";
            let n = step(i, limit)?;
        }
        "done"
    };
    Ok(s + "|" + tag)
}

fn show(r: Result<string, string>) -> string {
    match r {
        Ok(v) => v,
        Err(e) => e,
    }
}

fn main() {
    println(in_block(99));
    println(in_if(99));
    println(in_if(-1));
    println(show(in_try(99)));
    println(in_block(1));
    println(in_if(1));
    println(show(in_try(1)));
}
