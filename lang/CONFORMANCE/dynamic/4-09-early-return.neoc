// DYNAMIC.md §4.9: an early `return e` inside a conditional exits the enclosing
// function immediately, before the trailing expression. Only `?` exercises a
// mid-body return today, never an explicit `return`.
extern {
    fn println(n: number);
}

fn clamp(n: number) -> number {
    if n < 0 {
        return 0;
    }
    if n > 100 {
        return 100;
    }
    n
}

fn main() {
    println(clamp(-5));
    println(clamp(250));
    println(clamp(42));
}
