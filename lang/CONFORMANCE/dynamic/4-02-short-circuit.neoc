// DYNAMIC.md §4.2: `&&` / `||` short-circuit — the right operand is not
// evaluated once the left already decides the result. They lower to Lua
// `and`/`or`, which are lazy in the same way. A side-effecting rhs (a
// `println`) reveals which operands actually run.
extern {
    fn println(s: string);
}

fn loud(tag: string) -> bool {
    println(tag);
    true
}

fn main() {
    let _ = false && loud("and-skipped");
    let _ = true || loud("or-skipped");
    let _ = true && loud("and-run");
    let _ = false || loud("or-run");
}
