// DYNAMIC.md §3.3: `Self` in an `impl` is the implementing type, so a method may
// name it as a parameter and as a return type. Types are erased at emit; the
// methods are plain entries on the type table.
extern {
    fn println(n: number);
}

struct Meters {
    value: number,
}

impl Meters {
    fn origin() -> Self {
        Meters { value: 0 }
    }

    fn plus(self, other: Self) -> Self {
        Meters { value: self.value + other.value }
    }
}

fn main() {
    let a = Meters { value: 3 };
    let b = Meters { value: 4 };
    println(a.plus(b).value);
    println(Meters::origin().value);
}
