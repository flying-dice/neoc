// DYNAMIC.md §4.4: `S { f: e, .. base }` copies the remaining fields from base,
// then overrides the listed ones. `Point { x: 9, ..p }` keeps y = 2 from p and
// sets x = 9.
ext fn println(n: number);

struct Point {
    x: number,
    y: number,
}

fn main() {
    let p = Point { x: 1, y: 2 };
    let q = Point { x: 9, ..p };
    println(q.x);
    println(q.y);
}
