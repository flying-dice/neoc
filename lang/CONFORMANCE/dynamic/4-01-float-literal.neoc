// DYNAMIC.md §4.1: number literals lower to their host spelling, and neoc's
// `number` is a single double type — `3.0` is the value three, not a distinct
// int. Printed it reads `3` (Lua-reference §8, matched by the Rust anchor); a
// non-integer double like `2.5` reads `2.5`. Arithmetic stays in doubles:
// `1.5 + 1.5` is `3`, `7.5 / 2.0` is `3.75`.
extern {
    fn println(n: number);
}

fn main() {
    println(3.0);
    println(2.5);
    println(1.5 + 1.5);
    println(7.5 / 2.0);
}
