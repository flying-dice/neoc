// DYNAMIC.md §4.2: arithmetic operators lower to their Lua counterparts with
// the usual precedence (`*` before `+`/`-`, `%` at `*` precedence). `number` is
// Lua's single IEEE-754 type, so `/` is true division, not integer division.
ext fn println(n: number);

fn main() {
    println(2 + 3 * 4 - 1);
    println(17 % 5);
    println(10 / 4);
    println(-3 + 1);
}
