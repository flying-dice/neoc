// DYNAMIC.md §3.8: a `type` alias is erased — it emits no output and exists only
// for static checking. Code using the alias lowers exactly as if the underlying
// type were written in its place.
extern {
    fn println(n: number);
}

type Count = number;

fn double(c: Count) -> Count {
    c + c
}

fn main() {
    println(double(7));
    println(double(21));
}
