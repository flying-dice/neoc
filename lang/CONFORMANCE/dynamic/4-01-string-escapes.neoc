// LEXICAL.md §6.3 + DYNAMIC.md §4.1: string-literal escapes (`\t`, `\"`, `\\`)
// are re-encoded into each target's own string escapes and are observable in
// the output. No case exercises any escape.
extern {
    fn println(s: string);
}

fn main() {
    println("a\tb");
    println("q=\"x\"");
    println("back\\slash");
}
