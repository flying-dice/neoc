// STATIC.md §3.4: a trait's associated type (`type Item;`) is erased — it has
// no runtime form and no type-surface name. An implementor binds it
// (`type Item = number`) and the trait method returns `Self::Item`; the binding
// drives the value while the projection drops from the emitted signature — at
// the impl it becomes the bound type, at the abstract trait the target's top
// type. `b.peek()` dispatches through the metatable and returns the bound number.
extern {
    fn println(n: number);
}

trait Container {
    type Item;

    fn peek(self) -> Self::Item;
}

struct Bin {
    value: number,
}

impl Container for Bin {
    type Item = number;

    fn peek(self) -> Self::Item {
        self.value
    }
}

fn main() {
    let b = Bin { value: 7 };
    println(b.peek());
}
