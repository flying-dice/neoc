// DYNAMIC.md §7: `Option::map` applies the closure under `Some` and threads
// `None` through unchanged. The method-level generic `U` follows the closure.
extern {
    fn println(n: number);
}

fn main() {
    let s = Some(20);
    let n: Option<number> = Option::None;
    println(s.map(|x| x + 1).unwrap_or(0));
    println(n.map(|x| x + 1).unwrap_or(0));
}
