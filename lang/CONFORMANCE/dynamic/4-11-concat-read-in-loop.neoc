// DYNAMIC.md §4.11: a loop that reads the string — here in its own condition
// and body — is not rewritten; each append keeps the plain `..` lowering.
extern {
    fn println(s: string);
}

fn main() {
    let s = "";
    while s != "xxx" {
        s += "x";
    }
    println(s);

    let t = "";
    for i in 0..3 {
        t = t + "y";
        println(t);
    }
}
