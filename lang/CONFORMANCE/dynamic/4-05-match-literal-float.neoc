// DYNAMIC.md §5: a float literal pattern tests `__s == <lit>`; Lua's one number
// type makes `0.5` an ordinary equality test.
extern {
    fn println(s: string);
}

fn name(x: number) -> string {
    match x {
        0.5 => "half",
        2.25 => "two-and-a-quarter",
        _ => "other",
    }
}

fn main() {
    println(name(0.5));
    println(name(2.25));
    println(name(3.0));
}
