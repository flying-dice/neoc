// DYNAMIC.md §3.4: an impl of a `use`d trait that omits a default assigns it
// from the trait's table — the body stays in the trait's module, so it may call
// that module's private `prefix`.
use greet::Greet;

extern {
    fn println(s: string);
}

struct D;

impl Greet for D {
    fn name(self) -> string {
        "d"
    }
}

pub fn main() {
    let d = D;
    println(d.hi());
}
