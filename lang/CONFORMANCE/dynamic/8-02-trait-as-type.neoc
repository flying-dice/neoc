// DYNAMIC.md §3.4 / STATIC.md §3.4: a trait used as a type is the existential.
// A trait-typed parameter accepts any implementor, and `shape.draw()`
// dispatches via the value's own metatable — `Circle` and `Square` flow
// through one `Drawable` slot and each resolves its own `draw`.
extern {
    fn println(s: string);
}

trait Drawable {
    fn draw(self) -> string;
}

struct Circle {
    r: number,
}

struct Square {
    side: number,
}

impl Drawable for Circle {
    fn draw(self) -> string {
        "O"
    }
}

impl Drawable for Square {
    fn draw(self) -> string {
        "[]"
    }
}

fn render(shape: Drawable) -> string {
    shape.draw()
}

fn main() {
    println(render(Circle { r: 1 }));
    println(render(Square { side: 2 }));
}
