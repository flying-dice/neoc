// DYNAMIC.md §4.4: a functional-update literal `S { f1, f2, ..base }` overrides
// every listed field and copies the rest from `base`. The existing struct-update
// case overrides only one field; this overrides two.
extern {
    fn println(n: number);
}

struct Vec3 {
    x: number,
    y: number,
    z: number,
}

fn main() {
    let v = Vec3 { x: 1, y: 2, z: 3 };
    let w = Vec3 { x: 10, z: 30, ..v };
    println(w.x);
    println(w.y);
    println(w.z);
}
