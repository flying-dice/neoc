// STATIC.md §3.4 / DYNAMIC.md §3.4: a default-bodied trait method may be
// omitted or overridden by an impl. `Quiet` omits `hi`, so it inherits the
// default — which calls the required `name` on `self`. `Loud` overrides it.
// Both calls dispatch through the type's table.
extern {
    fn println(s: string);
}

trait Greet {
    fn name(self) -> string;

    fn hi(self) -> string {
        "hi " + self.name()
    }
}

struct Quiet {
    n: string,
}

struct Loud {
    n: string,
}

impl Greet for Quiet {
    fn name(self) -> string {
        self.n
    }
}

impl Greet for Loud {
    fn name(self) -> string {
        self.n
    }

    fn hi(self) -> string {
        "HEY " + self.name()
    }
}

fn main() {
    let q = Quiet { n: "ann" };
    let l = Loud { n: "bob" };
    println(q.hi());
    println(l.hi());
}
