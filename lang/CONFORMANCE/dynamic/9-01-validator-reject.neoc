// DYNAMIC.md §9.1 + §9.3 construction: a struct constructor validates each
// declared field. `tonumber` crosses the `extern` seam as `Unknown`, so the
// checker admits it for the `string` field `name`; the validator rejects the
// `number` it produces. The first construction passes; the run stops at the
// second, before the final print.
extern {
    fn println(s: string);
    fn tonumber(s: string) -> Unknown;
}

struct User {
    name: string,
}

fn main() {
    let ada = User { name: "ada" };
    println(ada.name);
    let bad = User { name: tonumber("7") };
    println(bad.name);
}
