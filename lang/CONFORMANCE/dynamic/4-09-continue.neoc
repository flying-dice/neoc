// DYNAMIC.md §4.9 + §8: Lua 5.1 has no `continue`, so a loop body using it is
// restructured with the repeat/break idiom. `continue` skips to the next
// iteration; a neoc `break` still exits the loop. Here i == 3 is skipped and
// i == 7 breaks, so the sum is 0+1+2+4+5+6 = 18.
extern {
    fn println(n: number);
}

fn main() {
    let acc = 0;
    for i in 0..10 {
        if i == 3 {
            continue
        }
        if i == 7 {
            break
        }
        acc = acc + i;
    }
    println(acc);
}
