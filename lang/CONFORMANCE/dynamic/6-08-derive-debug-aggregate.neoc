// DYNAMIC.md §6.3: derived `debug` renders an aggregate field with the same
// `{:?}` analogue, never as a table address. Covers each field kind — a nested
// struct, `Option<number>` (`Some(1)` / `None`), `[number]` (`[1, 2]` / `[]`)
// and an enum payload (`Boxed(Inner { v = 2 })`).
extern {
    fn println(s: string);
}

#[derive(Debug)]
struct Inner {
    v: number,
}

#[derive(Debug)]
enum Shape {
    Dot,
    Boxed(Inner),
}

#[derive(Debug)]
struct WithInner {
    i: Inner,
}

#[derive(Debug)]
struct WithOption {
    o: Option<number>,
}

#[derive(Debug)]
struct WithList {
    xs: [number],
}

#[derive(Debug)]
struct WithShape {
    s: Shape,
}

#[derive(Debug)]
struct All {
    i: Inner,
    o: Option<number>,
    xs: [number],
    s: Shape,
}

fn main() {
    println(WithInner { i: Inner { v: 1 } }.debug());
    println(WithOption { o: Some(1) }.debug());
    println(WithOption { o: None }.debug());
    println(WithList { xs: [1, 2] }.debug());
    println(WithList { xs: [] }.debug());
    println(WithShape { s: Shape::Boxed(Inner { v: 2 }) }.debug());
    println(WithShape { s: Shape::Dot }.debug());
    println(Shape::Boxed(Inner { v: 2 }).debug());
    let all = All { i: Inner { v: 1 }, o: Some(3), xs: [4], s: Shape::Dot };
    println(all.debug());
}
