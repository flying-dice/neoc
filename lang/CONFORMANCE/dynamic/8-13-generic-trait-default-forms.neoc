// STATIC.md §3.4, §8; DYNAMIC.md §3.4: a generic trait's defaults inherit
// through every impl form — a subtrait default calling a supertrait default, an
// associated-function default, an override beside an inherited default, and a
// blanket impl. Trait arguments are erased.
extern {
    fn println(s: string);
}

trait Show {
    fn show(self) -> string;
}

trait Base<T> {
    fn next(self) -> T;

    fn peek(self) -> T {
        self.next()
    }

    fn make(x: T) -> T {
        x
    }
}

trait Sub<T>: Base<T> {
    fn both(self) -> [T] {
        [self.peek(), self.next()]
    }
}

trait Pick<T> {
    fn get(self) -> T;

    fn pick(self) -> T {
        self.get()
    }
}

struct Namer {
    s: string,
}

struct Loud {
    s: string,
}

struct Quiet;

impl Base<string> for Namer {
    fn next(self) -> string {
        self.s
    }
}

impl Sub<string> for Namer {}

impl Base<string> for Loud {
    fn next(self) -> string {
        self.s
    }

    fn peek(self) -> string {
        "loud"
    }
}

impl Show for Quiet {
    fn show(self) -> string {
        "quiet"
    }
}

impl<S: Show> Pick<string> for S {
    fn get(self) -> string {
        self.show()
    }
}

fn main() {
    let n = Namer { s: "n" };
    println(n.peek());
    println(n.both()[0]);
    println(Namer::make("m"));
    let l = Loud { s: "l" };
    println(l.peek());
    println(l.next());
    println(Loud::make("k"));
    println(Quiet.pick());
}
