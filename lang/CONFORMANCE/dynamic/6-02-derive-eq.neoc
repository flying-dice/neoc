// DYNAMIC.md §6.2 + §4.2: `#[derive(Eq)]` emits `Pair.eq(a, b)` comparing tag
// and every field structurally, and `==`/`!=` on an `Eq` type lower to that
// function rather than Lua reference equality. Two equal-by-value `Pair`s
// compare equal; an unequal one compares unequal.
extern {
    fn println(s: string);
}

#[derive(Eq)]
struct Pair {
    a: number,
    b: number,
}

fn main() {
    let p = Pair { a: 1, b: 2 };
    let q = Pair { a: 1, b: 2 };
    let r = Pair { a: 9, b: 2 };
    if p == q {
        println("eq");
    }
    if p != r {
        println("ne");
    }
}
