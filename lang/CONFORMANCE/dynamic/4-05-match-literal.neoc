// DYNAMIC.md §4.5/§5: literal patterns test `__s == <lit>`; the `_` arm is the
// catch-all. `match` in expression position lowers to an IIFE returning the
// first matching arm's body.
extern {
    fn println(n: number);
}

fn classify(n: number) -> number {
    match n {
        0 => 100,
        1 => 200,
        _ => 999,
    }
}

fn main() {
    println(classify(0));
    println(classify(1));
    println(classify(7));
}
