// DYNAMIC.md §3.2a / §3.4: `trait Greet: Show` makes Show a supertrait of Greet.
// A type implementing Greet must also implement Show, and its `__traits` tag is
// transitively closed to list both (sorted: `Greet`, `Show`). A Greet method may
// call a Show method on `self` — dispatch goes through the same table/prototype,
// no trait object involved.
extern {
    fn println(s: string);
}

trait Show {
    fn show(self) -> string;
}

trait Greet: Show {
    fn greet(self) -> string;
}

struct Badger {
    name: string,
}

impl Show for Badger {
    fn show(self) -> string {
        self.name
    }
}

impl Greet for Badger {
    fn greet(self) -> string {
        "Hi, " + self.show()
    }
}

fn main() {
    let b = Badger { name: "Bram" };
    println(b.greet());
}
