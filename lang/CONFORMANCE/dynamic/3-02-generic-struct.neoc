// DYNAMIC.md §3.1: a generic `struct Box<T>` lowers like any named struct — the
// type parameter is erased and the value is a tagged table. `impl<T> Box<T>`
// attaches `get`, which returns the stored field; at `Box<number>` the checker
// projects `T` to `number` so the result feeds `println`. Reads 99 back out.
extern {
    fn println(n: number);
}

struct Box<T> {
    value: T,
}

impl<T> Box<T> {
    fn get(self) -> T {
        self.value
    }
}

fn main() {
    let b = Box { value: 99 };
    println(b.get());
}
