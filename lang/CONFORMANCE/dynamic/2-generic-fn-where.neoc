// STATIC.md §3.4: a generic function whose trait bounds live in a `where`
// clause rather than inline (`<A: Doubler, B: Doubler>`). The spec resolves a
// parameter's methods against the union of its inline and `where` bounds, so
// the two forms are equivalent — the checker discharges `A`/`B` against
// `impl Doubler for Num` either way. Codegen folds each `where` predicate into
// its parameter's bound before emit, but the emitted signature carries no
// bound at all (`local function combine(a: A, b: B): number`) — the fold is a
// checker-side equivalence with no surface, and `double` is the same dynamic
// `a:double()` lookup either way. 21+21 + 5+5 = 52.
extern {
    fn println(n: number);
}

trait Doubler {
    fn double(self) -> number;
}

struct Num {
    v: number,
}

impl Doubler for Num {
    fn double(self) -> number {
        self.v + self.v
    }
}

fn combine<A, B>(a: A, b: B) -> number where A: Doubler, B: Doubler {
    a.double() + b.double()
}

fn main() {
    println(combine(Num { v: 21 }, Num { v: 5 }));
}
