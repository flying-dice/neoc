// DYNAMIC.md §7 + §4.5: after `.map(...)` the value is still a tagged Option, so
// `match` reads `__tag` and drives control flow unchanged.
extern {
    fn println(n: number);
}

fn main() {
    let s = Some(4);
    match s.map(|x| x * 2) {
        Some(v) => println(v),
        None => println(0),
    }
}
