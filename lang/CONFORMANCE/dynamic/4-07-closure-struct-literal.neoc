// DYNAMIC.md §4.9 + §3.1: a closure whose body is a struct or enum-variant
// object literal returns that value. The two lower differently in that
// position: the struct routes through its constructor
// (`return Point.new({ … })` — metatable attached, field checks run), the enum
// variant returns the tagged table directly
// (`{ __enum = "Shape", __tag = "Square", … }`). Both are built inside the
// closure body. The closures are bound, called, and their fields read.
extern {
    fn println(n: number);
}

struct Point {
    x: number,
    y: number,
}

enum Shape {
    Square {
        side: number,
    },
}

fn main() {
    let mk = |n| Point { x: n, y: n };
    let p = mk(7);
    println(p.x);
    println(p.y);

    let sq = |n| Shape::Square { side: n };
    let s = sq(5);
    match s {
        Shape::Square { side } => println(side),
    }
}
