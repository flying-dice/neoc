// DYNAMIC.md §4.8: a value-producing block `{ s; ...; e }` runs its statements
// then yields the trailing expression `e`; lowered to an IIFE whose value is
// `e`. §4.8 had no executable case.
extern {
    fn println(n: number);
}

fn main() {
    let x = {
        let a = 2;
        let b = 3;
        a * b
    };
    println(x);
}
