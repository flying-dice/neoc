// Module `geo.shape` of 3-07-use-cross-module.
pub enum Kind {
    Small,
    Large,
}

pub struct Circle {
    r: number,
}

impl Circle {
    fn area(self) -> number {
        3 * self.r * self.r
    }

    fn kind(self) -> Kind {
        if self.r > 2 {
            Kind::Large
        } else {
            Kind::Small
        }
    }
}
