// DYNAMIC.md §7 + §4.10: `.map(...)` returns a tagged Result, so `?` reads
// `__tag` and short-circuits/unwraps unchanged.
extern {
    fn println(n: number);
}

fn step(r: Result<number, string>) -> Result<number, string> {
    let v = r.map(|x| x + 10)?;
    Ok(v)
}

fn read(r: Result<number, string>) -> number {
    match r {
        Ok(v) => v,
        Err(_) => 0,
    }
}

fn main() {
    println(read(step(Ok(5))));
    println(read(step(Err("nope"))));
}
