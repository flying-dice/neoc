// STATIC.md §2 / DYNAMIC.md §2: a `fn` declared in a block is hoisted over
// the whole block. It is used before its declaration, recurses, and shadows
// the module-level `label`. Sibling nested fns call each other.
extern {
    fn println(n: number);
}

fn label() -> number {
    1
}

fn main() {
    println(label());
    println(fact(5));
    println(is_even(10));
    fn fact(n: number) -> number {
        if n < 2 {
            1
        } else {
            n * fact(n - 1)
        }
    }
    fn is_even(n: number) -> number {
        if n == 0 {
            1
        } else {
            is_odd(n - 1)
        }
    }
    fn is_odd(n: number) -> number {
        if n == 0 {
            0
        } else {
            is_even(n - 1)
        }
    }
    fn label() -> number {
        2
    }
}
