// DYNAMIC.md §5: a struct pattern with a `..` rest binds the named fields and
// drops the rest — the `..` adds no test and no binding. Here a three-field
// `Point` is matched reading only `x` and `y`; `z` is never bound. The first arm
// also pins a field sub-pattern (`x: 0`), so it matches only when `x` is zero.
extern {
    fn println(n: number);
}

struct Point {
    x: number,
    y: number,
    z: number,
}

fn classify(p: Point) -> number {
    match p {
        Point { x: 0, y, .. } => y,
        Point { x, .. } => x,
    }
}

fn main() {
    println(classify(Point { x: 0, y: 7, z: 99 }));
    println(classify(Point { x: 5, y: 8, z: 99 }));
}
