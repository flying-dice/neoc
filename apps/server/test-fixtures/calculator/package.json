{
  "name": "@agentos/fixture-calculator",
  "version": "0.1.0",
  "private": true,
  "description": "The TypeScript Calculator, kept only as the TS server and SDK build tests fixture until wave B4 removes both",
  "type": "module",
  "exports": {
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "svelte": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "scripts": {},
  "dependencies": {
    "@agentos/sdk": "workspace:*",
    "@agentos/ui": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "zod": "^4.0.0"
  }
}
