{
  "name": "@agentos/server",
  "version": "0.1.0",
  "private": true,
  "description": "The AgentOS Bun server: JSON-RPC over WebSocket, app runtime and registries, tool registry + MCP, ACP agents",
  "type": "module",
  "scripts": {
    "dev": "AGENTOS_DEV=1 AGENTOS_ALLOWED_ORIGINS=http://localhost:5173 bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test ./src"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.108.0",
    "@agentclientprotocol/sdk": "2.7.0",
    "@agentos/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3"
  }
}
