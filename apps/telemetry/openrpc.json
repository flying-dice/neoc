{
  "openrpc": "1.4.0",
  "info": {
    "title": "Telemetry",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_probe",
      "summary": "A call to try tracing with: the backend logs a line and answers, or fails when asked to.",
      "params": [
        {
          "name": "fail",
          "required": false,
          "description": "Fail the call on purpose.",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "probe",
        "schema": {
          "type": "object",
          "properties": {
            "units": {
              "type": "integer",
              "description": "A made-up count the backend logged."
            }
          },
          "required": [
            "units"
          ]
        }
      }
    }
  ]
}
