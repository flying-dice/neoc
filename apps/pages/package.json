{
  "name": "@vos-apps/pages",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Host websites from folders of this machine: give each site a port, a name, or both. They are served by nginx, in a container in Docker which this app makes and keeps.",
  "vos": {
    "title": "Pages",
    "icon": "globe",
    "tint": "green",
    "window": {
      "w": 760,
      "h": 620,
      "minW": 420,
      "minH": 440
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vite build && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test ./src",
    "storybook": "storybook dev -p 6014 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.4",
    "@vos/docker": "workspace:*",
    "@vos/storybook": "workspace:*",
    "@vos/vite-plugin-v2": "workspace:*",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
