{
  "openrpc": "1.4.0",
  "info": {
    "title": "Projects",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_workspace",
      "summary": "Every project, its issues in the order they were added, and its pages by title (a page without its text: `readPage` gives that).",
      "params": [],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      }
    },
    {
      "name": "_add_project",
      "summary": "Add a project, and answer with the workspace as it now stands.",
      "params": [
        {
          "name": "name",
          "required": true,
          "description": "What the project is called. Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 60
          }
        },
        {
          "name": "key",
          "required": true,
          "description": "The short name its issues are numbered under, as in WEB-12: two to five capital letters or digits, a letter first. One that another project has is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 5
          }
        },
        {
          "name": "color",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Color"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "The name is blank, the key is not a key, or another project has the key."
        }
      ]
    },
    {
      "name": "_remove_project",
      "summary": "Delete a project, with its issues and its pages.",
      "params": [
        {
          "name": "project",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such project."
        }
      ]
    },
    {
      "name": "_create_issue",
      "summary": "Add an issue to a project. It starts as a task of medium priority, to do, unless told otherwise.",
      "params": [
        {
          "name": "project",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "title",
          "required": true,
          "description": "What has to be done. Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        {
          "name": "type",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/IssueType"
          }
        },
        {
          "name": "priority",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Priority"
          }
        },
        {
          "name": "status",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Status"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such project, or the title is blank."
        }
      ]
    },
    {
      "name": "_update_issue",
      "summary": "Change an issue: only what is given changes. A new status moves it across the board.",
      "params": [
        {
          "name": "issue",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "title",
          "required": false,
          "description": "Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        {
          "name": "description",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 5000
          }
        },
        {
          "name": "type",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/IssueType"
          }
        },
        {
          "name": "priority",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Priority"
          }
        },
        {
          "name": "status",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/Status"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such issue, or the title is blank."
        }
      ]
    },
    {
      "name": "_remove_issue",
      "summary": "Delete an issue.",
      "params": [
        {
          "name": "issue",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such issue."
        }
      ]
    },
    {
      "name": "_add_page",
      "summary": "Add an empty page to a project, on its own or under another page of the same project.",
      "params": [
        {
          "name": "project",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "title",
          "required": true,
          "description": "What the page is called. Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        {
          "name": "parent",
          "required": false,
          "description": "The id of the page it goes under; left out or 0 for none.",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such project, the title is blank, or the page it goes under is not in the project."
        }
      ]
    },
    {
      "name": "_get_page",
      "summary": "A page with its text.",
      "params": [
        {
          "name": "page",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "text",
        "schema": {
          "$ref": "#/components/schemas/PageText"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such page."
        }
      ]
    },
    {
      "name": "_save_page",
      "summary": "Change a page: only what is given changes.",
      "params": [
        {
          "name": "page",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "title",
          "required": false,
          "description": "Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        {
          "name": "body",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 20000
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such page, or the title is blank."
        }
      ]
    },
    {
      "name": "_remove_page",
      "summary": "Delete a page, and the pages under it.",
      "params": [
        {
          "name": "page",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "workspace",
        "schema": {
          "$ref": "#/components/schemas/Workspace"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such page."
        }
      ]
    },
    {
      "name": "list_issues",
      "summary": "List the issues",
      "x-readOnly": true,
      "description": "The projects, and the issues of one project or of all: each with its key (WEB-12), title, description, type (task, bug, story), priority (low, medium, high) and status (todo, doing, done). Give `status` for one column of the board only.",
      "params": [
        {
          "name": "project",
          "required": false,
          "description": "The key or the name of a project; every project when left out",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "status",
          "required": false,
          "description": "todo, doing or done; every status when left out",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "listed",
        "schema": {
          "type": "object",
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "key",
                  "name"
                ]
              }
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "type": {
                    "$ref": "#/components/schemas/IssueType"
                  },
                  "priority": {
                    "$ref": "#/components/schemas/Priority"
                  },
                  "status": {
                    "$ref": "#/components/schemas/Status"
                  }
                },
                "required": [
                  "key",
                  "title",
                  "description",
                  "type",
                  "priority",
                  "status"
                ]
              }
            }
          },
          "required": [
            "projects",
            "issues"
          ]
        }
      }
    },
    {
      "name": "add_issue",
      "summary": "Add an issue",
      "description": "Raise an issue in a project: a task of medium priority, to do, unless told otherwise. Answers with its key (WEB-12).",
      "params": [
        {
          "name": "project",
          "required": true,
          "description": "The key or the name of the project",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "title",
          "required": true,
          "description": "What has to be done",
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        },
        {
          "name": "description",
          "required": false,
          "description": "What is known about it",
          "schema": {
            "type": "string",
            "maxLength": 5000
          }
        },
        {
          "name": "type",
          "required": false,
          "description": "task, bug or story",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "priority",
          "required": false,
          "description": "low, medium or high",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "added",
        "schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "$ref": "#/components/schemas/Status"
            }
          },
          "required": [
            "key",
            "title",
            "status"
          ]
        }
      }
    },
    {
      "name": "move_issue",
      "summary": "Move an issue",
      "description": "Move an issue to another column of the board, by its key (`list_issues` gives the keys): todo, doing or done.",
      "params": [
        {
          "name": "key",
          "required": true,
          "description": "The key of the issue, as WEB-12",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "status",
          "required": true,
          "description": "todo, doing or done",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "moved",
        "schema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "status": {
              "$ref": "#/components/schemas/Status"
            }
          },
          "required": [
            "key",
            "title",
            "status"
          ]
        }
      }
    },
    {
      "name": "list_pages",
      "summary": "List the pages",
      "x-readOnly": true,
      "description": "The pages of a project: each with its title, the title of the page it is under (empty for none) and when it last changed.",
      "params": [
        {
          "name": "project",
          "required": true,
          "description": "The key or the name of the project",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "listed",
        "schema": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string"
            },
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "under": {
                    "type": "string"
                  },
                  "updated": {
                    "type": "string"
                  }
                },
                "required": [
                  "title",
                  "under",
                  "updated"
                ]
              }
            }
          },
          "required": [
            "project",
            "pages"
          ]
        }
      }
    },
    {
      "name": "read_page",
      "summary": "Read a page",
      "x-readOnly": true,
      "description": "The text of a page of a project, by its title (`list_pages` gives the titles).",
      "params": [
        {
          "name": "project",
          "required": true,
          "description": "The key or the name of the project",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "title",
          "required": true,
          "description": "The title of the page",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "read",
        "schema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "updated": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "body",
            "updated"
          ]
        }
      }
    },
    {
      "name": "write_page",
      "summary": "Write a page",
      "description": "Write a page of a project: the page with that title is given the text in place of what it had, and a title no page has makes a new page, under the page named in `under` when one is.",
      "params": [
        {
          "name": "project",
          "required": true,
          "description": "The key or the name of the project",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "title",
          "required": true,
          "description": "The title of the page",
          "schema": {
            "type": "string",
            "maxLength": 120
          }
        },
        {
          "name": "body",
          "required": true,
          "description": "The whole text of the page",
          "schema": {
            "type": "string",
            "maxLength": 20000
          }
        },
        {
          "name": "under",
          "required": false,
          "description": "For a new page: the title of the page it goes under",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "written",
        "schema": {
          "type": "object",
          "properties": {
            "project": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "created": {
              "type": "boolean"
            }
          },
          "required": [
            "project",
            "title",
            "created"
          ]
        }
      }
    },
    {
      "name": "projects_changed",
      "summary": "Projects, issues or pages were written by an agent: the open windows read the workspace again.",
      "params": []
    }
  ],
  "components": {
    "schemas": {
      "Color": {
        "type": "string",
        "description": "A project's colour, a role of the palette.",
        "enum": [
          "blue",
          "indigo",
          "purple",
          "pink",
          "red",
          "orange",
          "green",
          "teal"
        ]
      },
      "IssueType": {
        "type": "string",
        "description": "What kind of work an issue is.",
        "enum": [
          "task",
          "bug",
          "story"
        ]
      },
      "Priority": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "Status": {
        "type": "string",
        "description": "The column of the board an issue is in.",
        "enum": [
          "todo",
          "doing",
          "done"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "key": {
            "type": "string",
            "description": "The short name its issues are numbered under: WEB."
          },
          "name": {
            "type": "string"
          },
          "color": {
            "$ref": "#/components/schemas/Color"
          }
        },
        "required": [
          "id",
          "key",
          "name",
          "color"
        ]
      },
      "Issue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "project": {
            "type": "integer",
            "description": "The id of the project it is in."
          },
          "key": {
            "type": "string",
            "description": "What it is called by: the key of its project and its number there, as WEB-12."
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Empty when there is none."
          },
          "type": {
            "$ref": "#/components/schemas/IssueType"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "updated": {
            "type": "string",
            "description": "When it last changed, as 2026-06-09T08:41:00.000Z."
          }
        },
        "required": [
          "id",
          "project",
          "key",
          "title",
          "description",
          "type",
          "priority",
          "status",
          "updated"
        ]
      },
      "Page": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "project": {
            "type": "integer",
            "description": "The id of the project it is in."
          },
          "parent": {
            "type": "integer",
            "description": "The id of the page it is under; 0 for none."
          },
          "title": {
            "type": "string"
          },
          "updated": {
            "type": "string",
            "description": "When it last changed, as 2026-06-09T08:41:00.000Z."
          }
        },
        "required": [
          "id",
          "project",
          "parent",
          "title",
          "updated"
        ]
      },
      "PageText": {
        "type": "object",
        "properties": {
          "page": {
            "$ref": "#/components/schemas/Page"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "page",
          "body"
        ]
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            }
          }
        },
        "required": [
          "projects",
          "issues",
          "pages"
        ]
      }
    }
  }
}
