{
  "openrpc": "1.4.0",
  "info": {
    "title": "Todos",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_board",
      "summary": "Every list and its todos: the open ones in the order they were added, then the completed ones, the most recently completed first.",
      "params": [],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      }
    },
    {
      "name": "_add_list",
      "summary": "Add a list, and answer with the board as it now stands.",
      "params": [
        {
          "name": "name",
          "required": true,
          "description": "What the list is called. Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 60
          }
        },
        {
          "name": "color",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/Color"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "The name is blank."
        }
      ]
    },
    {
      "name": "_remove_list",
      "summary": "Delete a list and the todos in it.",
      "params": [
        {
          "name": "list",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such list, or it is the last one."
        }
      ]
    },
    {
      "name": "_add",
      "summary": "Add a todo to a list.",
      "params": [
        {
          "name": "list",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "title",
          "required": true,
          "description": "What has to be done. Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 500
          }
        },
        {
          "name": "due",
          "required": false,
          "description": "The day it is due, as 2026-06-09; left out or empty for none.",
          "schema": {
            "type": "string",
            "maxLength": 10
          }
        },
        {
          "name": "flagged",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such list, the title is blank, or the day is not a day."
        }
      ]
    },
    {
      "name": "_update",
      "summary": "Change a todo: only what is given changes.",
      "params": [
        {
          "name": "todo",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "title",
          "required": false,
          "description": "Blank is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 500
          }
        },
        {
          "name": "notes",
          "required": false,
          "schema": {
            "type": "string",
            "maxLength": 2000
          }
        },
        {
          "name": "due",
          "required": false,
          "description": "The day it is due, as 2026-06-09; empty takes the day away.",
          "schema": {
            "type": "string",
            "maxLength": 10
          }
        },
        {
          "name": "flagged",
          "required": false,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such todo, the title is blank, or the day is not a day."
        }
      ]
    },
    {
      "name": "_toggle",
      "summary": "Complete a todo, or bring a completed one back.",
      "params": [
        {
          "name": "todo",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such todo."
        }
      ]
    },
    {
      "name": "_remove",
      "summary": "Delete a todo.",
      "params": [
        {
          "name": "todo",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such todo."
        }
      ]
    },
    {
      "name": "list_todos",
      "summary": "List the todos",
      "x-readOnly": true,
      "description": "The todos that are still to do, with the list each is in, its notes, the day it is due (2026-06-09, empty for none) and whether it is flagged. Give `list` for one list only, and `completed` for the completed todos instead.",
      "params": [
        {
          "name": "list",
          "required": false,
          "description": "The name of a list; every list when left out",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "completed",
          "required": false,
          "description": "True for the completed todos instead of the open ones",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "listed",
        "schema": {
          "type": "object",
          "properties": {
            "todos": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Listed"
              }
            }
          },
          "required": [
            "todos"
          ]
        }
      }
    },
    {
      "name": "add_todo",
      "summary": "Add a todo",
      "description": "Add a todo to a list (the first list when none is named), with optional notes, a day it is due and a flag.",
      "params": [
        {
          "name": "title",
          "required": true,
          "description": "What has to be done",
          "schema": {
            "type": "string",
            "maxLength": 500
          }
        },
        {
          "name": "list",
          "required": false,
          "description": "The name of the list to add it to; the first list when left out",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "notes",
          "required": false,
          "description": "Anything worth remembering about it",
          "schema": {
            "type": "string",
            "maxLength": 2000
          }
        },
        {
          "name": "due",
          "required": false,
          "description": "The day it is due, as 2026-06-09",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "flagged",
          "required": false,
          "description": "True to flag it",
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "added",
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "list": {
              "type": "string",
              "description": "The name of the list it went to."
            }
          },
          "required": [
            "id",
            "list"
          ]
        }
      }
    },
    {
      "name": "complete_todo",
      "summary": "Complete a todo",
      "description": "Tick a todo off, by its id (`list_todos` gives the ids).",
      "params": [
        {
          "name": "id",
          "required": true,
          "description": "The id of the todo",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "completed",
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "done": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "title",
            "done"
          ]
        }
      }
    },
    {
      "name": "todos_changed",
      "summary": "The todos changed",
      "description": "Sent when a tool of an agent changed the todos: the open windows read the board again.",
      "params": []
    }
  ],
  "components": {
    "schemas": {
      "Color": {
        "type": "string",
        "description": "A list's colour, a role of the palette.",
        "enum": [
          "red",
          "orange",
          "yellow",
          "green",
          "blue",
          "purple",
          "brown"
        ]
      },
      "List": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "color": {
            "$ref": "#/components/schemas/Color"
          }
        },
        "required": [
          "id",
          "name",
          "color"
        ]
      },
      "Todo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "list": {
            "type": "integer",
            "description": "The id of the list it is in."
          },
          "title": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Empty when there are none."
          },
          "due": {
            "type": "string",
            "description": "The day it is due, as 2026-06-09; empty when it has none."
          },
          "flagged": {
            "type": "boolean"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "list",
          "title",
          "notes",
          "due",
          "flagged",
          "done"
        ]
      },
      "Board": {
        "type": "object",
        "properties": {
          "lists": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/List"
            }
          },
          "todos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Todo"
            }
          }
        },
        "required": [
          "lists",
          "todos"
        ]
      },
      "Listed": {
        "type": "object",
        "description": "A todo as an agent reads it: its list by name.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "list": {
            "type": "string",
            "description": "The name of the list it is in."
          },
          "notes": {
            "type": "string",
            "description": "Empty when there are none."
          },
          "due": {
            "type": "string",
            "description": "The day it is due, as 2026-06-09; empty when it has none."
          },
          "flagged": {
            "type": "boolean"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "list",
          "notes",
          "due",
          "flagged",
          "done"
        ]
      }
    }
  }
}
