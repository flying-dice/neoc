{
  "name": "@vos-apps/copilot",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Chat with ACP agents that run in Docker: define a copilot by its Dockerfile, command, environment, MCP servers and skills, and each chat gets a container of its own.",
  "vos": {
    "title": "Copilot",
    "icon": "message",
    "tint": "blue",
    "window": {
      "w": 960,
      "h": 640,
      "minW": 480,
      "minH": 420
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vite build && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.4",
    "@vos/vite-plugin": "workspace:*",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
