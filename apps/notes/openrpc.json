{
  "openrpc": "1.4.0",
  "info": {
    "title": "Notes",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_board",
      "summary": "Every folder and every note, the most recently edited first. A note is listed by its title and a line of what follows; `read` gives the whole of one. Notes deleted more than 30 days ago are gone.",
      "params": [],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      }
    },
    {
      "name": "_add_folder",
      "summary": "Add a folder, and answer with the board as it now stands.",
      "params": [
        {
          "name": "name",
          "required": true,
          "description": "What the folder is called. Blank, or the name of a folder there already is, is refused with a message.",
          "schema": {
            "type": "string",
            "maxLength": 60
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "The name is blank, or a folder has it already."
        }
      ]
    },
    {
      "name": "_remove_folder",
      "summary": "Delete a folder. Its notes go to Recently Deleted.",
      "params": [
        {
          "name": "folder",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such folder, or it is the first one, which stays."
        }
      ]
    },
    {
      "name": "_create",
      "summary": "Start a blank note in a folder.",
      "params": [
        {
          "name": "folder",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such folder."
        }
      ]
    },
    {
      "name": "_read",
      "summary": "The whole text of one note.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "text",
        "schema": {
          "$ref": "#/components/schemas/Text"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note."
        }
      ]
    },
    {
      "name": "_write",
      "summary": "Replace the text of a note. Its first line is its title.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "body",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 20000
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note, or it is deleted."
        }
      ]
    },
    {
      "name": "_pin",
      "summary": "Pin a note to the top of its list, or unpin it.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "pinned",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note, or it is deleted."
        }
      ]
    },
    {
      "name": "_move",
      "summary": "Move a note to another folder.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "folder",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note or folder, or the note is deleted."
        }
      ]
    },
    {
      "name": "_remove",
      "summary": "Delete a note: it goes to Recently Deleted, where it stays for 30 days. A note with nothing in it is gone at once.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note."
        }
      ]
    },
    {
      "name": "_restore",
      "summary": "Bring a deleted note back to its folder.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note."
        }
      ]
    },
    {
      "name": "_purge",
      "summary": "Delete a deleted note for good.",
      "params": [
        {
          "name": "note",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "board",
        "schema": {
          "$ref": "#/components/schemas/Board"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "There is no such note, or it is not deleted."
        }
      ]
    },
    {
      "name": "_search",
      "summary": "The notes whose text holds what is asked for, whatever its capitals. Deleted notes are not searched.",
      "params": [
        {
          "name": "query",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 100
          }
        }
      ],
      "result": {
        "name": "found",
        "schema": {
          "$ref": "#/components/schemas/Found"
        }
      }
    },
    {
      "name": "list_notes",
      "summary": "List the notes",
      "x-readOnly": true,
      "description": "The notes, the most recently edited first: each with its id, its title (its first line), the line after it, the folder it is in, whether it is pinned and when it was last edited. Give `folder` for one folder only, and `search` for the notes whose text holds some words. Deleted notes are left out. `read_note` gives the whole text of one.",
      "params": [
        {
          "name": "folder",
          "required": false,
          "description": "The name of a folder; every folder when left out",
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "search",
          "required": false,
          "description": "Words the note's text must hold",
          "schema": {
            "type": "string",
            "maxLength": 100
          }
        }
      ],
      "result": {
        "name": "listed",
        "schema": {
          "type": "object",
          "properties": {
            "notes": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Listed"
              }
            }
          },
          "required": [
            "notes"
          ]
        }
      }
    },
    {
      "name": "read_note",
      "summary": "Read a note",
      "x-readOnly": true,
      "description": "The whole text of a note, by its id (`list_notes` gives the ids).",
      "params": [
        {
          "name": "id",
          "required": true,
          "description": "The id of the note",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "result": {
        "name": "read",
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            },
            "pinned": {
              "type": "boolean"
            },
            "edited": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "body",
            "pinned",
            "edited"
          ]
        }
      }
    },
    {
      "name": "create_note",
      "summary": "Write a note",
      "description": "Write a new note in a folder (the first folder when none is named). Its first line is its title.",
      "params": [
        {
          "name": "body",
          "required": true,
          "description": "The text of the note; its first line is its title",
          "schema": {
            "type": "string",
            "maxLength": 20000
          }
        },
        {
          "name": "folder",
          "required": false,
          "description": "The name of the folder to put it in; the first folder when left out",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "created",
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "folder": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "folder"
          ]
        }
      }
    },
    {
      "name": "append_to_note",
      "summary": "Add to a note",
      "description": "Add text to the end of a note, on a line of its own, by the note's id (`list_notes` gives the ids).",
      "params": [
        {
          "name": "id",
          "required": true,
          "description": "The id of the note",
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "text",
          "required": true,
          "description": "What to add",
          "schema": {
            "type": "string",
            "maxLength": 20000
          }
        }
      ],
      "result": {
        "name": "appended",
        "schema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "title": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title"
          ]
        }
      }
    },
    {
      "name": "notes_changed",
      "summary": "Notes were written by an agent: the open windows read the board again.",
      "params": []
    }
  ],
  "components": {
    "schemas": {
      "Folder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "folder": {
            "type": "integer",
            "description": "The id of the folder it is in."
          },
          "title": {
            "type": "string",
            "description": "Its first line; empty for a note with nothing in it."
          },
          "preview": {
            "type": "string",
            "description": "The line after the title; empty when there is none."
          },
          "pinned": {
            "type": "boolean"
          },
          "edited": {
            "type": "string",
            "description": "When its text last changed, as 2026-06-09T08:41:00.000Z."
          },
          "deleted": {
            "type": "boolean",
            "description": "It is in Recently Deleted."
          }
        },
        "required": [
          "id",
          "folder",
          "title",
          "preview",
          "pinned",
          "edited",
          "deleted"
        ]
      },
      "Board": {
        "type": "object",
        "properties": {
          "folders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Folder"
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Note"
            }
          }
        },
        "required": [
          "folders",
          "notes"
        ]
      },
      "Text": {
        "type": "object",
        "properties": {
          "note": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "note",
          "body"
        ]
      },
      "Found": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "description": "The ids of the notes found."
          }
        },
        "required": [
          "notes"
        ]
      },
      "Listed": {
        "type": "object",
        "description": "A note as an agent reads it in a list: its folder by name.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          },
          "folder": {
            "type": "string"
          },
          "pinned": {
            "type": "boolean"
          },
          "edited": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "preview",
          "folder",
          "pinned",
          "edited"
        ]
      }
    }
  }
}
