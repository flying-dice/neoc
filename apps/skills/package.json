{
  "name": "@vos-apps/skills",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "The skills agents are given: each a SKILL.md and the files beside it, kept here for the apps that run agents to read.",
  "vos": {
    "title": "Skills",
    "icon": "bolt",
    "tint": "purple",
    "window": {
      "w": 560,
      "h": 620,
      "minW": 360,
      "minH": 420
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vite build && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test ./src",
    "storybook": "storybook dev -p 6029 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.4",
    "@vos/storybook": "workspace:*",
    "@vos/vite-plugin": "workspace:*",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
