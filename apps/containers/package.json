{
  "name": "@vos-apps/containers",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "The Docker containers and Compose stacks of this machine: see what runs, make, change and remove containers, start, stop and restart them, read their logs.",
  "vos": {
    "title": "Containers",
    "icon": "rectangle.stack",
    "tint": "teal",
    "window": {
      "w": 980,
      "h": 640,
      "minW": 440,
      "minH": 420
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vite build && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test ./src",
    "storybook": "storybook dev -p 6012 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.4",
    "@vos/docker": "workspace:*",
    "@vos/storybook": "workspace:*",
    "@vos/vite-plugin": "workspace:*",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
