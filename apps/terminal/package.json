{
  "name": "@vos-apps/terminal",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A shell on the machine vos runs on: your own shell, in your home folder.",
  "vos": {
    "title": "Terminal",
    "icon": "terminal",
    "tint": "gray",
    "window": {
      "w": 640,
      "h": 420,
      "minW": 320,
      "minH": 240
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vite build && svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test ./src",
    "storybook": "storybook dev -p 6020 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "1.4.4",
    "@vos/storybook": "workspace:*",
    "@vos/vite-plugin-v2": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
