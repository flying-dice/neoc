{
  "grammars": [
    {
      "name": "neoc",
      "camelcase": "Neoc",
      "scope": "source.neoc",
      "path": ".",
      "file-types": ["neoc"],
      "injection-regex": "^neoc$"
    }
  ],
  "metadata": {
    "version": "0.0.1",
    "license": "MIT OR Apache-2.0",
    "description": "tree-sitter grammar for the neoc language",
    "authors": [{ "name": "flying-dice" }],
    "links": {
      "repository": "https://github.com/flying-dice/neoc"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
