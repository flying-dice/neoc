local _t       = require("lib:test")
local describe = _t.describe
local test     = _t.test
local expect   = _t.expect

local json       = require("lib:json")
local serde_json = require("vnd:serde_json")

-- `lib:json` is structural: Object / Array userdata over a pure-std tree.
-- Access is always through `:get` / `:set` / `:len` — no `.field` or `[i]`
-- sugar, since the JSON shape is dynamic and Luau strict mode can't
-- type-check it anyway.
--
-- Parsing lives in `vnd:serde_json` (the JSON codec); these tests cover
-- the userdata surface.
--
-- Handles are live references: `:get` returns a handle backed by
-- root + path, so mutations through the root are visible through child
-- handles (JS-like reference semantics within a single engine).

describe("json", function()

    -- parse-then-handle -------------------------------------------------------
    describe("from serde_json.from_str", function()
        test("returns Object userdata for {} payloads", function()
            local v = serde_json.from_str('{"name":"Alice","age":30}')
            expect(v:get("name")).toBe("Alice")
            expect(v:get("age")).toBe(30)
        end)

        test("returns Array userdata for [] payloads", function()
            local v = serde_json.from_str('[10, 20, 30]')
            expect(v:get(1)).toBe(10)
            expect(v:get(3)).toBe(30)
            expect(v:len()).toBe(3)
        end)

        test("scalars come back as Lua native; null is the json.null sentinel", function()
            expect(serde_json.from_str('"hi"')).toBe("hi")
            expect(serde_json.from_str('42')).toBe(42)
            expect(serde_json.from_str('true')).toBe(true)
            -- JSON null is distinct from "key absent" — it comes back as
            -- the json.null sentinel userdata, comparable via ==.
            expect(serde_json.from_str('null')).toBe(json.null)
        end)

        test("missing key vs explicit null are distinguishable", function()
            local v = serde_json.from_str('{"explicit":null}')
            -- explicit null: present, equal to json.null
            expect(v:has("explicit")).toBe(true)
            expect(v:get("explicit")).toBe(json.null)
            -- missing: not present, get returns Lua nil
            expect(v:has("missing")).toBe(false)
            expect(v:get("missing")).toBeNil()
        end)

        test("nested object navigation walks the tree", function()
            local v = serde_json.from_str('{"user":{"name":"Bob","tags":["x","y"]}}')
            expect(v:get("user"):get("name")).toBe("Bob")
            expect(v:get("user"):get("tags"):get(2)).toBe("y")
        end)
    end)

    -- Object methods ----------------------------------------------------------
    describe("Object", function()
        test(":get / :has / :keys / :len", function()
            local o = serde_json.from_str('{"a":1,"b":2}')
            expect(o:get("a")).toBe(1)
            expect(o:has("a")).toBe(true)
            expect(o:has("missing")).toBe(false)
            local ks = o:keys()
            table.sort(ks)
            expect(ks[1]).toBe("a")
            expect(ks[2]).toBe("b")
            expect(o:len()).toBe(2)
        end)

        test(":set with native values mutates the underlying root", function()
            local o = serde_json.from_str('{"a":1}')
            o:set("b", "hello")
            expect(o:get("b")).toBe("hello")
        end)

        test("encoding goes through serde_json.to_string (deterministic)", function()
            local o = serde_json.from_str('{"a":1}')
            o:set("b", 2)
            -- BTreeMap-backed Object → alphabetical key order on emit.
            expect(serde_json.to_string(o)).toBe('{"a":1,"b":2}')
        end)

        test(":to_table materialises a Lua table", function()
            local o = serde_json.from_str('{"a":1,"b":"two"}')
            local t = o:to_table()
            expect(t.a).toBe(1)
            expect(t.b).toBe("two")
        end)

        test("nested handle observes parent mutation (live reference)", function()
            local o = serde_json.from_str('{"nested":{"x":1}}')
            local n = o:get("nested")
            o:set("nested", { x = 99, y = 100 })
            -- n resolves through root — sees the new subtree
            expect(n:get("x")).toBe(99)
            expect(n:get("y")).toBe(100)
        end)
    end)

    -- Array methods -----------------------------------------------------------
    describe("Array", function()
        test(":get / :len", function()
            local a = serde_json.from_str('[10, 20, 30]')
            expect(a:get(1)).toBe(10)
            expect(a:get(3)).toBe(30)
            expect(a:get(99)).toBeNil()
            expect(a:len()).toBe(3)
        end)

        test(":push appends to the underlying array", function()
            local a = json.array()
            a:push(1)
            a:push("two")
            expect(a:len()).toBe(2)
            expect(a:get(1)).toBe(1)
            expect(a:get(2)).toBe("two")
        end)

        test(":set mutates an existing index", function()
            local a = serde_json.from_str('[1, 2, 3]')
            a:set(2, 99)
            expect(a:get(2)).toBe(99)
        end)
    end)

    -- live handle semantics ---------------------------------------------------
    -- Handles are live references backed by root + path. `:get` returns a
    -- child handle that resolves through the shared root on every access.
    -- Mutations through any handle are visible through all handles sharing
    -- the same root — JS-like reference semantics within a single engine.
    describe("Live handles", function()

        -- scalar variants via Object :get -----------------------------------------
        describe("scalar variants from Object :get", function()
            test("Bool true/false", function()
                local o = serde_json.from_str('{"t":true,"f":false}')
                expect(o:get("t")).toBe(true)
                expect(o:get("f")).toBe(false)
            end)

            test("Int (small)", function()
                local o = serde_json.from_str('{"n":42}')
                expect(o:get("n")).toBe(42)
            end)

            test("Int (negative)", function()
                local o = serde_json.from_str('{"n":-7}')
                expect(o:get("n")).toBe(-7)
            end)

            test("Int zero", function()
                local o = serde_json.from_str('{"n":0}')
                expect(o:get("n")).toBe(0)
            end)

            test("Float", function()
                local o = serde_json.from_str('{"n":3.14}')
                local v = o:get("n")
                -- float comparison within tolerance
                expect(v > 3.13 and v < 3.15).toBe(true)
            end)

            test("Float negative", function()
                local o = serde_json.from_str('{"n":-0.5}')
                expect(o:get("n")).toBe(-0.5)
            end)

            test("String", function()
                local o = serde_json.from_str('{"s":"hello"}')
                expect(o:get("s")).toBe("hello")
            end)

            test("empty String", function()
                local o = serde_json.from_str('{"s":""}')
                expect(o:get("s")).toBe("")
            end)

            test("Null returns json.null sentinel", function()
                local o = serde_json.from_str('{"v":null}')
                expect(o:get("v")).toBe(json.null)
            end)

            test("missing key returns Lua nil", function()
                local o = serde_json.from_str('{"a":1}')
                expect(o:get("nope")).toBeNil()
            end)
        end)

        -- scalar variants via Array :get ------------------------------------------
        describe("scalar variants from Array :get", function()
            test("all scalar types in one array", function()
                local a = serde_json.from_str('[true, false, 42, -1, 3.14, "hi", null]')
                expect(a:get(1)).toBe(true)
                expect(a:get(2)).toBe(false)
                expect(a:get(3)).toBe(42)
                expect(a:get(4)).toBe(-1)
                -- float
                local f = a:get(5)
                expect(f > 3.13 and f < 3.15).toBe(true)
                expect(a:get(6)).toBe("hi")
                expect(a:get(7)).toBe(json.null)
            end)

            test("out-of-bounds returns nil; index 0 throws (1-based)", function()
                local a = serde_json.from_str('[1]')
                expect(a:get(2)).toBeNil()
                expect(a:get(99)).toBeNil()
                expect(function()
                    a:get(0)
                end).toThrow()
            end)
        end)

        -- nested Object handle ----------------------------------------------------
        describe("nested Object handle", function()
            test(":get returns correct values", function()
                local root = serde_json.from_str('{"child":{"a":1,"b":"two"}}')
                local child = root:get("child")
                expect(child:get("a")).toBe(1)
                expect(child:get("b")).toBe("two")
            end)

            test(":has works on child handle", function()
                local root = serde_json.from_str('{"child":{"a":1}}')
                local child = root:get("child")
                expect(child:has("a")).toBe(true)
                expect(child:has("missing")).toBe(false)
            end)

            test(":keys works on child handle", function()
                local root = serde_json.from_str('{"child":{"x":1,"y":2,"z":3}}')
                local child = root:get("child")
                local ks = child:keys()
                table.sort(ks)
                expect(#ks).toBe(3)
                expect(ks[1]).toBe("x")
                expect(ks[2]).toBe("y")
                expect(ks[3]).toBe("z")
            end)

            test(":len works on child handle", function()
                local root = serde_json.from_str('{"child":{"a":1,"b":2}}')
                local child = root:get("child")
                expect(child:len()).toBe(2)
            end)

            test(":to_table materialises child handle to Lua table", function()
                local root = serde_json.from_str('{"child":{"a":1,"b":"two"}}')
                local child = root:get("child")
                local t = child:to_table()
                expect(t.a).toBe(1)
                expect(t.b).toBe("two")
            end)

            test(":set on child handle mutates through root", function()
                local root = serde_json.from_str('{"child":{"a":1}}')
                local child = root:get("child")
                child:set("a", 99)
                -- visible through root
                expect(root:get("child"):get("a")).toBe(99)
                -- visible through child
                expect(child:get("a")).toBe(99)
            end)

            test("empty object child handle", function()
                local root = serde_json.from_str('{"child":{}}')
                local child = root:get("child")
                expect(child:len()).toBe(0)
                expect(child:has("anything")).toBe(false)
                local ks = child:keys()
                expect(#ks).toBe(0)
            end)
        end)

        -- nested Array handle -----------------------------------------------------
        describe("nested Array handle", function()
            test(":get returns correct values", function()
                local root = serde_json.from_str('{"items":[10,20,30]}')
                local items = root:get("items")
                expect(items:get(1)).toBe(10)
                expect(items:get(2)).toBe(20)
                expect(items:get(3)).toBe(30)
            end)

            test(":len works on child handle", function()
                local root = serde_json.from_str('{"items":[1,2,3,4]}')
                local items = root:get("items")
                expect(items:len()).toBe(4)
            end)

            test(":to_table materialises child handle to Lua table", function()
                local root = serde_json.from_str('{"items":["a","b"]}')
                local items = root:get("items")
                local t = items:to_table()
                expect(t[1]).toBe("a")
                expect(t[2]).toBe("b")
            end)

            test(":set on child handle mutates through root", function()
                local root = serde_json.from_str('{"items":[1,2]}')
                local items = root:get("items")
                items:set(1, 99)
                expect(root:get("items"):get(1)).toBe(99)
                expect(items:get(1)).toBe(99)
            end)

            test(":push on child handle mutates through root", function()
                local root = serde_json.from_str('{"items":[1]}')
                local items = root:get("items")
                items:push(2)
                expect(root:get("items"):len()).toBe(2)
                expect(items:get(2)).toBe(2)
            end)

            test("empty array child handle", function()
                local root = serde_json.from_str('{"items":[]}')
                local items = root:get("items")
                expect(items:len()).toBe(0)
                expect(items:get(1)).toBeNil()
            end)

            test("array child from array parent", function()
                local root = serde_json.from_str('[[1,2],[3,4]]')
                local inner = root:get(1)
                expect(inner:len()).toBe(2)
                expect(inner:get(1)).toBe(1)
                expect(inner:get(2)).toBe(2)
            end)
        end)

        -- mutation visibility through live handles --------------------------------
        describe("mutation visibility", function()
            test("child handle observes parent mutation", function()
                local root = serde_json.from_str('{"data":{"x":1,"y":2}}')
                local child = root:get("data")
                root:set("data", { x = 99 })
                -- child resolves through root — sees new subtree
                expect(child:get("x")).toBe(99)
                expect(child:has("y")).toBe(false)
                expect(child:len()).toBe(1)
            end)

            test("array child observes parent mutation", function()
                local root = serde_json.from_str('{"items":[1,2,3]}')
                local items = root:get("items")
                root:set("items", { 99 })
                expect(items:len()).toBe(1)
                expect(items:get(1)).toBe(99)
            end)

            test("scalars are captured by value (primitives)", function()
                local root = serde_json.from_str('{"n":42}')
                local n = root:get("n")
                root:set("n", 100)
                -- n was a Lua number, not a handle — captured by value
                expect(n).toBe(42)
            end)

            test("child mutation visible through root", function()
                local root = serde_json.from_str('{"a":{"v":1},"b":{"v":2}}')
                local a = root:get("a")
                local b = root:get("b")
                a:set("v", 99)
                b:set("v", 88)
                expect(root:get("a"):get("v")).toBe(99)
                expect(root:get("b"):get("v")).toBe(88)
            end)

            test("sibling handles see each other's mutations", function()
                local root = serde_json.from_str('{"data":{"v":1}}')
                local h1 = root:get("data")
                local h2 = root:get("data")
                h1:set("v", 42)
                expect(h2:get("v")).toBe(42)
            end)
        end)

        -- deeply nested handles ---------------------------------------------------
        describe("deeply nested", function()
            test("multi-level object nesting", function()
                local root = serde_json.from_str('{"a":{"b":{"c":{"d":"deep"}}}}')
                local a = root:get("a")
                local b = a:get("b")
                local c = b:get("c")
                expect(c:get("d")).toBe("deep")
            end)

            test("mixed object/array nesting", function()
                local root = serde_json.from_str('{"users":[{"name":"Alice","scores":[100,95]},{"name":"Bob","scores":[80]}]}')
                local users = root:get("users")
                local alice = users:get(1)
                expect(alice:get("name")).toBe("Alice")
                local scores = alice:get("scores")
                expect(scores:len()).toBe(2)
                expect(scores:get(1)).toBe(100)
                expect(scores:get(2)).toBe(95)
                local bob = users:get(2)
                expect(bob:get("name")).toBe("Bob")
                expect(bob:get("scores"):len()).toBe(1)
            end)

            test("deep mutation visible through root", function()
                local root = serde_json.from_str('{"a":{"b":{"c":42}}}')
                local deep = root:get("a"):get("b")
                deep:set("c", 999)
                expect(root:get("a"):get("b"):get("c")).toBe(999)
            end)

            test("handle of object containing all variant types", function()
                local src = '{"obj":{"bool":true,"int":7,"float":1.5,"str":"yes","null_val":null,"arr":[1,2],"nested":{"k":"v"}}}'
                local root = serde_json.from_str(src)
                local obj = root:get("obj")
                expect(obj:get("bool")).toBe(true)
                expect(obj:get("int")).toBe(7)
                expect(obj:get("float")).toBe(1.5)
                expect(obj:get("str")).toBe("yes")
                expect(obj:get("null_val")).toBe(json.null)
                expect(obj:get("arr"):len()).toBe(2)
                expect(obj:get("arr"):get(1)).toBe(1)
                expect(obj:get("nested"):get("k")).toBe("v")
            end)

            test("handle of array containing all variant types", function()
                local root = serde_json.from_str('{"arr":[true, 7, 1.5, "yes", null, [1,2], {"k":"v"}]}')
                local arr = root:get("arr")
                expect(arr:get(1)).toBe(true)
                expect(arr:get(2)).toBe(7)
                expect(arr:get(3)).toBe(1.5)
                expect(arr:get(4)).toBe("yes")
                expect(arr:get(5)).toBe(json.null)
                expect(arr:get(6):len()).toBe(2)
                expect(arr:get(7):get("k")).toBe("v")
            end)
        end)

        -- to_table on child handles -----------------------------------------------
        describe(":to_table on child handles", function()
            test("object child to_table preserves all scalar types", function()
                local root = serde_json.from_str('{"child":{"b":true,"i":5,"f":2.5,"s":"x"}}')
                local t = root:get("child"):to_table()
                expect(t.b).toBe(true)
                expect(t.i).toBe(5)
                expect(t.f).toBe(2.5)
                expect(t.s).toBe("x")
            end)

            test("array child to_table preserves order and values", function()
                local root = serde_json.from_str('{"arr":["a","b","c"]}')
                local t = root:get("arr"):to_table()
                expect(#t).toBe(3)
                expect(t[1]).toBe("a")
                expect(t[2]).toBe("b")
                expect(t[3]).toBe("c")
            end)

            test("nested child to_table recursively materialises", function()
                local root = serde_json.from_str('{"child":{"inner":{"v":42}}}')
                local t = root:get("child"):to_table()
                expect(t.inner.v).toBe(42)
            end)
        end)
    end)

    -- empty constructors ------------------------------------------------------
    describe("constructors", function()
        test("json.object() returns an empty mutable Object", function()
            local o = json.object()
            expect(o:len()).toBe(0)
            o:set("k", "v")
            expect(o:get("k")).toBe("v")
        end)

        test("json.array() returns an empty mutable Array", function()
            local a = json.array()
            expect(a:len()).toBe(0)
            a:push(true)
            expect(a:get(1)).toBe(true)
        end)
    end)

    -- variadic :get (multi-segment path) --------------------------------------
    -- The variadic form acquires a single lock and walks the whole path
    -- atomically, instead of one lock per chained :get call.
    describe("variadic :get", function()
        test("two-segment object path", function()
            local root = serde_json.from_str('{"a":{"b":"deep"}}')
            expect(root:get("a", "b")).toBe("deep")
        end)

        test("mixed object/array path", function()
            local root = serde_json.from_str('{"users":[{"name":"Alice"},{"name":"Bob"}]}')
            expect(root:get("users", 1, "name")).toBe("Alice")
            expect(root:get("users", 2, "name")).toBe("Bob")
        end)

        test("three-segment all-object path", function()
            local root = serde_json.from_str('{"a":{"b":{"c":42}}}')
            expect(root:get("a", "b", "c")).toBe(42)
        end)

        test("returns nil for missing intermediate key", function()
            local root = serde_json.from_str('{"a":{"b":1}}')
            expect(root:get("a", "missing", "c")).toBeNil()
        end)

        test("returns nil for out-of-bounds array index in path", function()
            local root = serde_json.from_str('{"arr":[1,2]}')
            expect(root:get("arr", 99)).toBeNil()
        end)

        test("returns Object/Array handle for intermediate container", function()
            local root = serde_json.from_str('{"a":{"b":{"c":1}}}')
            local b = root:get("a", "b")
            expect(b:get("c")).toBe(1)
            expect(b:len()).toBe(1)
        end)

        test("no arguments throws", function()
            local root = serde_json.from_str('{"a":1}')
            expect(function()
                root:get()
            end).toThrow()
        end)
    end)

    -- set→get round-trip for every JsonValue variant --------------------------
    -- Verifies that :set accepts each variant type and :get returns the
    -- correct Lua value. Covers the full lua_value_to_json_value →
    -- walk_mut → wrap_value cycle.
    describe("set/get round-trip per variant", function()
        test("Null via json.null", function()
            local o = json.object()
            o:set("v", json.null)
            expect(o:get("v")).toBe(json.null)
        end)

        test("Bool true", function()
            local o = json.object()
            o:set("v", true)
            expect(o:get("v")).toBe(true)
        end)

        test("Bool false", function()
            local o = json.object()
            o:set("v", false)
            expect(o:get("v")).toBe(false)
        end)

        test("Int positive", function()
            local o = json.object()
            o:set("v", 42)
            expect(o:get("v")).toBe(42)
        end)

        test("Int negative", function()
            local o = json.object()
            o:set("v", -7)
            expect(o:get("v")).toBe(-7)
        end)

        test("Int zero", function()
            local o = json.object()
            o:set("v", 0)
            expect(o:get("v")).toBe(0)
        end)

        test("Float", function()
            local o = json.object()
            o:set("v", 3.14)
            local v = o:get("v")
            expect(v > 3.13 and v < 3.15).toBe(true)
        end)

        test("Float negative", function()
            local o = json.object()
            o:set("v", -2.5)
            expect(o:get("v")).toBe(-2.5)
        end)

        test("String", function()
            local o = json.object()
            o:set("v", "hello")
            expect(o:get("v")).toBe("hello")
        end)

        test("empty String", function()
            local o = json.object()
            o:set("v", "")
            expect(o:get("v")).toBe("")
        end)

        test("nested Object (via table)", function()
            local o = json.object()
            o:set("v", { x = 1, y = 2 })
            local child = o:get("v")
            expect(child:get("x")).toBe(1)
            expect(child:get("y")).toBe(2)
            expect(child:len()).toBe(2)
        end)

        test("nested Array (via table)", function()
            local o = json.object()
            o:set("v", { 10, 20, 30 })
            local child = o:get("v")
            expect(child:len()).toBe(3)
            expect(child:get(1)).toBe(10)
            expect(child:get(3)).toBe(30)
        end)

        test("nested Object handle as value", function()
            local inner = json.object()
            inner:set("k", "v")
            local outer = json.object()
            outer:set("child", inner)
            expect(outer:get("child"):get("k")).toBe("v")
        end)

        test("nested Array handle as value", function()
            local inner = json.array()
            inner:push(1)
            inner:push(2)
            local outer = json.object()
            outer:set("items", inner)
            expect(outer:get("items"):len()).toBe(2)
            expect(outer:get("items"):get(1)).toBe(1)
        end)

        test("overwrite changes variant type", function()
            local o = json.object()
            o:set("v", 42)
            expect(o:get("v")).toBe(42)
            o:set("v", "now a string")
            expect(o:get("v")).toBe("now a string")
            o:set("v", true)
            expect(o:get("v")).toBe(true)
            o:set("v", json.null)
            expect(o:get("v")).toBe(json.null)
        end)
    end)

    -- push round-trip for every variant (Array) -------------------------------
    describe("push per variant (Array)", function()
        test("all variant types pushed and retrieved", function()
            local a = json.array()
            a:push(json.null)
            a:push(true)
            a:push(false)
            a:push(42)
            a:push(-1)
            a:push(3.14)
            a:push("hello")
            a:push({ x = 1 })
            a:push({ 10, 20 })

            expect(a:get(1)).toBe(json.null)
            expect(a:get(2)).toBe(true)
            expect(a:get(3)).toBe(false)
            expect(a:get(4)).toBe(42)
            expect(a:get(5)).toBe(-1)
            local f = a:get(6)
            expect(f > 3.13 and f < 3.15).toBe(true)
            expect(a:get(7)).toBe("hello")
            expect(a:get(8):get("x")).toBe(1)
            expect(a:get(9):len()).toBe(2)
            expect(a:len()).toBe(9)
        end)
    end)

    -- to_table with null preservation -----------------------------------------
    describe("to_table null preservation", function()
        test("explicit null in object survives to_table", function()
            local root = serde_json.from_str('{"a":1,"b":null,"c":"x"}')
            local t = root:to_table()
            expect(t.a).toBe(1)
            expect(t.b).toBe(json.null)
            expect(t.c).toBe("x")
        end)

        test("null in array survives to_table", function()
            local root = serde_json.from_str('[1, null, "x"]')
            local t = root:to_table()
            expect(t[1]).toBe(1)
            expect(t[2]).toBe(json.null)
            expect(t[3]).toBe("x")
        end)

        test("nested null survives recursive to_table", function()
            local root = serde_json.from_str('{"outer":{"inner":null}}')
            local t = root:to_table()
            expect(t.outer.inner).toBe(json.null)
        end)
    end)

    -- json.null sentinel identity and display ---------------------------------
    describe("json.null sentinel", function()
        test("two nulls from different objects compare equal", function()
            local a = serde_json.from_str('{"v":null}')
            local b = serde_json.from_str('{"v":null}')
            expect(a:get("v")).toBe(b:get("v"))
        end)

        test("null from :get equals json.null constant", function()
            local o = serde_json.from_str('{"v":null}')
            expect(o:get("v") == json.null).toBe(true)
        end)

        test("json.null is not Lua nil", function()
            expect(json.null ~= nil).toBe(true)
        end)

        test("tostring(json.null) is 'null'", function()
            expect(tostring(json.null)).toBe("null")
        end)

        test("null set via json.null round-trips through to_string", function()
            local o = json.object()
            o:set("k", json.null)
            expect(serde_json.to_string(o)).toBe('{"k":null}')
        end)
    end)

    -- serde_json round-trip encoding per variant ------------------------------
    describe("encode round-trip per variant", function()
        test("Bool", function()
            local o = json.object()
            o:set("t", true)
            o:set("f", false)
            expect(serde_json.to_string(o)).toBe('{"f":false,"t":true}')
        end)

        test("Int", function()
            local o = json.object()
            o:set("n", 42)
            expect(serde_json.to_string(o)).toBe('{"n":42}')
        end)

        test("Float", function()
            local o = json.object()
            o:set("n", 1.5)
            expect(serde_json.to_string(o)).toBe('{"n":1.5}')
        end)

        test("String", function()
            local o = json.object()
            o:set("s", "hello")
            expect(serde_json.to_string(o)).toBe('{"s":"hello"}')
        end)

        test("Null", function()
            local o = json.object()
            o:set("v", json.null)
            expect(serde_json.to_string(o)).toBe('{"v":null}')
        end)

        test("nested Object", function()
            local o = json.object()
            o:set("inner", { a = 1 })
            expect(serde_json.to_string(o)).toBe('{"inner":{"a":1}}')
        end)

        test("nested Array", function()
            local o = json.object()
            o:set("arr", { 1, 2, 3 })
            expect(serde_json.to_string(o)).toBe('{"arr":[1,2,3]}')
        end)

        test("full document round-trip", function()
            local src = '{"arr":[1,2],"bool":true,"float":1.5,"int":42,"null_v":null,"obj":{"k":"v"},"str":"hi"}'
            local parsed = serde_json.from_str(src)
            expect(serde_json.to_string(parsed)).toBe(src)
        end)
    end)

    -- error paths -------------------------------------------------------------
    describe("error paths", function()
        test(":get with index 0 throws (1-based indexing)", function()
            local a = serde_json.from_str('[1,2,3]')
            expect(function()
                a:get(0)
            end).toThrow()
        end)

        test(":get with negative index throws", function()
            local a = serde_json.from_str('[1,2,3]')
            expect(function()
                a:get(-1)
            end).toThrow()
        end)

        test(":set with index < 1 on array throws", function()
            local a = json.array()
            expect(function()
                a:set(0, "x")
            end).toThrow()
        end)
    end)
end)
