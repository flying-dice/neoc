{
  "openrpc": "1.4.0",
  "info": {
    "title": "Ticker",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_read",
      "summary": "The count now, and whether the background task is counting.",
      "params": [],
      "result": {
        "name": "count",
        "schema": {
          "$ref": "#/components/schemas/Count"
        }
      }
    },
    {
      "name": "_toggle",
      "summary": "Pause the counting, or resume it.",
      "params": [],
      "result": {
        "name": "count",
        "schema": {
          "$ref": "#/components/schemas/Count"
        }
      }
    },
    {
      "name": "_reset",
      "summary": "Start the count again from zero.",
      "params": [],
      "result": {
        "name": "count",
        "schema": {
          "$ref": "#/components/schemas/Count"
        }
      }
    },
    {
      "name": "_fail",
      "summary": "Always fails (the journeys use it: a control that fails says so, and the counting goes on).",
      "params": [],
      "result": {
        "name": "outcome",
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "name": "count",
      "summary": "The count changed (the task counted, or a control of a window did): every open window shows it.",
      "params": [
        {
          "name": "ticks",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "running",
          "required": true,
          "schema": {
            "type": "boolean"
          }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "Count": {
        "type": "object",
        "properties": {
          "ticks": {
            "type": "integer"
          },
          "running": {
            "type": "boolean"
          }
        },
        "required": [
          "ticks",
          "running"
        ]
      }
    }
  }
}
