{
  "name": "@vos-fixtures/ticker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "A counter that a background task raises on its own.",
  "vos": {
    "title": "Ticker",
    "icon": "clock",
    "tint": "teal",
    "window": {
      "w": 360,
      "h": 280,
      "minW": 320,
      "minH": 240
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "vite build && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vos/vite-plugin": "workspace:*",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
