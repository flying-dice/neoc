{
  "openrpc": "1.3.2",
  "info": {
    "title": "Tasks (Svelte)",
    "version": "0.1.0",
    "description": "A fixture: a task list whose client is written in Svelte, on a Luau backend."
  },
  "x-app": {
    "id": "tasks-svelte",
    "icon": "checkmark",
    "tint": "green",
    "description": "A fixture: a task list whose client is written in Svelte, on a Luau backend.",
    "window": {
      "w": 420,
      "h": 480,
      "minW": 320,
      "minH": 320
    }
  },
  "methods": [
    {
      "name": "list",
      "summary": "Every task, oldest first.",
      "params": [],
      "result": {
        "name": "tasks",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        }
      }
    },
    {
      "name": "add",
      "summary": "Add a task, and answer with the whole list.",
      "params": [
        {
          "name": "title",
          "description": "What has to be done. Blank is refused with a message.",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "result": {
        "name": "tasks",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "A task needs a title."
        }
      ]
    },
    {
      "name": "toggle",
      "summary": "Tick a task off, or back on, and answer with the whole list.",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "result": {
        "name": "tasks",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        }
      }
    },
    {
      "name": "whoami",
      "summary": "Who is calling, and which app answered.",
      "params": [],
      "result": {
        "name": "caller",
        "schema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "app": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "app"
          ]
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "done"
        ]
      }
    }
  }
}
