{
  "openrpc": "1.4.0",
  "info": {
    "title": "Tasks (Svelte)",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_list",
      "summary": "Every task, oldest first.",
      "params": [],
      "result": {
        "name": "tasks",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        }
      }
    },
    {
      "name": "_add",
      "summary": "Add a task, and answer with the whole list.",
      "params": [
        {
          "name": "title",
          "description": "What has to be done. Blank is refused with a message.",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 200
          }
        }
      ],
      "result": {
        "name": "tasks",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "A task needs a title."
        }
      ]
    },
    {
      "name": "_toggle",
      "summary": "Tick a task off, or back on, and answer with the whole list.",
      "params": [
        {
          "name": "id",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "result": {
        "name": "tasks",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Task"
          }
        }
      }
    },
    {
      "name": "_hang",
      "summary": "Waits until an agent's `release_all` tool lets it go (a handler that waits on something that never answers: the journeys use it).",
      "params": [],
      "result": {
        "name": "outcome",
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "name": "_release",
      "summary": "Lets the calls of `hang` that are waiting return.",
      "params": [],
      "result": {
        "name": "outcome",
        "schema": {
          "type": "string"
        }
      }
    },
    {
      "name": "_whoami",
      "summary": "Who is calling, and which app answered.",
      "params": [],
      "result": {
        "name": "caller",
        "schema": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string"
            },
            "app": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "app"
          ]
        }
      }
    },
    {
      "name": "_save_document",
      "summary": "Write a text file into the app's Documents (the folders above it are made). The Files journeys use it to give the host's Files page something to browse.",
      "params": [
        {
          "name": "path",
          "description": "Where in Documents, with `/` between folders.",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 512
          }
        },
        {
          "name": "text",
          "description": "What the file holds.",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 65536
          }
        }
      ],
      "result": {
        "name": "saved",
        "schema": {
          "type": "boolean"
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "The file could not be written."
        }
      ]
    },
    {
      "name": "add_task",
      "summary": "Add a task",
      "description": "Add a task to the list.",
      "params": [
        {
          "name": "title",
          "required": true,
          "description": "What has to be done",
          "schema": {
            "type": "string"
          }
        }
      ],
      "result": {
        "name": "added",
        "schema": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "integer"
            }
          },
          "required": [
            "tasks"
          ]
        }
      }
    },
    {
      "name": "release_all",
      "summary": "Release the hung calls",
      "description": "Let every call of `hang` that is waiting return.",
      "params": [],
      "result": {
        "name": "released",
        "schema": {
          "type": "object",
          "properties": {
            "released": {
              "type": "boolean"
            }
          },
          "required": [
            "released"
          ]
        }
      }
    },
    {
      "name": "list_tasks",
      "summary": "List the tasks",
      "x-readOnly": true,
      "description": "The tasks on the list, with whether each is done.",
      "params": [],
      "result": {
        "name": "listed",
        "schema": {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Task"
              }
            }
          },
          "required": [
            "tasks"
          ]
        }
      }
    },
    {
      "name": "tasks_changed",
      "summary": "The list changed outside the window (an agent added a task): read it again.",
      "params": []
    }
  ],
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "done": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "title",
          "done"
        ]
      }
    }
  }
}
