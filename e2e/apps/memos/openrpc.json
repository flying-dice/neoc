{
  "openrpc": "1.4.0",
  "info": {
    "title": "Memos",
    "version": "0.1.0"
  },
  "methods": [
    {
      "name": "_list",
      "summary": "Every note, newest first.",
      "params": [],
      "result": {
        "name": "notes",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Note"
          }
        }
      }
    },
    {
      "name": "_add",
      "summary": "Add a note, and answer with the whole list.",
      "params": [
        {
          "name": "body",
          "description": "What the note says. Blank is refused with a message.",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 2000
          }
        }
      ],
      "result": {
        "name": "notes",
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/components/schemas/Note"
          }
        }
      },
      "errors": [
        {
          "code": -32010,
          "message": "A note needs some text."
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "body": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "body"
        ]
      }
    }
  }
}
