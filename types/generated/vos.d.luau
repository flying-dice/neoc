export type vos_UiFormat = {
	--- Format a number in the viewer's locale.
	number: (a: any, b: any?) -> vos_Fn,
	--- Format money in the viewer's locale.
	currency: (a: any, b: any?, c: any?) -> vos_Fn,
	--- Format a ratio as a percentage.
	percent: (a: any, b: any?) -> vos_Fn,
	--- Format a byte count (KB, MB, ...).
	bytes: (a: any, b: any?) -> vos_Fn,
	--- Format a date or instant in the viewer's locale and time zone.
	date: (a: any, b: any?) -> vos_Fn,
	--- Format a time of day.
	time: (a: any, b: any?) -> vos_Fn,
	--- Format a date and time.
	dateTime: (a: any, b: any?) -> vos_Fn,
	--- Relative time ("2 minutes ago"), ticking from `env.now`.
	relative: (a: any, b: any?) -> vos_Fn,
	--- Pick a plural form: `fmt.plural(n, {one, other})`.
	plural: (a: any, b: any) -> vos_Fn,
	--- Join a list ("a, b and c").
	list: (a: any, b: any?) -> vos_Fn,
}

--- Client actions: run on the client with no round trip. Handlers take one, or a list mixing actions and functions.
export type vos_UiActions = {
	--- Write a client-managed or app-state ref.
	set: (target: vos_Ref<any> | string, value: any) -> vos_Action,
	--- Flip a boolean ref.
	toggle: (target: vos_Ref<any> | string) -> vos_Action,
	--- Push a route (`{ name = "note", id = 7 }`) onto a navigation stack (the optional `stack` names it).
	push: (route: { name: string, [string]: any }, stack: string?) -> vos_Action,
	--- Pop the top route.
	pop: () -> vos_Action,
	--- Pop to the root screen.
	popToRoot: () -> vos_Action,
	--- Move focus to the node with this key.
	focus: (key: string) -> vos_Action,
	--- Scroll to the node with this key.
	scrollTo: (key: string) -> vos_Action,
	--- Copy text to the clipboard.
	copy: (text: vos_Expr<string>) -> vos_Action,
	--- Report an event to the app (the handler of the node still runs on the host).
	emit: (event: string?, payload: { [string]: any }?) -> vos_Action,
	--- Run actions in order.
	seq: (actions: { vos_Action }) -> vos_Action,
}

