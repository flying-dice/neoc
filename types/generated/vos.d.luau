	as_millis: (self: std_time_Duration) -> number,
	--- Total microseconds (integer, saturating).
	as_micros: (self: std_time_Duration) -> number,
	--- Total nanoseconds (integer, saturating).
	as_nanos: (self: std_time_Duration) -> number,
	--- Total seconds as a float.
	as_secs_f64: (self: std_time_Duration) -> number,
	--- True if the duration is exactly zero.
	is_zero: (self: std_time_Duration) -> boolean,
}

export type std_time_DurationStatics = {
	--- The zero-length duration.
	ZERO: std_time_Duration,
	--- A duration of `secs` whole seconds; negative raises.
	from_secs: (secs: number) -> std_time_Duration,
	--- A duration of `millis` milliseconds; negative raises.
	from_millis: (millis: number) -> std_time_Duration,
	--- A duration of `micros` microseconds; negative raises.
	from_micros: (micros: number) -> std_time_Duration,
	--- A duration of `nanos` nanoseconds; negative raises.
	from_nanos: (nanos: number) -> std_time_Duration,
	--- A duration of `secs` seconds as a float; negative or non-finite raises.
	from_secs_f64: (secs: number) -> std_time_Duration,
