	tempdir: (opts: any?) -> (lib_tempfile_TempDir?, string?),
}

-- ===== lib:text =====

export type lib_text = {
	--- Convert to `camelCase`. Acronym boundaries are detected by the backing `heck` crate.
	to_camel_case: (text: string) -> string,
	--- Convert to `snake_case`.
	to_snake_case: (text: string) -> string,
	--- Convert to `kebab-case`.
	to_kebab_case: (text: string) -> string,
	--- Convert to `PascalCase`.
	to_pascal_case: (text: string) -> string,
	--- Convert to `Title Case`.
	to_title_case: (text: string) -> string,
	--- Convert to `CONSTANT_CASE`.
	to_constant_case: (text: string) -> string,
	--- Greedy word wrap, display-width aware. `width` must be > 0. Defaults: `break_words = false`, `preserve_newlines = true`.
	word_wrap: (text: string, width: number, opts: any?) -> (string?, string?),
	--- Codepoint-based Levenshtein edit distance.
	levenshtein: (a: string, b: string) -> number,
	--- Score each candidate against `input` by Levenshtein distance, returning the list sorted ascending (ties broken alphabetically).
	closest: (input: string, candidates: any, opts: any?) -> (any, string?),
	--- Truncate `text` so its display width is at most `max_len`. The `...` ellipsis counts toward the limit.
	truncate: (text: string, max_len: number, opts: any?) -> (string?, string?),
	--- Pad `text` on the left so total display width equals `width`. `fill_char` must be one display-width-1 character (default space).
	pad_left: (text: string, width: number, fill_char: string?) -> (string?, string?),
	--- Pad `text` on the right so total display width equals `width`. Same constraints as `pad_left`.
	pad_right: (text: string, width: number, fill_char: string?) -> (string?, string?),
	--- Pad `text` on both sides so total display width equals `width`. Uneven padding places the extra column on the right.
	center: (text: string, width: number, fill_char: string?) -> (string?, string?),
	--- Convert `text` to a URL-safe ASCII slug via `deunicode` transliteration, then lowercase and hyphenate.
	slugify: (text: string) -> string,
	--- Remove Unicode white space (the `White_Space` property: spaces, tabs, line breaks, U+00A0, U+3000, ...) from both ends of `text`. Raises when `text` is not valid UTF-8 (repair it with `to_valid_utf8` first).
	trim: (text: string) -> string,
	--- Remove Unicode white space from the start of `text`. Raises when `text` is not valid UTF-8 (repair it with `to_valid_utf8` first).
	trim_start: (text: string) -> string,
	--- Remove Unicode white space from the end of `text`. Raises when `text` is not valid UTF-8 (repair it with `to_valid_utf8` first).
	trim_end: (text: string) -> string,
	--- Clip `text` to at most `max` characters. A character is an extended grapheme cluster (UAX #29, what `lib:unicode.graphemes` yields and a Swift `Character` is): a flag emoji or a letter with its combining accent is one, and is never cut apart. When `text` is cut and `ellipsis` is given, the ellipsis ends the result and counts toward `max`; an ellipsis longer than `max` is left out. The count bounds characters, not bytes: one character may carry any number of combining marks. Raises (it does not return an error) when `max` is negative, fractional or NaN, and when `text` or `ellipsis` is not valid UTF-8; a `max` beyond any text, infinity included, is the whole text.
	clip: (text: string, max: number, ellipsis: string?) -> string,
	--- Make any byte string valid UTF-8: bytes that are not part of a character are replaced with U+FFFD (the replacement character). Valid input is returned as it is.
	to_valid_utf8: (bytes: string) -> string,
	--- Remove what a terminal would act on instead of show: escape sequences (colours, cursor movement, window titles) and control characters. Line feeds and tabs stay, so `\r\n` becomes `\n`. Each line is read on its own, so a sequence that is never ended takes the rest of its line and no more. A C1 control written as a character (U+0080 to U+009F) is removed without being read as the start of a sequence. Raises when `text` is not valid UTF-8 (repair it with `to_valid_utf8` first).
	strip_ansi: (text: string) -> string,
}

-- ===== lib:unicode =====

export type lib_unicode = {
	--- Normalise `s` to a Unicode normalisation form: "nfc", "nfd", "nfkc", or "nfkd" (case-insensitive). C-forms compose combining sequences, D-forms decompose them; the K-forms additionally fold compatibility characters (ﬁ → fi, ① → 1).
	normalize: (s: string, form: string) -> (string?, string?),
	--- Default Unicode case fold of `s` for caseless comparison (UAX #44): ß → "ss", ẞ → "ss", final and medial sigma → σ. Produces a comparison key — fold both sides and compare, do not display the result.
	fold: (s: string) -> string,
	--- Canonical caseless match of `a` and `b` (UAX #44 D145): true when they are equal ignoring case and ignoring canonical-equivalent combining-mark spellings. The robust default for comparing user-supplied text.
	caseless_eq: (a: string, b: string) -> boolean,
	--- Split `s` into a 1-based array of extended grapheme clusters — user-perceived characters (UAX #29). A flag emoji or a base-plus-combining-accent is one element, not its component codepoints.
	graphemes: (s: string) -> any,
	--- Count the extended grapheme clusters in `s` (UAX #29) without materialising them — the user-perceived length, which `#s` (bytes) and codepoint count both miss.
	grapheme_count: (s: string) -> number,
	--- General_Category of the single codepoint `ch` as its two-letter abbreviation ("Lu", "Ll", "Nd", "Zs", …). Errors unless `ch` is exactly one codepoint.
	category: (ch: string) -> (string?, string?),
	--- True when `s` is non-empty and every codepoint has the Unicode Alphabetic property — letters plus letter-numbers such as Roman numerals (broader than Python `str.isalpha`, which counts letters only). The empty string is false.
	is_alphabetic: (s: string) -> boolean,
	--- True when `s` is non-empty and every codepoint is in a Number category — Nd, Nl, or No (narrower than Python `str.isnumeric`, which also counts Numeric_Type codepoints outside those categories such as the CJK numeral 一, U+4E00, category Lo). The empty string is false.
	is_numeric: (s: string) -> boolean,
	--- Terminal display width of `s` in columns (Unicode East-Asian Width): wide/fullwidth CJK count as 2, zero-width and most combining marks as 0. Use this to align text, not `#s` (bytes) or grapheme count.
	width: (s: string) -> number,
}

