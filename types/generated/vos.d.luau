	--- that is a sequence or a mapping, an alias with no anchor, nesting past the parser's limit).
	{ kind: "syntax", line: number, column: number, reason: string, message: string, op: string }
	--- The text as a whole is refused: it holds more than one document, say.
	| { kind: "invalid", reason: string, message: string, op: string }

--- The kinds of `vnd_serde_yaml_EncodeError`.
export type vnd_serde_yaml_EncodeErrorKind = "unsupported"

--- Why a value cannot be written as YAML.
export type vnd_serde_yaml_EncodeError =
	--- The value holds something YAML has no form for.
	{ kind: "unsupported", reason: string, message: string, op: string }

--- The kinds of `vnd_serde_yaml_ReadError`.
export type vnd_serde_yaml_ReadErrorKind = "io" | "syntax" | "invalid"

--- Why a reader does not give a YAML document this module reads.
export type vnd_serde_yaml_ReadError =
	--- The reader failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The text breaks YAML's grammar at a place, or holds there what plain data cannot (a tagged value, a key
	--- that is a sequence or a mapping, an alias with no anchor, nesting past the parser's limit).
	| { kind: "syntax", line: number, column: number, reason: string, message: string, op: string }
	--- The text as a whole is refused: it holds more than one document, say.
	| { kind: "invalid", reason: string, message: string, op: string }

--- The kinds of `vnd_serde_yaml_WriteError`.
export type vnd_serde_yaml_WriteErrorKind = "io" | "unsupported"

--- Why a value was not written to a writer as YAML.
export type vnd_serde_yaml_WriteError =
	--- The writer failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The value holds something YAML has no form for.
	| { kind: "unsupported", reason: string, message: string, op: string }

export type vnd_serde_yaml = {
	--- Read `reader` to its end and parse what it gave as a YAML document, as `decode_string` does.
	---
	--- ```luau
	--- local io = require("std:io")
	--- local doc = assert(serde_yaml.decode(io.from_string("name: alice\n"))) :: { name: string }
	--- assert(doc.name == "alice")
	--- ```
	decode: (reader: std_io_Reader) -> (any, vnd_serde_yaml_ReadError?),
	--- Parse a YAML document as plain data: whatever the text holds. An empty text and `null` are `nil` (with no
	--- error).
	---
	--- ```luau
	--- local doc = assert(serde_yaml.decode_string("name: alice\ntags: [a, b]\n"))
	--- local config = doc :: { name: string, tags: { string } } -- this script's own knowledge of its file
	--- assert(config.name == "alice" and config.tags[2] == "b")
	--- local _, err = serde_yaml.decode_string("key: [unclosed")
	--- assert(err ~= nil and err.kind == "syntax" and err.line == 2)
	--- ```
	decode_string: (text: string) -> (any, vnd_serde_yaml_DecodeError?),
	--- Write plain data as a YAML document: a table without holes is a sequence, any other table a mapping, `nil`
	--- is `null`. A number that is not finite is written `null`.
	---
	--- ```luau
	--- assert(serde_yaml.encode({ name = "bob", tags = { "a", "b" } }) == "name: bob\ntags:\n- a\n- b\n")
	--- ```
	encode: (value: any) -> (string?, vnd_serde_yaml_EncodeError?),
	--- Write plain data to `writer` as a YAML document, as `encode` writes it. Nothing is written when the value
	--- cannot be encoded.
	encode_to: (value: any, writer: std_io_Writer) -> (boolean?, vnd_serde_yaml_WriteError?),
}

-- ===== vnd:service_manager =====

--- What a manager reports and changes. Read it before offering an option to a person.
export type vnd_service_manager_Capabilities = {
	--- Which manager: `systemd`, `launchd`, `windows` or `mock`.
	kind: string,
	--- Where its services are.
	level: vnd_service_manager_Level,
	--- The options of `install` the manager keeps; any other given is `unsupported`.
	install_options: { string },
	--- The options of `configure` the manager can change; any other given is `unsupported`.
	configurable: { string },
	--- The fields of a `Service` the manager reports; the others are always `nil`.
	reported: { string },
}

--- The kinds of `vnd_service_manager_Error`.
export type vnd_service_manager_ErrorKind = "invalid_input" | "unavailable" | "not_found" | "already_exists" | "permission_denied" | "unsupported" | "failed" | "other"

--- Why a call failed. The kind is stable; `reason` is the manager's wording, for a log.
export type vnd_service_manager_Error =
	--- An argument or option was refused before any manager was asked: a label that is not a name, a program
	--- that is not an executable file, a value with a line break.
	{ kind: "invalid_input", reason: string, message: string, op: string }
	--- This machine has no service manager that can be used (`systemctl` missing or systemd not running, a
	--- platform with none), or the one asked for is not this platform's.
	| { kind: "unavailable", reason: string, message: string, op: string }
	--- The manager has no service by that label.
	| { kind: "not_found", label: string, message: string, op: string }
	--- The manager has a service by that label already.
	| { kind: "already_exists", label: string, message: string, op: string }
	--- The operating system refused for want of rights. Nothing was changed. This module does not raise its
	--- own rights: the host process needs them.
	| { kind: "permission_denied", operation: string, reason: string, message: string, op: string }
	--- This manager cannot do what was asked: an option it does not keep (`option` names it) or an operation
	--- it has no way to do. Nothing was changed.
	| { kind: "unsupported", option: string?, reason: string, message: string, op: string }
	--- The manager refused or the operation failed (a program that exits at once, a service that cannot be
	--- started).
	| { kind: "failed", operation: string, reason: string, message: string, op: string }
	--- Anything else, reported and never hidden.
	| { kind: "other", reason: string, message: string, op: string }

--- Where a manager keeps its services: for everyone on the machine, or for one user.
--- - `system`: Services of the machine (systemd system units, LaunchDaemons, Windows services). Changing them needs
--- administrator rights.
--- - `user`: Services of the user the host runs as (systemd user units, LaunchAgents).
export type vnd_service_manager_Level = "system" | "user"

--- A service manager: the machine's, or a mock. Copies of the handle are the same manager.
declare extern type vnd_service_manager_Manager with
	--- What this manager reports and changes.
	capabilities: (self: vnd_service_manager_Manager) -> vnd_service_manager_Capabilities
	--- Every service the manager has registered, whoever registered it, by label. Asked of the operating
	--- system on every call.
	---
	--- Yields the calling coroutine while it waits.
	list: (self: vnd_service_manager_Manager) -> ({ vnd_service_manager_Service }?, vnd_service_manager_Error?)
	--- One service as the manager has it now, or `(nil, nil)` when it has none by that label.
	---
	--- Yields the calling coroutine while it waits.
	get: (self: vnd_service_manager_Manager, label: string) -> (vnd_service_manager_Service?, vnd_service_manager_Error?)
	--- Register a new service and answer it as the manager now has it. It is not started. A label the manager
	--- has is `already_exists`; an option the manager does not keep is `unsupported`; a program that is not an
	--- absolute path of an executable file is `invalid_input`. Needs the rights of the level
	--- (`permission_denied` without them).
	---
	--- Yields the calling coroutine while it waits.
	install: (self: vnd_service_manager_Manager, spec: vnd_service_manager_Spec?) -> (vnd_service_manager_Service?, vnd_service_manager_Error?)
	--- Remove the registration of a service, whoever made it. The program it ran is left where it is. A
	--- service whose definition the manager keeps as part of the system (a vendor unit) is `unsupported`.
	---
	--- Yields the calling coroutine while it waits.
	uninstall: (self: vnd_service_manager_Manager, label: string) -> (boolean?, vnd_service_manager_Error?)
	--- Start a service and answer it as it now is. A service that is running is started already.
	---
	--- Yields the calling coroutine while it waits.
	start: (self: vnd_service_manager_Manager, label: string) -> (vnd_service_manager_Service?, vnd_service_manager_Error?)
	--- Stop a service and answer it as it now is.
	---
	--- Yields the calling coroutine while it waits.
	stop: (self: vnd_service_manager_Manager, label: string) -> (vnd_service_manager_Service?, vnd_service_manager_Error?)
	--- Stop a service and start it again, and answer it as it now is. Changes a manager applies on a start
	--- are applied by it.
	---
	--- Yields the calling coroutine while it waits.
	restart: (self: vnd_service_manager_Manager, label: string) -> (vnd_service_manager_Service?, vnd_service_manager_Error?)
	--- Change what the manager keeps of a service, whoever registered it, and answer it as the manager now
	--- has it. Only the options given change; the rest of the definition, whatever the manager keeps in it, is
	--- left as it was. An option the manager cannot change is `unsupported` (see `capabilities`).
	---
	--- Yields the calling coroutine while it waits.
	configure: (self: vnd_service_manager_Manager, label: string, patch: vnd_service_manager_Patch?) -> (vnd_service_manager_Service?, vnd_service_manager_Error?)
end

--- Which manager `manager` opens.
export type vnd_service_manager_ManagerOptions = {
	--- `"system"` (the default) or `"user"`: where the services are. Windows has only the system level.
	level: vnd_service_manager_Level?,
}

--- What `configure` changes: the options that are given, and nothing else of the service.
export type vnd_service_manager_Patch = {
	--- Start by itself, or not.
	autostart: boolean?,
	--- What the service is for.
	description: string?,
	--- The absolute path of an executable file. The arguments stay unless `args` is given.
	program: string?,
	--- The program's arguments; the whole list is replaced.
	args: { string }?,
	--- The absolute path of a directory the program starts in.
	working_directory: string?,
	--- The variables the manager sets, replacing the ones it has (a file of variables is left alone).
	environment: { [string]: string }?,
	--- When to start it again after it ended.
	restart: vnd_service_manager_Restart?,
	--- Seconds to wait before starting it again.
	restart_delay_secs: number?,
}

--- When the manager starts a service again after it ended.
--- - `never`: Never.
--- - `always`: Whenever it ends.
--- - `on_failure`: When it ends with a failure.
export type vnd_service_manager_Restart = "never" | "always" | "on_failure"

--- A service for `mock` to start with, as if another program had registered it.
export type vnd_service_manager_Seed = {
	--- The label. Default: `""`.
	label: string?,
	--- What it is for.
	description: string?,
	--- Its state: stopped when not given.
	state: vnd_service_manager_State?,
	--- Starts by itself: `false` when not given.
	autostart: boolean?,
	--- The program.
	program: string?,
	--- The arguments.
	args: { string }?,
	--- The directory it starts in.
	working_directory: string?,
	--- Its variables.
	environment: { [string]: string }?,
	--- When it starts again.
	restart: vnd_service_manager_Restart?,
	--- Seconds before it starts again.
	restart_delay_secs: number?,
	--- The mock refuses every change of it with `permission_denied`, as a system service of another user.
	locked: boolean?,
	--- The mock fails to start it, as a program that exits at once.
	broken: boolean?,
}

--- A service as the manager has it now. A field the manager does not report is `nil`.
export type vnd_service_manager_Service = {
	--- The manager's own name for the service: the systemd unit without `.service`, the launchd label, the
	--- Windows service name. Use it as the label of every other call.
	label: string,
	--- What the manager says the service is for.
	description: string?,
	--- What the service is doing now.
	state: vnd_service_manager_State,
	--- The manager's own words about the state, when it has some (a result, a last exit status).
	state_detail: string?,
	--- Whether the service starts by itself (at boot, or at login for a user level service). `nil` when the
	--- manager has no setting for it (a systemd unit that is `static`).
	autostart: boolean?,
	--- The program the service runs, as the manager has it.
	program: string?,
	--- The program's arguments. systemd reports them joined by spaces: one that holds a space is shown split.
	args: { string }?,
	--- The whole command line when the manager keeps one string (Windows).
	command_line: string?,
	--- The directory the program starts in.
	working_directory: string?,
	--- Variables the manager sets for the program.
	environment: { [string]: string }?,
	--- When the service is started again after it ended.
	restart: vnd_service_manager_Restart?,
	--- Seconds the manager waits before it starts the service again.
	restart_delay_secs: number?,
	--- The user the program runs as.
	user: string?,
	--- The file the manager keeps the definition in, when it is one.
	path: string?,
}

--- What `install` registers.
export type vnd_service_manager_Spec = {
	--- The name of the new service (see `Service.label`): letters, digits and `_ . - @ :`. Default: `""`.
	label: string?,
	--- The absolute path of an executable file. Default: `""`.
	program: string?,
	--- The program's arguments.
	args: { string }?,
	--- What the service is for (not kept by every manager).
	description: string?,
	--- The absolute path of a directory the program starts in.
	working_directory: string?,
	--- Variables for the program: letters, digits and `_`.
	environment: { [string]: string }?,
	--- Start by itself: `false` when not given.
	autostart: boolean?,
	--- When to start it again after it ended: the manager's default when not given.
	restart: vnd_service_manager_Restart?,
	--- Seconds to wait before starting it again.
	restart_delay_secs: number?,
	--- The user the program runs as: the account the manager runs services as when not given (root or
	--- Administrator at system level).
	user: string?,
}

--- What a service is doing now.
--- - `running`: Running.
--- - `stopped`: Registered and not running.
--- - `failed`: Ended with a failure, and has not been started since.
--- - `starting`: Being started.
--- - `stopping`: Being stopped.
--- - `paused`: Paused (Windows).
--- - `unknown`: The manager did not say.
export type vnd_service_manager_State = "running" | "stopped" | "failed" | "starting" | "stopping" | "paused" | "unknown"

export type vnd_service_manager = {
	--- The manager of this machine (systemd on Linux, launchd on macOS, the Service Control Manager on Windows),
	--- at the system level unless `level` says `"user"`. A machine whose manager is not there is `unavailable`.
	--- With `NEOC_SERVICE_MANAGER=mock` in the environment it is the process's one mock manager instead, with a
	--- few services of "another program" in it (`mock-nginx`, `mock-cups`, `mock-locked`, `mock-broken`).
	---
	--- ```luau
	--- local manager = assert(service_manager.manager())
	--- print(manager:capabilities().kind)
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	manager: (options: vnd_service_manager_ManagerOptions?) -> (vnd_service_manager_Manager?, vnd_service_manager_Error?),
	--- A new mock manager, for tests: in memory, its own, and gone with the process. It starts with `seeds` as if
	--- other programs had registered them, and it keeps every option, so it is the one to try a script against.
	---
	--- ```luau
	--- local manager = service_manager.mock({ { label = "nginx", state = "running", autostart = true } })
	--- assert(manager:get("nginx").state == "running")
	--- assert(manager:stop("nginx"))
	--- assert(manager:get("nginx").state == "stopped")
	--- ```
	mock: (seeds: { vnd_service_manager_Seed }?) -> vnd_service_manager_Manager,
}

-- ===== vnd:sqlx_mysql =====

--- A value of a row.
export type vnd_sqlx_mysql_Cell = boolean | number | string

--- A pool of connections to one MySQL database.
declare extern type vnd_sqlx_mysql_Database with
	--- Run one statement; how many rows it changed.
	---
	--- Yields the calling coroutine while it waits.
	execute: (self: vnd_sqlx_mysql_Database, sql: string, ...vnd_sqlx_mysql_Param?) -> (number?, vnd_sqlx_mysql_Error?)
	--- Run one SELECT; every row, in order.
	---
	--- Yields the calling coroutine while it waits.
	query: (self: vnd_sqlx_mysql_Database, sql: string, ...vnd_sqlx_mysql_Param?) -> ({ { [string]: vnd_sqlx_mysql_Cell } }?, vnd_sqlx_mysql_Error?)
	--- Run one SELECT; its first row, or `nil` when it has none.
	---
	--- Yields the calling coroutine while it waits.
	query_one: (self: vnd_sqlx_mysql_Database, sql: string, ...vnd_sqlx_mysql_Param?) -> ({ [string]: vnd_sqlx_mysql_Cell }?, vnd_sqlx_mysql_Error?)
	--- A statement to run many times on this database's pool. The SQL is not checked here: a mistake in it is
	--- the error of the statement's first call.
	prepare: (self: vnd_sqlx_mysql_Database, sql: string) -> vnd_sqlx_mysql_Statement
	--- Close every connection of the pool, waiting for the ones in use. Later calls on this database and on
	--- its statements fail with `closed`; closing again does nothing.
	---
	--- Yields the calling coroutine while it waits.
	close: (self: vnd_sqlx_mysql_Database) -> ()
end

--- The kinds of `vnd_sqlx_mysql_Error`.
export type vnd_sqlx_mysql_ErrorKind = "closed" | "constraint" | "database" | "parameter_count" | "connection" | "pool_timed_out" | "decode" | "other"

--- Why a statement failed.
export type vnd_sqlx_mysql_Error =
	--- `close` was called on this database.
	{ kind: "closed", message: string, op: string }
	--- A constraint refused the change.
	| { kind: "constraint", violation: vnd_sqlx_mysql_Violation, reason: string, code: string?, message: string, op: string }
	--- The server refused the statement: a syntax error, a missing table.
	| { kind: "database", reason: string, code: string?, message: string, op: string }
	--- The call gave more or fewer values than the statement has placeholders. Nothing was run.
	| { kind: "parameter_count", given: number, expected: number, message: string, op: string }
	--- The connection to the server failed or broke.
	| { kind: "connection", reason: string, message: string, op: string }
	--- Every connection of the pool stayed busy for as long as a call waits for one.
	| { kind: "pool_timed_out", message: string, op: string }
	--- A column's value could not be read as what its type says.
	| { kind: "decode", column: string, reason: string, message: string, op: string }
	--- Anything else the driver reported.
	| { kind: "other", reason: string, message: string, op: string }

--- The kinds of `vnd_sqlx_mysql_OpenError`.
export type vnd_sqlx_mysql_OpenErrorKind = "invalid_url" | "connect"

--- Why a database could not be opened.
export type vnd_sqlx_mysql_OpenError =
	--- The URL is not a MySQL URL.
	{ kind: "invalid_url", reason: string, message: string, op: string }
	--- No connection was made: nothing answers at the address, or the server refused the user or the database.
	| { kind: "connect", reason: string, message: string, op: string }

--- A value bound to a `?` placeholder. A whole number binds as BIGINT, any other number as DOUBLE, a string as
--- text when it is UTF-8 and as bytes otherwise.
export type vnd_sqlx_mysql_Param = boolean | number | string

--- SQL kept for many calls, made by `db:prepare(sql)`. It runs on the database's pool; sqlx keeps the
--- statement prepared on each connection either way, so what this saves is passing the SQL text from Lua.
declare extern type vnd_sqlx_mysql_Statement with
	--- Run the statement; how many rows it changed.
	---
	--- Yields the calling coroutine while it waits.
	execute: (self: vnd_sqlx_mysql_Statement, ...vnd_sqlx_mysql_Param?) -> (number?, vnd_sqlx_mysql_Error?)
	--- Run the SELECT; every row, in order.
	---
	--- Yields the calling coroutine while it waits.
	query: (self: vnd_sqlx_mysql_Statement, ...vnd_sqlx_mysql_Param?) -> ({ { [string]: vnd_sqlx_mysql_Cell } }?, vnd_sqlx_mysql_Error?)
	--- Run the SELECT; its first row, or `nil` when it has none.
	---
	--- Yields the calling coroutine while it waits.
	query_one: (self: vnd_sqlx_mysql_Statement, ...vnd_sqlx_mysql_Param?) -> ({ [string]: vnd_sqlx_mysql_Cell }?, vnd_sqlx_mysql_Error?)
end

--- Which constraint refused a change.
--- - `unique`: A UNIQUE or PRIMARY KEY constraint.
--- - `foreign_key`: A FOREIGN KEY constraint.
--- - `not_null`: A NOT NULL constraint.
--- - `check`: A CHECK constraint.
export type vnd_sqlx_mysql_Violation = "unique" | "foreign_key" | "not_null" | "check"

export type vnd_sqlx_mysql = {
	--- Open a pool of connections to a MySQL database, and make the first. `url` is a standard MySQL URL:
	--- `mysql://user:pass@host:3306/dbname`.
	---
	--- ```luau
	--- local db, err = sqlx_mysql.open("not-a-url")
	--- assert(db == nil and err ~= nil and err.kind == "invalid_url")
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	open: (url: string) -> (vnd_sqlx_mysql_Database?, vnd_sqlx_mysql_OpenError?),
}

-- ===== vnd:sqlx_postgres =====

--- A value of a row.
export type vnd_sqlx_postgres_Cell = boolean | number | string

--- A pool of connections to one Postgres database.
declare extern type vnd_sqlx_postgres_Database with
	--- Run one statement; how many rows it changed.
	---
	--- Yields the calling coroutine while it waits.
	execute: (self: vnd_sqlx_postgres_Database, sql: string, ...vnd_sqlx_postgres_Param?) -> (number?, vnd_sqlx_postgres_Error?)
	--- Run one SELECT; every row, in order. A column of a type with no Lua form is `unsupported_column`: cast
	--- it to text in the SQL.
	---
	--- Yields the calling coroutine while it waits.
	query: (self: vnd_sqlx_postgres_Database, sql: string, ...vnd_sqlx_postgres_Param?) -> ({ { [string]: vnd_sqlx_postgres_Cell } }?, vnd_sqlx_postgres_Error?)
	--- Run one SELECT; its first row, or `nil` when it has none. A column of a type with no Lua form is
	--- `unsupported_column`: cast it to text in the SQL.
	---
	--- Yields the calling coroutine while it waits.
	query_one: (self: vnd_sqlx_postgres_Database, sql: string, ...vnd_sqlx_postgres_Param?) -> ({ [string]: vnd_sqlx_postgres_Cell }?, vnd_sqlx_postgres_Error?)
	--- Close every connection of the pool, waiting for the ones in use. Later calls on this database fail
	--- with `closed`; closing again does nothing.
	---
	--- Yields the calling coroutine while it waits.
	close: (self: vnd_sqlx_postgres_Database) -> ()
end

--- The kinds of `vnd_sqlx_postgres_Error`.
export type vnd_sqlx_postgres_ErrorKind = "closed" | "constraint" | "database" | "connection" | "pool_timed_out" | "unsupported_column" | "decode" | "other"

--- Why a statement failed.
export type vnd_sqlx_postgres_Error =
	--- `close` was called on this database.
	{ kind: "closed", message: string, op: string }
	--- A constraint refused the change.
	| { kind: "constraint", violation: vnd_sqlx_postgres_Violation, reason: string, code: string?, message: string, op: string }
	--- The server refused the statement: a syntax error, a missing table, a parameter of the wrong type, fewer
	--- values than placeholders.
	| { kind: "database", reason: string, code: string?, message: string, op: string }
	--- The connection to the server failed or broke.
	| { kind: "connection", reason: string, message: string, op: string }
	--- Every connection of the pool stayed busy for as long as a call waits for one.
	| { kind: "pool_timed_out", message: string, op: string }
	--- A column has a type with no Lua form.
	| { kind: "unsupported_column", column: string, type_name: string, message: string, op: string }
	--- A column's value could not be read as what its type says.
	| { kind: "decode", column: string, reason: string, message: string, op: string }
	--- Anything else the driver reported.
	| { kind: "other", reason: string, message: string, op: string }

--- The kinds of `vnd_sqlx_postgres_OpenError`.
export type vnd_sqlx_postgres_OpenErrorKind = "invalid_url" | "connect"

--- Why a database could not be opened.
export type vnd_sqlx_postgres_OpenError =
	--- The URL is not a Postgres URL.
	{ kind: "invalid_url", reason: string, message: string, op: string }
	--- No connection was made: nothing answers at the address, or the server refused the user or the database.
	| { kind: "connect", reason: string, message: string, op: string }

--- A value bound to a `$n` placeholder. A whole number binds as `INT8`, any other number as `FLOAT8`, a
--- string as `TEXT` when it is UTF-8 and as `BYTEA` otherwise.
export type vnd_sqlx_postgres_Param = boolean | number | string

--- Which constraint refused a change.
--- - `unique`: A UNIQUE or PRIMARY KEY constraint.
--- - `foreign_key`: A FOREIGN KEY constraint.
--- - `not_null`: A NOT NULL constraint.
--- - `check`: A CHECK constraint.
--- - `exclusion`: An EXCLUDE constraint.
export type vnd_sqlx_postgres_Violation = "unique" | "foreign_key" | "not_null" | "check" | "exclusion"

export type vnd_sqlx_postgres = {
	--- Open a pool of connections to a Postgres database, and make the first. `url` is a standard Postgres URL:
	--- `postgres://user:pass@host:5432/dbname`.
	---
	--- ```luau
	--- local db, err = sqlx_postgres.open("not-a-url")
	--- assert(db == nil and err ~= nil and err.kind == "invalid_url")
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	open: (url: string) -> (vnd_sqlx_postgres_Database?, vnd_sqlx_postgres_OpenError?),
}

-- ===== vnd:sysinfo =====

--- What holds a process's identity when it is signalled.
--- - `pidfd`: A `pidfd` (Linux): it names one process for good.
--- - `process_handle`: A process handle (Windows): it keeps the PID reserved for its process.
--- - `start_time`: The start time observed, checked again just before the signal: there is a gap between the check and the
--- signal, in which a reused PID would be signalled.
export type vnd_sysinfo_Binding = "pidfd" | "process_handle" | "start_time"

--- What this platform can do with a process.
export type vnd_sysinfo_Capabilities = {
	--- `terminate()` (the request to stop) exists. It does not on Windows.
	terminate: boolean,
	--- `kill()` (the forced stop) exists.
	kill: boolean,
	--- How a signal is bound to the process that was observed, where the platform can (a kernel older than 5.3
	--- has no `pidfd`: `process:binding()` says what a particular handle got).
	binding: vnd_sysinfo_Binding,
}

--- One logical core.
export type vnd_sysinfo_Core = {
	--- The platform's name for it (`cpu0`, `CPU 0`).
	name: string,
	--- How busy it was between the last two refreshes, in percent of the core (0 to 100); `nil` until there
	--- are two.
	usage: number?,
	--- Its clock, in MHz, when the platform says.
	frequency_mhz: number?,
}

--- The processor, as last measured.
export type vnd_sysinfo_CpuStatus = {
	--- How busy the whole processor was between the last two refreshes, in percent (0 to 100); `nil` until there
	--- are two.
	usage: number?,
	--- `usage` is a measurement: there have been two refreshes.
	sampled: boolean,
	--- Every logical core.
	cores: { vnd_sysinfo_Core },
	--- The number of logical cores.
	logical_cores: number,
	--- The number of physical cores, when the platform says.
	physical_cores: number?,
	--- The processor's name, when the platform says.
	brand: string?,
	--- The processor's architecture (`x86_64`, `arm64`).
	arch: string,
	--- The load average, where the platform has one.
	load_average: vnd_sysinfo_LoadAverage?,
}

--- A mounted disk.
export type vnd_sysinfo_DiskInfo = {
	--- Its name.
	name: string,
	--- Where it is mounted.
	mount_point: string,
	--- Its file system (`ext4`, `NTFS`, `apfs`).
	file_system: string,
	--- What kind of disk.
	kind: vnd_sysinfo_DiskKind,
	--- Its size, in bytes.
	total_bytes: number,
	--- What is free, in bytes.
	available_bytes: number,
	--- It can be taken out.
	removable: boolean,
	--- It is mounted read-only.
	read_only: boolean,
	--- Bytes per second read from it between the last two refreshes, over the time that really passed; `nil`
	--- until there are two, and where the platform does not count them.
	read_rate: number?,
	--- Bytes per second written to it, the same way.
	write_rate: number?,
}

--- What kind of disk.
--- - `hdd`: A hard disk.
--- - `ssd`: A solid-state disk.
--- - `unknown`: The platform does not say.
export type vnd_sysinfo_DiskKind = "hdd" | "ssd" | "unknown"

--- The kinds of `vnd_sysinfo_Error`.
export type vnd_sysinfo_ErrorKind = "too_soon" | "process_gone" | "pid_reused" | "own_process" | "permission_denied" | "unknown_identity" | "released" | "unsupported" | "failed"

--- Why a call failed.
export type vnd_sysinfo_Error =
	--- The CPU load was measured less than `MIN_CPU_INTERVAL_MS` ago: refresh again after `retry_after_ms`.
	{ kind: "too_soon", retry_after_ms: number, message: string, op: string }
	--- The process has exited.
	| { kind: "process_gone", message: string, op: string }
	--- The PID belongs to another process now: the one observed has exited and its PID was reused.
	| { kind: "pid_reused", message: string, op: string }
	--- The process is the one this script runs in: it is not signalled from inside it.
	| { kind: "own_process", message: string, op: string }
	--- The operating system refused the signal, and said so.
	| { kind: "permission_denied", reason: string, message: string, op: string }
	--- The process's start time is not known (0: some system processes on macOS and Windows), so nothing tells it
	--- apart from another that is given its PID: no signal is sent to it, and it is not pinned.
	| { kind: "unknown_identity", message: string, op: string }
	--- The native reference to the process was released: this handle signals nothing any more. Take a handle
	--- from the system again.
	| { kind: "released", message: string, op: string }
	--- The platform does not do this (`terminate` on Windows).
	| { kind: "unsupported", reason: string, message: string, op: string }
	--- The platform failed in a way it does not say more about, or in a way that is none of the above.
	| { kind: "failed", reason: string, message: string, op: string }

--- The machine.
export type vnd_sysinfo_Host = {
	--- Its name on the network.
	name: string?,
	--- The operating system (`Ubuntu`, `Windows`, `Darwin`).
	os_name: string?,
	--- Its version.
	os_version: string?,
	--- The kernel's version.
	kernel_version: string?,
	--- The architecture.
	arch: string,
	--- Seconds since it started.
	uptime_secs: number,
	--- When it started, in seconds since the Unix epoch.
	boot_time: number,
}

--- The load average of the last 1, 5 and 15 minutes (not on Windows).
export type vnd_sysinfo_LoadAverage = {
	--- The last minute.
	one: number,
	--- The last five minutes.
	five: number,
	--- The last fifteen minutes.
	fifteen: number,
}

--- Memory, in bytes.
export type vnd_sysinfo_Memory = {
	--- All of it.
	total: number,
	--- What programs use.
	used: number,
	--- What a program could still get (free, and what the system can take back).
	available: number,
	--- What nothing holds at all.
	free: number,
}

--- A network interface.
export type vnd_sysinfo_NetworkInterface = {
	--- Its name.
	name: string,
	--- Its hardware address, when it has one.
	mac_address: string?,
	--- Bytes received since the machine started (or the counter was reset).
	received_bytes: number,
	--- Bytes sent since the machine started (or the counter was reset).
	transmitted_bytes: number,
	--- Bytes per second received between the last two refreshes, over the time that really passed between them;
	--- `nil` until there are two, and when the counter went back.
	receive_rate: number?,
	--- Bytes per second sent, the same way.
	transmit_rate: number?,
}

--- A process as observed: its PID and its start time. It reads that process from the last refresh, and acts on
--- it and on no other.
declare extern type vnd_sysinfo_Process with
	--- Its PID. Read-only.
	pid: number
	--- When it started, in seconds since the Unix epoch. With the PID, it is what makes it this process. It is 0 when
	--- the platform does not say (some system processes on macOS and Windows): such a process is not told apart from
	--- another that is given its PID, so a script should not signal it. Read-only.
	start_time: number
	--- Which sighting of this PID it is: a number the module issues when it first meets a process, and again when
	--- the PID turns out to be another process (even one that started in the same second). A reference kept
	--- outside the module carries it with the PID and start time, and a process with another number is not it. Read-only.
	observation: number
	--- Its name when it was observed: still here when it has exited. Read-only.
	name: string
	--- Is it still there as of the last refresh, with this PID and this start time.
	alive: (self: vnd_sysinfo_Process) -> boolean
	--- Its parent's PID, when it has one and the platform says; `nil` when it is gone.
	parent_pid: (self: vnd_sysinfo_Process) -> number?
	--- Its parent, as last measured, or `nil`. A parent that started after it is not its parent (a PID that was
	--- reused).
	parent: (self: vnd_sysinfo_Process) -> vnd_sysinfo_Process?
	--- The processes whose parent it is, as last measured.
	children: (self: vnd_sysinfo_Process) -> { vnd_sysinfo_Process }
	--- Its executable's path, when the platform says (and the person running this may see it).
	exe: (self: vnd_sysinfo_Process) -> string?
	--- Its command line, one entry per argument; empty when the platform does not say, `nil` when it is gone.
	command: (self: vnd_sysinfo_Process) -> { string }?
	--- The name of the user it runs as, when the platform says and the user is known to the machine.
	user: (self: vnd_sysinfo_Process) -> string?
	--- What state it is in.
	status: (self: vnd_sysinfo_Process) -> vnd_sysinfo_Status?
	--- How much of a core it used between the last two refreshes, in percent: 100 is one whole core, and a
	--- process of several threads passes it. `nil` until it has been in two refreshes, and when it is gone.
	cpu_usage: (self: vnd_sysinfo_Process) -> number?
	--- The memory it holds in RAM, in bytes.
	memory: (self: vnd_sysinfo_Process) -> number?
	--- The memory it has mapped, in bytes.
	virtual_memory: (self: vnd_sysinfo_Process) -> number?
	--- How long it has been running, in seconds, as of the last refresh.
	run_time: (self: vnd_sysinfo_Process) -> number?
	--- What binds a signal to this process: `pidfd`, `process_handle` or `start_time`. Pinned or not, it is the
	--- one that applies to this handle.
	binding: (self: vnd_sysinfo_Process) -> vnd_sysinfo_Binding
	--- Is a native reference to the process held (`pin` was called, and `release` was not).
	pinned: (self: vnd_sysinfo_Process) -> boolean
	--- Was its reference let go (`release` after `pin`). Such a handle signals nothing and cannot be pinned again:
	--- the process has to be taken from the system again.
	released: (self: vnd_sysinfo_Process) -> boolean
	--- Hold a native reference to the process now, after checking it is the one observed, so that a later
	--- `terminate` or `kill` can only reach it, even if its PID is reused in between. It is the binding that
	--- applies, and `start_time` on a platform that has no native reference (then nothing is held). A process
	--- that is gone or whose PID was reused is `process_gone` or `pid_reused`. Hold one only for a process a
	--- person has selected: a reference is a descriptor or a handle, and it stays until `release`. A process whose
	--- start time is not known is `unknown_identity`; a handle that was released is `released`.
	---
	--- Yields the calling coroutine while it waits.
	pin: (self: vnd_sysinfo_Process) -> (vnd_sysinfo_Binding?, vnd_sysinfo_Error?)
	--- Let go of the native reference, if one is held. The handle is finished then: it signals nothing and is not
	--- pinned again (`released()` says so), so a signal that comes late cannot take a new reference.
	release: (self: vnd_sysinfo_Process) -> ()
	--- Ask it to stop (`SIGTERM`): it may handle the request, or ignore it. Never `kill`. `unsupported` on
	--- Windows. `process_gone`, `pid_reused` and `permission_denied` as described in the module.
	---
	--- Yields the calling coroutine while it waits.
	terminate: (self: vnd_sysinfo_Process) -> (boolean?, vnd_sysinfo_Error?)
	--- Stop it, forced (`SIGKILL`, `TerminateProcess`): it is not asked.
	---
	--- Yields the calling coroutine while it waits.
	kill: (self: vnd_sysinfo_Process) -> (boolean?, vnd_sysinfo_Error?)
end

--- How a process is doing.
--- - `idle`: Being created (macOS, FreeBSD), or an idle kernel thread (Linux).
--- - `run`: Running.
--- - `sleep`: Sleeping, until something wakes it.
--- - `stop`: Stopped, by a signal or a debugger.
--- - `zombie`: Exited, and not yet reaped by its parent.
--- - `tracing`: Being traced.
--- - `dead`: Dead.
--- - `wakekill`: Wakekill (Linux).
--- - `waking`: Waking (Linux).
--- - `parked`: Parked (Linux).
--- - `lock_blocked`: Blocked on a lock (BSD).
--- - `uninterruptible_disk_sleep`: Waiting on a disk, and not interruptible.
--- - `suspended`: Suspended (Windows).
--- - `unknown`: The platform's state is none of these.
export type vnd_sysinfo_Status = "idle" | "run" | "sleep" | "stop" | "zombie" | "tracing" | "dead" | "wakekill" | "waking" | "parked" | "lock_blocked" | "uninterruptible_disk_sleep" | "suspended" | "unknown"

--- Swap, in bytes. A machine with none is all zeros.
export type vnd_sysinfo_Swap = {
	--- All of it.
	total: number,
	--- What is in use.
	used: number,
	--- What is not.
	free: number,
}

--- The machine as last measured. Clones share what is measured.
declare extern type vnd_sysinfo_System with
	--- Measure the CPU load (of the machine, of each core and of each process) and the process list, together:
	--- they are one measurement over one interval. `too_soon` if the last was less than `MIN_CPU_INTERVAL_MS`
	--- ago; nothing is measured then.
	---
	--- Yields the calling coroutine while it waits.
	refresh_processes: (self: vnd_sysinfo_System) -> (boolean?, vnd_sysinfo_Error?)
	--- Measure memory and swap.
	---
	--- Yields the calling coroutine while it waits.
	refresh_memory: (self: vnd_sysinfo_System) -> (boolean?, vnd_sysinfo_Error?)
	--- Measure the disks: the list, the space on each, and what each read and wrote since the last refresh.
	---
	--- Yields the calling coroutine while it waits.
	refresh_disks: (self: vnd_sysinfo_System) -> (boolean?, vnd_sysinfo_Error?)
	--- Measure the network interfaces: their counters, and the rate since the last refresh over the time that
	--- really passed.
	---
	--- Yields the calling coroutine while it waits.
	refresh_networks: (self: vnd_sysinfo_System) -> (boolean?, vnd_sysinfo_Error?)
	--- Measure everything. `too_soon` is as for `refresh_processes`, and nothing is measured then.
	---
	--- Yields the calling coroutine while it waits.
	refresh: (self: vnd_sysinfo_System) -> (boolean?, vnd_sysinfo_Error?)
	--- The processor as last measured. `usage` (and each core's) is `nil` until two refreshes of
	--- `refresh_processes` make a difference.
	cpu: (self: vnd_sysinfo_System) -> vnd_sysinfo_CpuStatus
	--- Memory as last measured, in bytes.
	memory: (self: vnd_sysinfo_System) -> vnd_sysinfo_Memory
	--- Swap as last measured, in bytes.
	swap: (self: vnd_sysinfo_System) -> vnd_sysinfo_Swap
	--- The disks as last measured, by mount point.
	disks: (self: vnd_sysinfo_System) -> { vnd_sysinfo_DiskInfo }
	--- The network interfaces as last measured, by name. A rate is `nil` for an interface that has been seen in
	--- one refresh only.
	networks: (self: vnd_sysinfo_System) -> { vnd_sysinfo_NetworkInterface }
	--- The machine: names, versions and how long it has been up. Uptime is read when asked.
	host: (self: vnd_sysinfo_System) -> vnd_sysinfo_Host
	--- The readings this platform does not have at all, by name: they are `nil` (`load_average` is the one a
	--- platform may lack, on Windows).
	unsupported: (self: vnd_sysinfo_System) -> { string }
	--- The process with this PID, as last measured, or `nil` when there is none. The handle names the process
	--- that has the PID now, by its start time too.
	process: (self: vnd_sysinfo_System, pid: number) -> vnd_sysinfo_Process?
	--- Every process as last measured, in the order of their PIDs.
	processes: (self: vnd_sysinfo_System) -> { vnd_sysinfo_Process }
end

export type vnd_sysinfo = {
	--- The shortest time between two measurements of the CPU load, in milliseconds: a refresh sooner than this is
	--- `too_soon`. It is `sysinfo`'s own minimum (a load over less is noise).
	MIN_CPU_INTERVAL_MS: number,
	--- What this platform can do with a process.
	---
	--- ```luau
	--- local can = sysinfo.capabilities()
	--- assert(can.kill)
	--- -- `terminate` is `false` on Windows, which has no request to stop an arbitrary process
	--- assert(can.binding == "pidfd" or can.binding == "process_handle" or can.binding == "start_time")
	--- ```
	capabilities: () -> vnd_sysinfo_Capabilities,
	--- A new `System`: measured once, so memory, disks, networks and the process list are there to read and the loads
	--- are `nil` until the next refresh (after `MIN_CPU_INTERVAL_MS`).
	---
	--- Yields the calling coroutine while it waits.
	system: () -> (vnd_sysinfo_System?, vnd_sysinfo_Error?),
}

-- ===== vnd:testcontainers_modules =====

--- The kinds of `vnd_testcontainers_modules_ContainerError`.
export type vnd_testcontainers_modules_ContainerErrorKind = "docker" | "not_ready" | "not_exposed" | "other"

--- Why a container did not start, stop or answer.
export type vnd_testcontainers_modules_ContainerError =
	--- Docker refused or could not be reached: no daemon, no such image, a name in use.
	{ kind: "docker", reason: string, message: string, op: string }
	--- The container started and what was waited for did not happen: the message never came, the container
	--- exited, the wait timed out.
	| { kind: "not_ready", reason: string, message: string, op: string }
	--- The port is not one the container was started with (`ports`).
	| { kind: "not_exposed", port: number, message: string, op: string }
	--- Anything else, reported and never hidden.
	| { kind: "other", reason: string, message: string, op: string }

--- The container `generic` starts.
export type vnd_testcontainers_modules_ContainerSpec = {
	--- The image's name: `redis`, `registry:5000/team/app`.
	image: string,
	--- The image's tag; `latest` when not given.
	tag: string?,
	--- The container's TCP ports to publish on the host; `port` gives where each one is.
	ports: { number }?,
	--- Environment variables for the container.
	env: { [string]: string }?,
	--- The command to run instead of the image's own: the program, then its arguments.
	cmd: { string }?,
	--- What to wait for before the container is returned; nothing when not given.
	wait: vnd_testcontainers_modules_Wait?,
}

--- A container of any image.
declare extern type vnd_testcontainers_modules_GenericContainer with
	--- The host the container's ports are published on: `"127.0.0.1"`.
	host: (self: vnd_testcontainers_modules_GenericContainer) -> string
	--- The host's port that reaches the container's `container_port`. Only the ports the container was started
	--- with (`ports`) have one; a port that was not raises `not_exposed`.
	---
	--- Raises `vnd_testcontainers_modules_ContainerError` when it fails; `pcall` catches it.
	port: (self: vnd_testcontainers_modules_GenericContainer, container_port: number) -> number
	--- Stop the container and remove it. Stopping a stopped one succeeds. A container that is not stopped is
	--- stopped when its handle is collected.
	---
	--- Yields the calling coroutine while it waits.
	stop: (self: vnd_testcontainers_modules_GenericContainer) -> (boolean?, vnd_testcontainers_modules_ContainerError?)
end

--- A MySQL server in a container.
declare extern type vnd_testcontainers_modules_MysqlContainer with
	--- The connection URL, as `vnd:sqlx_mysql`'s `open` takes it: user `root`, no password, database `test`.
	url: (self: vnd_testcontainers_modules_MysqlContainer) -> string
	--- The host the container's ports are published on: `"127.0.0.1"`.
	host: (self: vnd_testcontainers_modules_MysqlContainer) -> string
	--- The host's port that reaches MySQL's 3306.
	port: (self: vnd_testcontainers_modules_MysqlContainer) -> number
	--- Stop the container and remove it. Stopping a stopped one succeeds. A container that is not stopped is
	--- stopped when its handle is collected.
	---
	--- Yields the calling coroutine while it waits.
	stop: (self: vnd_testcontainers_modules_MysqlContainer) -> (boolean?, vnd_testcontainers_modules_ContainerError?)
end

--- A Postgres server in a container.
declare extern type vnd_testcontainers_modules_PostgresContainer with
	--- The connection URL, as `vnd:sqlx_postgres`'s `open` takes it: user `postgres`, password `postgres`,
	--- database `postgres`.
	url: (self: vnd_testcontainers_modules_PostgresContainer) -> string
	--- The host the container's ports are published on: `"127.0.0.1"`.
	host: (self: vnd_testcontainers_modules_PostgresContainer) -> string
	--- The host's port that reaches Postgres's 5432.
	port: (self: vnd_testcontainers_modules_PostgresContainer) -> number
	--- Stop the container and remove it. Stopping a stopped one succeeds. A container that is not stopped is
	--- stopped when its handle is collected.
	---
	--- Yields the calling coroutine while it waits.
	stop: (self: vnd_testcontainers_modules_PostgresContainer) -> (boolean?, vnd_testcontainers_modules_ContainerError?)
end

--- What a container must do before `generic` returns it.
export type vnd_testcontainers_modules_Wait =
	--- It wrote `message` to its standard output.
	{ type: "stdout", message: string }
	--- It wrote `message` to its standard error.
	| { type: "stderr", message: string }
	--- `seconds` seconds passed.
	| { type: "seconds", seconds: number }
	--- Its image's health check reports it healthy.
	| { type: "healthcheck" }

export type vnd_testcontainers_modules = {
	--- Start a MySQL container as the image is by default; it is returned once MySQL accepts connections.
	---
	--- ```luau
	--- local mysql = assert(testcontainers_modules.mysql())
	--- local db = assert(require("vnd:sqlx_mysql").open(mysql:url()))
	--- db:close()
	--- assert(mysql:stop())
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	mysql: () -> (vnd_testcontainers_modules_MysqlContainer?, vnd_testcontainers_modules_ContainerError?),
	--- Start a Postgres container as the image is by default; it is returned once Postgres accepts connections.
	---
	--- Yields the calling coroutine while it waits.
	postgres: () -> (vnd_testcontainers_modules_PostgresContainer?, vnd_testcontainers_modules_ContainerError?),
	--- Start a container of any image; it is returned once what `wait` names has happened (at once without it).
	---
	--- ```luau
	--- local nginx = assert(testcontainers_modules.generic({
	---     image = "nginx",
	---     tag = "1.27-alpine",
	---     ports = { 80 },
	---     wait = { type = "stderr", message = "start worker processes" },
	--- }))
	--- local address = nginx:host() .. ":" .. nginx:port(80)
	--- assert(nginx:stop())
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	generic: (image: vnd_testcontainers_modules_ContainerSpec) -> (vnd_testcontainers_modules_GenericContainer?, vnd_testcontainers_modules_ContainerError?),
}

-- ===== vnd:toml =====

--- The kinds of `vnd_toml_DecodeError`.
export type vnd_toml_DecodeErrorKind = "syntax"

--- Why a text is not TOML.
export type vnd_toml_DecodeError =
	--- The text breaks TOML's grammar, or says something twice (a key, a table).
	{ kind: "syntax", line: number, column: number, reason: string, message: string, op: string }

--- The kinds of `vnd_toml_EncodeError`.
export type vnd_toml_EncodeErrorKind = "unsupported"

--- Why a value cannot be written as TOML.
export type vnd_toml_EncodeError =
	--- The document holds something TOML has no form for (a number that is not finite, say).
	{ kind: "unsupported", reason: string, message: string, op: string }

--- The kinds of `vnd_toml_ReadError`.
export type vnd_toml_ReadErrorKind = "io" | "invalid_utf8" | "syntax"

--- Why a reader does not give a TOML document.
export type vnd_toml_ReadError =
	--- The reader failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- What was read is not UTF-8.
	| { kind: "invalid_utf8", offset: number, message: string, op: string }
	--- The text breaks TOML's grammar, or says something twice (a key, a table).
	| { kind: "syntax", line: number, column: number, reason: string, message: string, op: string }

--- The kinds of `vnd_toml_WriteError`.
export type vnd_toml_WriteErrorKind = "io" | "unsupported"

--- Why a value was not written to a writer as TOML.
export type vnd_toml_WriteError =
	--- The writer failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The document holds something TOML has no form for (a number that is not finite, say).
	| { kind: "unsupported", reason: string, message: string, op: string }

export type vnd_toml = {
	--- Read `reader` to its end and parse what it gave as a TOML document, as `decode_string` does.
	---
	--- ```luau
	--- local io = require("std:io")
	--- local doc = assert(toml.decode(io.from_string('name = "demo"\n')))
	--- assert(doc.name == "demo")
	--- ```
	decode: (reader: std_io_Reader) -> ({ [string]: any }?, vnd_toml_ReadError?),
	--- Parse a TOML document: its top-level keys, each holding whatever the text gives it. A date or time is its
	--- text.
	---
	--- ```luau
	--- local doc = assert(toml.decode_string('[server]\nhost = "localhost"\nport = 8080\n'))
	--- local server = doc.server :: { host: string, port: number } -- this script's own knowledge of its file
	--- assert(server.host == "localhost" and server.port == 8080)
	--- local _, err = toml.decode_string("key = [unclosed")
	--- assert(err ~= nil and err.kind == "syntax" and err.line == 1)
	--- ```
	decode_string: (text: string) -> ({ [string]: any }?, vnd_toml_DecodeError?),
	--- Write a document (a table with string keys) as TOML, compactly.
	---
	--- ```luau
	--- assert(toml.encode({ name = "demo", port = 8080 }) == 'name = "demo"\nport = 8080\n')
	--- ```
	encode: (value: { [string]: any }) -> (string?, vnd_toml_EncodeError?),
	--- Write a document (a table with string keys) as TOML, with arrays one item to a line.
	encode_pretty: (value: { [string]: any }) -> (string?, vnd_toml_EncodeError?),
	--- Write a document to `writer` as TOML, as `encode` writes it. Nothing is written when the document cannot
	--- be encoded.
	encode_to: (value: { [string]: any }, writer: std_io_Writer) -> (boolean?, vnd_toml_WriteError?),
}

-- ===== vos:app =====

--- Who is calling.
export type vos_app_Actor = {
	--- The person, an agent or another app.
	kind: vos_app_ActorKind,
	--- The caller's id: `"user"` for the person, the agent's id for an agent, the app's id for an app.
	id: string,
	--- The name to show for the caller.
	name: string,
}

--- What makes a call: the person, from the app's page, an agent, through a tool, or another app's backend.
--- - `user`: The person, from the app's page.
--- - `agent`: An agent, through a tool.
--- - `app`: Another app's backend: a request it sent (`RPC.send_request`), or its notification reaching a listener (`RPC.on_notification`).
export type vos_app_ActorKind = "user" | "agent" | "app"

--- What an app may know of an agent contact: never grants, tokens or launch commands.
export type vos_app_AgentCard = {
	id: string,
	name: string,
	avatar: string?,
	role: string,
}

--- The agent contacts of the host.
declare extern type vos_app_Agents with
	--- Every agent contact.
	list: (self: vos_app_Agents) -> { vos_app_AgentCard }
end

--- The agent of the app's own a tool is called for: who the tool is told called it (its `ctx.actor`).
export type vos_app_Caller = {
	--- The app's own id for its agent, 1 to 200 bytes.
	id: string,
	--- The agent's name, 1 to 200 bytes.
	name: string,
}

--- What a handler of the app's backend is called with: who is calling and when.
declare extern type vos_app_Context with
	--- Who is calling. From the app's page it is the person (`kind` is `"user"`). Read-only.
	actor: vos_app_Actor
	--- When the call was made: an ISO 8601 time in UTC. Read-only.
	now: string
	--- End the call with `message`, which the caller is shown as it is: no file or line. A handler's caller is the
	--- page, whose `rpc` rejects with an application error (-32010) carrying the message; to fail with another
	--- JSON-RPC code, raise `error("RPC-32602 Title cannot be empty", 0)`. An agent's tool call is a request too: its caller is the agent. It never
	--- returns (it is declared `never`), so `return ctx:fail(...)` fits a handler whatever its result is.
	fail: (self: vos_app_Context, message: string) -> never
end

--- The app's database (SQLite), its own and no other app's.
declare extern type vos_app_Db with
	--- Bring the schema up to date: `steps` are SQL scripts in order, each run once, ever (`steps[3]` is version
	--- 3). Add a step to change the schema; never edit one that has run. Raises inside `db:tx`.
	---
	--- Yields the calling coroutine while it waits.
	migrate: (self: vos_app_Db, steps: { string }) -> ()
	--- Run a statement that writes. Raises when the statement fails, and inside a read-only call.
	---
	--- Yields the calling coroutine while it waits.
	exec: (self: vos_app_Db, sql: string, params: { [string]: any }?) -> vos_app_ExecResult
	--- Every row of a query.
	---
	--- Yields the calling coroutine while it waits.
	all: (self: vos_app_Db, sql: string, params: { [string]: any }?) -> { { [string]: any } }
	--- The first row of a query, or `nil` when there is none.
	---
	--- Yields the calling coroutine while it waits.
	one: (self: vos_app_Db, sql: string, params: { [string]: any }?) -> { [string]: any }?
	--- Run `body` in a transaction: the statements inside commit together or not at all (an error raised in the
	--- body rolls them back and is raised again). Returns what the body returned. Cannot be nested.
	---
	--- Yields the calling coroutine while it waits.
	tx: (self: vos_app_Db, body: () -> any) -> any
end

--- What a write did.
export type vos_app_ExecResult = {
	--- How many rows the statement changed.
	changes: number,
	--- The row id of the last insert.
	last_insert_id: number,
}

--- The kinds of `vos_app_FileError`.
export type vos_app_FileErrorKind = "not_found" | "permission_denied" | "already_exists" | "not_empty" | "is_directory" | "not_a_directory" | "cross_device" | "invalid_input" | "read_only_filesystem" | "storage_full" | "unsupported" | "too_large" | "other"

--- Why a file call failed. The kinds are the ones `std:fs` uses and mean the same on every platform;
--- `message` names the path the failure is about (never a path of the host) and is for a person.
export type vos_app_FileError =
	--- The path does not exist.
	{ kind: "not_found", message: string, op: string }
	--- The host may not do this.
	| { kind: "permission_denied", message: string, op: string }
	--- What was to be made is already there.
	| { kind: "already_exists", message: string, op: string }
	--- The directory has entries.
	| { kind: "not_empty", message: string, op: string }
	--- The path is a directory where a file was needed.
	| { kind: "is_directory", message: string, op: string }
	--- The path, or a parent of it, is not a directory.
	| { kind: "not_a_directory", message: string, op: string }
	--- The two paths are on different filesystems.
	| { kind: "cross_device", message: string, op: string }
	--- The path is not one a location takes: absolute, `..`, `:`, a backslash, NUL, or a name over 255 bytes.
	| { kind: "invalid_input", message: string, op: string }
	--- The filesystem is mounted read-only.
	| { kind: "read_only_filesystem", message: string, op: string }
	--- The disk or the quota is full.
	| { kind: "storage_full", message: string, op: string }
	--- The host has no file store for apps, or the platform cannot do this.
	| { kind: "unsupported", message: string, op: string }
	--- More than fits: a file over 64 MiB.
	| { kind: "too_large", message: string, op: string }
	--- Any other failure.
	| { kind: "other", message: string, op: string }

--- An entry of `app.files`.
export type vos_app_FileInfo = {
	--- The last component of its path.
	name: string,
	--- What it is; a symbolic link is not followed.
	kind: vos_app_FileKind,
	--- Its size in bytes.
	size: number,
	--- When it was last modified, in seconds since the Unix epoch; `nil` where the filesystem does not record it.
	modified: number?,
}

--- What an entry is; a symbolic link is never followed.
export type vos_app_FileKind = "file" | "dir" | "symlink" | "other"

--- The app's managed files: one shared set per app (not per person or device), found from the app's identity.
--- `documents` for what the person would miss, `cache` for what the app can rebuild, `temp` for scratch files.
--- All three are deleted when the app's data is deleted (uninstall with purge, "delete data"), and kept otherwise.
declare extern type vos_app_Files with
	--- What the person would miss. Read-only.
	documents: vos_app_Location
	--- What the app can rebuild. Read-only.
	cache: vos_app_Location
	--- Scratch files. Read-only.
	temp: vos_app_Location
end

--- A tool of a running app, as an agent is shown it.
export type vos_app_HostTool = {
	--- `<appId>__<tool>`: what `app.tools.call` takes.
	name: string,
	--- The app it belongs to.
	app: string,
	--- The name a person is shown.
	title: string?,
	--- What the tool does.
	description: string,
	--- The JSON Schema of its input.
	input_schema: { [string]: any },
	--- It changes nothing: it runs with every write refused.
	read_only: boolean,
}

--- JSON values in the app's database, by key: for a setting or a cursor, not for records (use `app.db`).
declare extern type vos_app_Kv with
	--- The value stored under `key`, or `nil`.
	---
	--- Yields the calling coroutine while it waits.
	get: (self: vos_app_Kv, key: string) -> any?
	--- Store `value` (any JSON value) under `key`; `nil` deletes the key. Raises inside a read-only call.
	---
	--- Yields the calling coroutine while it waits.
	set: (self: vos_app_Kv, key: string, value: any) -> ()
	--- Delete `key`. Raises inside a read-only call.
	---
	--- Yields the calling coroutine while it waits.
	delete: (self: vos_app_Kv, key: string) -> ()
end

--- A bearer token for the host's `/mcp`, leased for an agent of the app's own, and where the agent uses it.
export type vos_app_Lease = {
	--- The bearer token (`Authorization: Bearer <token>`).
	token: string,
	--- `<scheme>://<host>:<port>/mcp`.
	url: string,
}

--- What `app.tools.lease` takes besides the agent.
export type vos_app_LeaseOptions = {
	--- The host name or IP address the URL names: the address this machine has where the agent is (the local
	--- address of the connection to it). The host's own address when left out.
	host: string?,
}

--- One managed location of the app (`app.files.documents`, `.cache`, `.temp`). A path is relative to it, written
--- with `/` (`"notes/a.txt"`; `""` is the location itself); an absolute path, `..`, `:`, a backslash, NUL or a name
--- over 255 bytes is `invalid_input`, and a symbolic link inside it is never followed. A failure is returned as
--- `nil, err` with the kinds of `std:fs` (`err.kind`). A write inside a read-only call raises. A call holds the
--- app's turn until it ends. Scoped to the app by convention: not a sandbox.
declare extern type vos_app_Location with
	--- The whole file (binary-safe); at most 64 MiB (`too_large`). A directory is `is_directory`.
	---
	--- Yields the calling coroutine while it waits.
	read: (self: vos_app_Location, path: string) -> (string?, vos_app_FileError?)
	--- Create or replace the file in one step (a reader never sees half of it). The parent must exist (`not_found`).
	---
	--- Yields the calling coroutine while it waits.
	write: (self: vos_app_Location, path: string, data: string) -> (boolean?, vos_app_FileError?)
	--- The entries of a directory (default: the location), sorted by name.
	---
	--- Yields the calling coroutine while it waits.
	list: (self: vos_app_Location, path: string?) -> ({ vos_app_FileInfo }?, vos_app_FileError?)
	--- What `path` is: type, size, modification time.
	---
	--- Yields the calling coroutine while it waits.
	info: (self: vos_app_Location, path: string) -> (vos_app_FileInfo?, vos_app_FileError?)
	--- Create a directory and the missing ones above it; one already there is not an error.
	---
	--- Yields the calling coroutine while it waits.
	create_dir: (self: vos_app_Location, path: string) -> (boolean?, vos_app_FileError?)
	--- Remove a file, or a directory: empty (`not_empty` otherwise) unless `{ recursive = true }`.
	---
	--- Yields the calling coroutine while it waits.
	remove: (self: vos_app_Location, path: string, options: vos_app_RemoveOptions?) -> (boolean?, vos_app_FileError?)
	--- Rename or move inside the location; an existing file at `to` is replaced.
	---
	--- Yields the calling coroutine while it waits.
	move: (self: vos_app_Location, from: string, to: string) -> (boolean?, vos_app_FileError?)
	--- Copy a file (an existing file at `to` is replaced) or a directory tree (`to` must not exist).
	---
	--- Yields the calling coroutine while it waits.
	copy: (self: vos_app_Location, from: string, to: string) -> (boolean?, vos_app_FileError?)
end

--- A notification: a title and an optional body, and no other key. The host adds which app sent it.
export type vos_app_Notification = {
	--- 1 to 200 characters, not blank.
	title: string,
	--- Up to 2000 characters.
	body: string?,
}

--- How `remove` treats a directory.
export type vos_app_RemoveOptions = {
	--- Remove a directory with everything in it. Default: `false`.
	recursive: boolean?,
}

--- The kinds of `vos_app_ToolCallError`.
export type vos_app_ToolCallErrorKind = "not_found" | "failed" | "internal"

--- Why a tool of a running app gave no result.
export type vos_app_ToolCallError =
	--- No running app has the tool: it does not exist, or its app is not running.
	{ kind: "not_found", message: string, op: string }
	--- The tool failed: it refused its input, raised, or said it could not (`ctx:fail`).
	| { kind: "failed", message: string, op: string }
	--- The host could not run it.
	| { kind: "internal", message: string, op: string }

--- The tools of every running app, for an app that offers them to an agent of its own: `app.tools.all()` and
--- `app.tools.call(name, agent, args)`, or over the host's `/mcp` with `app.tools.lease(agent, opts?)` and
--- `app.tools.release(token)`.
declare extern type vos_app_tools with
end

--- The statics of `vos_app_tools`.
export type vos_app_toolsStatics = {
	--- Every tool of every running app (this one's too), in name order.
	all: () -> { vos_app_HostTool },
	--- Run a tool of a running app for an agent of this app's own, with `args` (none when left out): `agent` is who
	--- the tool is told called it (its `ctx.actor`). Nothing checks what that agent may call: the app decides whom it offers the tools to. The
	--- result is `(result, nil)`, or `(nil, err)` when the tool failed, does not exist or its app is not running.
	--- Raises for a name that is not `<appId>__<tool>`, an agent whose `id` or `name` is not 1 to 200 bytes, and
	--- inside a read-only call. It waits without the app's turn: the tool runs in another app's VM, or in this
	--- one's as any other call.
	---
	--- Yields the calling coroutine while it waits.
	call: (name: string, agent: vos_app_Caller, args: { [string]: any }?) -> (any, vos_app_ToolCallError?),
	--- Lease a bearer token for the host's `/mcp` for an agent of this app's own, so an agent elsewhere calls the
	--- tools `app.tools.call` runs for it: every tool of every running app but this one's, the tool told the same
	--- `ctx.actor`. Like `app.tools.call`, nothing checks whom the app gives it to. The lease is in memory only, never
	--- in the person's roster: it works until `app.tools.release(token)`, or until this app's backend stops (it is
	--- stopped, reloaded or uninstalled, or the host stops). Raises for an agent whose `id` or `name` is not 1 to 200
	--- bytes, a `host` that is not a host name or an IP address, and inside a read-only call.
	lease: (agent: vos_app_Caller, opts: vos_app_LeaseOptions?) -> vos_app_Lease,
	--- Revoke a token this app leased: it stops working at once, and the agent's MCP sessions are told their tool
	--- list changed. A token that is not one of this app's leases (released already, say) is left alone. Raises
	--- inside a read-only call.
	---
	--- Yields the calling coroutine while it waits.
	release: (token: string) -> (),
}

--- The `app` API.
---
--- `local app = require("vos:app")` in an app's backend; it is also the global `app`. The host provides it (one VM
--- per app). The backend serves its methods on the bus (`RPC.on_request`).
export type vos_app = {
	--- The app's id.
	id: string,
	--- The app's database: migrations, statements and transactions.
	db: vos_app_Db,
	--- A small durable key-value store (JSON values).
	kv: vos_app_Kv,
	--- The app's managed files.
	files: vos_app_Files,
	--- The agent contacts.
	agents: vos_app_Agents,
	tools: vos_app_toolsStatics,
	--- Open the app's window on the person's screen, or bring it forward if it is open (every connected shell is
	--- asked; with none connected nothing happens). An app has one window, the frame of its page; `params` is
	--- JSON handed to it. A change to the world like `notify`: a read-only call may not.
	open_window: (params: { [string]: any }?) -> (),
	--- `app.notify { title, body }`: tell the person something now. It reaches the clients connected now; one that
	--- is not connected never gets it (nothing is kept for later). The host sends the app's id with it, never text
	--- from the app, and each shell client draws it as a banner above its windows with the app's name and icon
	--- from its own app list: not on a client where one of the app's windows is in front, on every other client,
	--- with or without a window open. A page with no shell (the app opened on its own) draws none. The title is
	--- shown on one line (line breaks and control characters become spaces; direction overrides and characters
	--- that draw nothing are removed, but not the joiners and variation selectors that make an emoji or a word)
	--- and both are text, never markup.
	---
	--- Raises: a key other than `title` and `body`, no title, a title that is blank or over 200 characters, a body
	--- over 2000, a value that is not a string, a call inside a read-only call, and a 65th while 64 from the same
	--- call are still waiting. The host delivers waiting notifications whenever a call of the app ends, and when a
	--- call waits (`task.wait`, a request, a task or request handler pausing, or a tool that has notified and then
	--- works on), so a tool that notifies half way is heard then, not when it returns. The limit guards against a
	--- runaway loop; it is not a quota to plan around.
	notify: (notification: vos_app_Notification) -> (),
	--- Write a line to the host's log, with the app's id.
	log: (message: string) -> (),
}

-- ===== vos:docker =====

--- One container the app owns, found by a label that carries the app's id (`vos.app=<app.id>`), never
--- by its name alone.
export type vos_docker_Container = {
	--- Docker's filters for what happens to the container, for `docker.watch`.
	filters: { [string]: { string } },
	--- How the container is doing, and whether it is what `declared` says (never, for none). With
	--- Docker away it is `absent`.
	status: (self: vos_docker_Container, declared: vos_docker_Declaration?) -> vos_docker_ContainerStatus,
	--- Have the container be what `declared` says: its image pulled when Docker has none, made and
	--- started; removed for none. One that is that already, and runs, is left running unless
	--- `always`. It is never changed: a change of the declaration is the container removed and made
	--- again. Answers with why it could not, as a sentence (a declaration that is not one is refused
	--- before Docker hears of it), and with nothing when it did.
	apply: (self: vos_docker_Container, declared: vos_docker_Declaration?, always: boolean?) -> string?,
	--- The end of what the container wrote (`docker.logs`). Nothing, and no reason, when there is no
	--- container.
	logs: (self: vos_docker_Container, tail: number?) -> (vos_docker_Logs?, string?),
}

--- What an owned container is doing.
--- - `absent`: There is none (or Docker is away).
--- - `running`: It runs.
--- - `restarting`: Docker is starting it again.
--- - `stopped`: It is there and does not run.
export type vos_docker_ContainerState = "absent" | "running" | "restarting" | "stopped"

--- How an owned container is doing.
export type vos_docker_ContainerStatus = {
	--- What it is doing.
	state: vos_docker_ContainerState,
	--- Docker's own words for it (`Up 2 hours`).
	status: string,
	--- It was made from the declaration it was compared with.
	current: boolean,
	--- Why it could not be made or started the last time that was tried; empty when it could.
	problem: string,
}

--- What a container an app owns is made from. Everything it gets of the machine is here: nothing is published or
--- mounted that is not declared.
export type vos_docker_Declaration = {
	--- The image it runs.
	image: string,
	--- What the image starts with, in place of its own.
	entrypoint: { string }?,
	--- What that is given, in place of the image's own.
	command: { string }?,
	--- `NAME=value`, each.
	environment: { string }?,
	--- The ports it publishes.
	ports: { vos_docker_Port }?,
	--- The folders it may read.
	mounts: { vos_docker_Mount }?,
}

--- The end of what a container wrote, as text fit to show.
export type vos_docker_Logs = {
	--- Valid UTF-8, without a terminal's colour sequences and control characters.
	text: string,
	--- There was more before it.
	truncated: boolean,
}

--- A folder of the machine the container may read. It is never writable.
export type vos_docker_Mount = {
	--- The folder on the machine, a whole path.
	source: string,
	--- Where the container finds it.
	target: string,
}

--- A port of the container, published on the machine.
export type vos_docker_Port = {
	--- The machine's port.
	host: number,
	--- The container's port.
	container: number,
	--- UDP; TCP when left out.
	udp: boolean?,
}

--- Whether Docker can be reached, as a page shows it.
export type vos_docker_Status = {
	--- Docker answered.
	reachable: boolean,
	--- Its version, when it can be reached; empty when not.
	version: string,
	--- The chosen address; empty for this machine's own Docker.
	host: string,
	--- Why it cannot be reached, as a sentence; empty when it can.
	problem: string,
}

--- The container framework, over `vnd:bollard`.
---
--- `local docker = require("vos:docker")` in the backend of an app that runs on Docker: which Docker (the
--- person's choice, kept in the app's settings), the clients that reach it, the watch for changes, and one
--- container the app owns, kept as its declaration says. The host carries it and runs it in the app's own
--- VM, so the Docker an app chose is that app's alone.
export type vos_docker = {
	--- The chosen Docker's address; empty for this machine's own.
	host: () -> string,
	--- Choose the Docker the app uses: `unix:///...`, `tcp://...`, `http://...` or `https://...`, or empty for
	--- this machine's own. Answers with why the address was refused, and with nothing when it was taken (a
	--- Docker that is not running there is a fine choice: `status` says so, and it may start later).
	use: (host: string) -> string?,
	--- Whether Docker can be reached. Never fails: a Docker that is away is an answer.
	status: () -> vos_docker_Status,
	--- Why a `vnd:bollard` call failed, as a sentence for the person: Docker's own message when it has one,
	--- the framework's words when Docker cannot be reached or is not answering.
	sentence: (err: vnd_bollard_DockerError?) -> string,
	--- The client that reads what Docker has (it waits 5 seconds for an answer), or why there is none, as a
	--- sentence.
	reader: () -> (vnd_bollard_Client?, string?),
	--- The client that changes it (90 seconds).
	actor: () -> (vnd_bollard_Client?, string?),
	--- The client that pulls an image (10 minutes).
	puller: () -> (vnd_bollard_Client?, string?),
	--- The end of what a container wrote, by id or name: its output and its errors together, at most 256 KiB,
	--- as valid UTF-8 without a terminal's colour sequences and control characters. `tail` is how many lines
	--- from the end (200 when left out, at most 10000).
	logs: (container: string, tail: number?) -> (vos_docker_Logs?, string?),
	--- Watch Docker for as long as the app is loaded, and call `changed` whenever what it has of `filters`
	--- (Docker's own, for its events) may be different: something happened to a container, Docker came or
	--- went, or another Docker was chosen. A Docker that is away is looked for again every 5 seconds. It
	--- never returns: `task.spawn(docker.watch, filters, changed)`.
	watch: (filters: { [string]: { string } }, changed: () -> ()) -> (),
	--- The container named `name` (a new one is given that name) that is this app's.
	container: (name: string) -> vos_docker_Container,
}

-- ===== vos:rpc =====

--- The kinds of `vos_rpc_RequestError`.
export type vos_rpc_RequestErrorKind = "not_found" | "failed" | "internal"

--- Why a request gave no result.
export type vos_rpc_RequestError =
	--- The app is not running, or nothing on the bus handles the method.
	{ kind: "not_found", message: string, op: string }
	--- The handler refused the params, raised, or said it could not (`ctx:fail`).
	| { kind: "failed", message: string, op: string }
	--- The host could not run it.
	| { kind: "internal", message: string, op: string }

--- The RPC bus: `local RPC = require("vos:rpc")`, and the global `RPC`. A page has the same four functions on its
--- global `RPC`. Every call names its app; only an app serves its own methods and sends its own notifications.
export type vos_rpc = {
	--- Send a request on the RPC bus to `app` (this one's id included): every handler registered for `method`, a
	--- backend's (`on_request`) or an open page's, is asked, and the first answer wins (the others
	--- are cancelled). The handler is told this app called (`ctx.actor.kind` is `"app"`). The result is
	--- `(result, nil)`, or `(nil, err)` when the app is not running, nothing handles the method, or the handler
	--- failed. Raises for an id that is not an app's, a method name that is not 1 to 128 characters, and inside a
	--- read-only call. It waits without the app's turn.
	---
	--- Yields the calling coroutine while it waits.
	send_request: (app: string, method: string, params: { [string]: any }?) -> (any, vos_rpc_RequestError?),
	--- Serve one of this app's methods on the RPC bus: `fn(params, ctx)` answers a request for `method`, from the
	--- app's page, another app or an agent. An open page of the app may serve it too: the first answer wins. A public
	--- method (no leading `_`) is an agent tool too, described by the app's contract. Raises for a method
	--- this backend already serves, and inside a read-only call.
	on_request: (method: string, handler: (arg1: any, arg2: vos_app_Context) -> any) -> (),
	--- Send one of this app's notifications on the RPC bus: to the app's open pages and backend listeners and, unless
	--- it is a `_name`, to every other app that listens. Nothing waits for it. `name` is 1 to 64 letters, digits and `. _ : -` (not
	--- `host:...`), `params` is JSON of at most 64 KiB. A change to the world like `app.notify`: a read-only call may not.
	send_notification: (name: string, params: any?) -> (),
	--- Hear an app's notification (this one's too: what its page sends): `fn(params, ctx)` runs, as a call of this
	--- app's own, each time `app` sends `name`, with `ctx.actor` that app. Listeners run in the order they were added.
	--- Raises for an id that is not an app's, another app's `_name` (private: it never leaves that app) or a `host:`
	--- name, and inside a read-only call.
	on_notification: (app: string, name: string, listener: (arg1: any, arg2: vos_app_Context) -> ()) -> (),
}

-- ===== not for apps =====
-- A module in NOT_FOR_APPS (the Lua adapter refuses it when it runs) and a global the app's environment does not
-- have. A module or a library is a table with one `never` field: the first member access is a type error naming it
-- (requiring the module is not one: `bun run lint:luau` scans the `require`s). A function global takes a `never`
-- argument and returns `never`: any call of it, direct or through `pcall`, is a type error.

