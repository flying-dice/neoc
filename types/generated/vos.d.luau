	CertIssuerPublicKey: string?,
}

--- A volume, with Docker's field names.
export type vnd_bollard_Volume = {
	--- The volume's name.
	Name: string,
	--- The driver that keeps it (`local`).
	Driver: string,
	--- Where it is on the host.
	Mountpoint: string,
	--- When it was made, as RFC 3339 text (`2024-05-01T10:00:00Z`).
	CreatedAt: string?,
	--- Its labels.
	Labels: { [string]: string },
	--- Where it is known.
	Scope: vnd_bollard_VolumeScope?,
	--- The options its driver was given.
	Options: { [string]: string },
	--- Its size and use, when Docker counted them.
	UsageData: vnd_bollard_VolumeUsage?,
}

export type vnd_bollard_VolumeCreateRequest = {
	Name: string?,
	Driver: string?,
	DriverOpts: { [string]: string }?,
	Labels: { [string]: string }?,
	ClusterVolumeSpec: vnd_bollard_ClusterVolumeSpec?,
}

--- What `list_volumes` returns: Docker's `{ Volumes, Warnings }`.
export type vnd_bollard_VolumeList = {
	--- The volumes.
	Volumes: { vnd_bollard_Volume },
	--- What Docker warns of while listing them.
	Warnings: { string },
}

--- The name of a volume: letters, digits, `_`, `.` and `-`, starting with a letter or digit.
export type vnd_bollard_VolumeName = string

--- Where a volume is known: on its host only, or across a swarm.
--- - `local`: On the host it was made on.
--- - `global`: On every node of the swarm.
export type vnd_bollard_VolumeScope = "local" | "global"

--- How much a volume holds and how many containers use it. Docker only counts them for its disk usage report.
export type vnd_bollard_VolumeUsage = {
	--- The bytes the volume holds; `-1` when Docker did not count them.
	Size: number,
	--- The containers that use the volume; `-1` when Docker did not count them.
	RefCount: number,
}

export type vnd_bollard = {
	--- A client for a Docker daemon. Nothing is sent until the client's first call, so a host nothing answers on
	--- is the `connect` error of that call; a host with no Docker socket at all is the `connect` error of this
	--- one. Reaching Docker is root on its host: a script given this module is trusted with the machine.
	---
	--- ```luau
	--- local docker = assert(bollard.connect())
	--- local remote = assert(bollard.connect({ host = "tcp://10.0.0.5:2375", timeout = 10 }))
	--- local none, err = bollard.connect({ host = "unix:///nowhere/docker.sock" })
	--- assert(none == nil and err ~= nil and err.kind == "connect")
	--- ```
	connect: (opts: vnd_bollard_ConnectOptions?) -> (vnd_bollard_Client?, vnd_bollard_DockerError?),
}

-- ===== vnd:hyper =====

--- What a handler returns: a body (a 200 with it), or a `Reply`.
export type vnd_hyper_Answer = string | vnd_hyper_Reply

--- The kinds of `vnd_hyper_HyperError`.
export type vnd_hyper_HyperErrorKind = "invalid_input" | "invalid_url" | "connect" | "tls" | "timed_out" | "too_many_redirects" | "too_large" | "connection_lost" | "bad_response" | "other"

--- Why a request failed. The kind means the same on every platform; `reason` is this module's or the
--- transport's wording, for a person.
export type vnd_hyper_HyperError =
	--- An option, a header, the method or the body was refused before anything was sent.
	{ kind: "invalid_input", reason: string, message: string, op: string }
	--- The URL (or a redirect's `Location`) is not an `http` or `https` URL with a host.
	| { kind: "invalid_url", reason: string, message: string, op: string }
	--- No connection could be made: the name did not resolve, or the host refused or could not be reached.
	| { kind: "connect", reason: string, message: string, op: string }
	--- The TLS handshake failed, usually over the certificate.
	| { kind: "tls", reason: string, message: string, op: string }
	--- A time limit passed: connecting, no data arriving, or the whole request.
	| { kind: "timed_out", limit: vnd_hyper_TimeLimit, reason: string, message: string, op: string }
	--- More redirects than `max_redirects` allows.
	| { kind: "too_many_redirects", max_redirects: number, message: string, op: string }
	--- The response body is longer than `max_body`.
	| { kind: "too_large", max_body: number, message: string, op: string }
	--- The connection ended or failed after it was made, before the response was complete.
	| { kind: "connection_lost", reason: string, message: string, op: string }
	--- The server answered with something that is not valid HTTP.
	| { kind: "bad_response", reason: string, message: string, op: string }
	--- Anything else, reported and never hidden.
	| { kind: "other", reason: string, message: string, op: string }

--- A handler's answer, when it is more than a body.
export type vnd_hyper_Reply = {
	--- The status code; 200 when not given.
	status: number?,
	--- Headers to send, by name.
	headers: { [string]: string }?,
	--- The body; empty when not given.
	body: string?,
}

--- A request a server's handler is given.
declare extern type vnd_hyper_Request with
	--- The HTTP method (`GET`). Read-only.
	method: string
	--- The request path, without the query string. Read-only.
	path: string
	--- The raw request body. Read-only.
	body: string
	--- Whether the `Content-Type` header is `application/json`. Read-only.
	is_json: boolean
	--- The request headers by name, names in lower case. A header sent more than once is one value joined with
	--- `", "` (`set-cookie` with `"\n"`), and a value that is not UTF-8 has its bad bytes replaced with U+FFFD.
	--- The table is built on every read: a handler that reads several binds it once. Read-only.
	headers: { [string]: string }
	--- The body parsed as JSON: a `lib:json` handle for an object or an array, a Lua value for a string, a
	--- number or a boolean. `nil` when the body is empty, is not JSON, or is `null`. Parsed on every read. Read-only.
	json: lib_json_Node?
	--- A request header by name, in any case; `nil` when the request has none.
	header: (self: vnd_hyper_Request, name: string) -> string?
end

--- What a request sends besides its method, URL and body, and the limits it keeps to.
export type vnd_hyper_RequestOptions = {
	--- Headers to send, by name. A `Content-Length` that is not the body's length is refused, a `Host` replaces
	--- the built-in one, and a name given twice in any case or a `Transfer-Encoding` is refused: the module frames
	--- the body. Default: `{}`.
	headers: { [string]: string }?,
	--- PEM certificates to trust instead of the platform's, on every hop.
	ca_pem: string?,
	--- Seconds the TCP connect and the TLS handshake may take. Default: `10.0`.
	connect_timeout: number?,
	--- Seconds without data moving in either direction; reset whenever any does, so a server that trickles never
	--- trips it. Default: `60.0`.
	idle_timeout: number?,
	--- Seconds the whole request may take, redirects and body included, which is what bounds a trickle. No limit
	--- when not given.
	timeout: number?,
	--- Follow 301, 302, 303, 307 and 308; `false` returns the 3xx. A 303 becomes a GET, a POST becomes a GET on 301
	--- and 302, 307 and 308 keep method and body. A hop to another origin drops `Authorization`, `Cookie`,
	--- `Proxy-Authorization`, `Origin` and a caller-set `Host`, and only those: a credential in a header of your
	--- own (`X-Api-Key`) goes to every hop. Nothing refuses a redirect to a host on the local network or from
	--- `https` to `http`: check the response's `url`, or follow redirects yourself. Default: `true`.
	follow_redirects: boolean?,
	--- The most redirects to follow; one more is a `too_many_redirects` error. Default: `16`.
	max_redirects: number?,
	--- The most bytes of response body to read; a longer one fails with `too_large`. The module never
	--- decompresses, so this bounds the bytes on the wire. Default: `67108864`.
	max_body: number?,
}

--- What a client function hands a script: the last response of the redirect chain, its body read in full. A
--- 4xx or 5xx status is a response, not an error.
export type vnd_hyper_Response = {
	--- The status code.
	status: number,
	--- One value under each lower-case name. A header sent more than once is joined with `", "`, `set-cookie`
	--- with `"\n"` so each cookie can be split back out, and bytes that are not UTF-8 become U+FFFD.
	headers: { [string]: string },
	--- The body, as the bytes that came: never decompressed.
	body: string,
	--- The URL the response came from: the last one of the redirect chain.
	url: string,
}

--- A running server. Copies of the handle are the same server.
declare extern type vnd_hyper_Server with
	--- The local address the server accepts on, as `"127.0.0.1:8080"`.
	addr: (self: vnd_hyper_Server) -> (string?, vnd_hyper_ServerError?)
	--- Ask the server to stop accepting connections; returns at once. `wait()` returns when it has.
	close: (self: vnd_hyper_Server) -> ()
	--- Wait until the server stops accepting connections: `close()` was called, the process was asked to stop
	--- (Ctrl-C), or an embedder shut the script down. The handlers keep running meanwhile. At once when the
	--- server has already stopped.
	---
	--- Yields the calling coroutine while it waits.
	wait: (self: vnd_hyper_Server) -> ()
end

--- The kinds of `vnd_hyper_ServerError`.
export type vnd_hyper_ServerErrorKind = "listener_closed" | "closed" | "other"

--- Why a server could not be started, or has no address to give.
export type vnd_hyper_ServerError =
	--- The listener is closed: its engine shut down, or stopped its background work.
	{ kind: "listener_closed", message: string, op: string }
	--- The server is closed: `close()` was called, or its engine shut down.
	| { kind: "closed", message: string, op: string }
	--- Any other failure.
	| { kind: "other", reason: string, message: string, op: string }

--- Which time limit a `timed_out` request passed: the option that sets it, or the operating system's own.
--- - `connect_timeout`: Connecting (the name lookup, the TCP connect and the TLS handshake) took longer than `connect_timeout`.
--- - `idle_timeout`: No data moved in either direction for `idle_timeout`.
--- - `timeout`: The whole request, redirects and body included, took longer than `timeout`.
--- - `system`: The operating system gave up on the connection by a limit of its own.
export type vnd_hyper_TimeLimit = "connect_timeout" | "idle_timeout" | "timeout" | "system"

export type vnd_hyper = {
	--- Perform an HTTP or HTTPS GET request.
	---
	--- ```luau
	--- local resp, err = hyper.get("http://127.0.0.1:1/", { connect_timeout = 2, headers = { accept = "text/plain" } })
	--- if resp == nil then
	---     assert(err ~= nil and (err.kind == "connect" or err.kind == "timed_out"))
	--- end
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	get: (url: string, opts: vnd_hyper_RequestOptions?) -> (vnd_hyper_Response?, vnd_hyper_HyperError?),
	--- Perform an HTTP or HTTPS POST request with `body`. With no body it says `Content-Length: 0`.
	---
	--- ```luau
	--- local resp, err = hyper.post("http://127.0.0.1:1/items", '{"name":"ada"}', {
	---     headers = { ["content-type"] = "application/json" },
	--- })
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	post: (url: string, body: string?, opts: vnd_hyper_RequestOptions?) -> (vnd_hyper_Response?, vnd_hyper_HyperError?),
	--- Perform an HTTP or HTTPS request with `method`. A standard method in any case is the standard method (`put`
	--- is `PUT`); any other is sent as written. A method that is not a valid method name is `invalid_input`.
	---
	--- ```luau
	--- local resp, err = hyper.request("DELETE", "http://127.0.0.1:1/items/1", nil, { timeout = 5 })
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	request: (method: string, url: string, body: string?, opts: vnd_hyper_RequestOptions?) -> (vnd_hyper_Response?, vnd_hyper_HyperError?),
	--- Start accepting HTTP/1.1 connections on `listener` and call `handler` for every request. The handler
	--- returns a body (a 200 with it), a `Reply`, or nothing (an empty 200); it may wait (call the client, sleep)
	--- and other requests are served meanwhile. A handler that raises, or returns anything else, answers 500
	--- `handler error`, and the server serves on.
	---
	--- ```luau
	--- local net = require("std:net")
	--- local listener = assert(net.TcpListener.bind("127.0.0.1:0"))
	--- local server = assert(hyper.serve(listener, function(req)
	---     if req.method == "GET" and req.path == "/" then
	---         return "hello"
	---     end
	---     return { status = 404, body = "not found" }
	--- end))
	--- local resp = assert(hyper.get("http://" .. assert(server:addr()) .. "/"))
	--- assert(resp.status == 200 and resp.body == "hello")
	--- server:close()
	--- server:wait()
	--- ```
	serve: (listener: std_net_TcpListener, handler: (req: vnd_hyper_Request) -> vnd_hyper_Answer?) -> (vnd_hyper_Server?, vnd_hyper_ServerError?),
}

-- ===== vnd:jsonschema =====

--- The kinds of `vnd_jsonschema_CompileError`.
export type vnd_jsonschema_CompileErrorKind = "syntax" | "invalid_schema"

--- Why a text is not a schema.
export type vnd_jsonschema_CompileError =
	--- The text is not JSON.
	{ kind: "syntax", line: number, column: number, reason: string, message: string, op: string }
	--- The text is JSON, but not a JSON Schema: a keyword holds the wrong thing, a pattern is not a regular
	--- expression, a reference leads nowhere.
	| { kind: "invalid_schema", path: string, reason: string, message: string, op: string }

--- A compiled schema. Compile it once and keep it: checking a value against it is the fast part.
declare extern type vnd_jsonschema_Schema with
	--- Whether `value` conforms. Stops at the first violation and builds nothing: the gate for a handler.
	---
	--- ```luau
	--- local schema = assert(jsonschema.compile('{"type":"integer","minimum":0}'))
	--- assert(schema:is_valid(5) and not schema:is_valid(-1) and not schema:is_valid("5"))
	--- ```
	is_valid: (self: vnd_jsonschema_Schema, value: lib_json_Input) -> boolean
	--- Check `value` against the whole schema: `true`, or everything that is wrong with it.
	---
	--- ```luau
	--- local schema = assert(jsonschema.compile('{"type":"object","required":["name"]}'))
	--- assert(schema:validate({ name = "ada" }))
	--- local ok, err = schema:validate({ nickname = "ada" })
	--- assert(ok == nil and err ~= nil and err.violations[1].keyword == "required")
	--- ```
	validate: (self: vnd_jsonschema_Schema, value: lib_json_Input) -> (boolean?, vnd_jsonschema_ValidationError?)
end

--- The kinds of `vnd_jsonschema_ValidationError`.
export type vnd_jsonschema_ValidationErrorKind = "invalid"

--- Why a value does not conform to a schema.
export type vnd_jsonschema_ValidationError =
	--- The value breaks at least one rule of the schema.
	{ kind: "invalid", violations: { vnd_jsonschema_Violation }, message: string, op: string }

--- One thing wrong with a value.
export type vnd_jsonschema_Violation = {
	--- Where in the value, as a JSON pointer (`/users/0/name`); empty for the value as a whole.
	instance_path: string,
	--- The rule of the schema that was broken, as a JSON pointer (`/properties/users/items/required`).
	schema_path: string,
	--- The keyword of that rule (`required`, `type`, `maxLength`).
	keyword: string,
	--- What is wrong, for a person.
	reason: string,
}

export type vnd_jsonschema = {
	--- Compile a JSON Schema from its JSON text. The draft is the one its `$schema` names (2020-12 when it names
	--- none).
	---
	--- ```luau
	--- local schema = assert(jsonschema.compile('{"type":"string","maxLength":3}'))
	--- assert(schema:is_valid("abc") and not schema:is_valid("abcd"))
	--- local _, err = jsonschema.compile('{"type":"nonsense"}')
	--- assert(err ~= nil and err.kind == "invalid_schema" and err.path == "/type")
	--- ```
	compile: (schema: string) -> (vnd_jsonschema_Schema?, vnd_jsonschema_CompileError?),
}

-- ===== vnd:keyring =====

--- A credential's name in a store (or, from `search`, one credential of it).
declare extern type vnd_keyring_Entry with
	--- The credential's secret as text, or `(nil, nil)` when the store has no such credential. A secret that
	--- is not UTF-8 is `bad_encoding` (read it with `get_secret`). The platform may ask the person first, and
	--- the call waits for them.
	---
	--- Yields the calling coroutine while it waits.
	get_password: (self: vnd_keyring_Entry) -> (string?, vnd_keyring_Error?)
	--- Store text as the credential's secret: the credential is made, or its secret replaced.
	---
	--- Yields the calling coroutine while it waits.
	set_password: (self: vnd_keyring_Entry, password: string) -> (boolean?, vnd_keyring_Error?)
	--- The credential's secret as the bytes the store holds (a string of bytes), or `(nil, nil)` when the
	--- store has no such credential.
	---
	--- Yields the calling coroutine while it waits.
	get_secret: (self: vnd_keyring_Entry) -> (string?, vnd_keyring_Error?)
	--- Store bytes (a string of bytes) as the credential's secret: the credential is made, or its secret
	--- replaced.
	---
	--- Yields the calling coroutine while it waits.
	set_secret: (self: vnd_keyring_Entry, secret: string) -> (boolean?, vnd_keyring_Error?)
	--- Delete the credential from the store: `true`, or `false` when the store had no such credential.
	---
	--- Yields the calling coroutine while it waits.
	delete_credential: (self: vnd_keyring_Entry) -> (boolean?, vnd_keyring_Error?)
	--- The service and the user this entry was made from, or `nil, nil` for an entry from `search` whose
	--- store does not say.
	get_specifiers: (self: vnd_keyring_Entry) -> (string?, string?)
end

--- The kinds of `vnd_keyring_Error`.
export type vnd_keyring_ErrorKind = "invalid_input" | "no_store" | "no_access" | "not_found" | "ambiguous" | "bad_encoding" | "bad_data" | "unsupported" | "platform" | "other"

--- Why a call on the credential store failed. No field holds a secret.
export type vnd_keyring_Error =
	--- The store refused an argument: a service or user it does not accept, a value longer than it keeps.
	{ kind: "invalid_input", reason: string, message: string, op: string }
	--- This machine has no credential store that can be used: the platform has none, or it could not be
	--- opened (a Linux machine with no Secret Service running, say).
	| { kind: "no_store", reason: string, message: string, op: string }
	--- The store is there and would not give access: it is locked, or the person refused.
	| { kind: "no_access", reason: string, message: string, op: string }
	--- The credential an entry stands for is gone. Only an entry that `search` returned says this (it is one
	--- credential): for an entry made from a service and a user, "no credential" is an answer, not an error.
	| { kind: "not_found", message: string, op: string }
	--- More than one credential in the store matches the entry's service and user.
	| { kind: "ambiguous", matches: number, message: string, op: string }
	--- The credential's secret is not UTF-8 text: read it with `get_secret`.
	| { kind: "bad_encoding", message: string, op: string }
	--- What the store holds could not be read: the secret, or the store itself, is not in the store's format.
	| { kind: "bad_data", reason: string, message: string, op: string }
	--- The store does not do what was asked (`search`, on a store that has none).
	| { kind: "unsupported", reason: string, message: string, op: string }
	--- The platform's store failed.
	| { kind: "platform", reason: string, message: string, op: string }
	--- Anything else, reported and never hidden.
	| { kind: "other", reason: string, message: string, op: string }

--- A credential store: the platform's, or a mock.
declare extern type vnd_keyring_Store with
	--- The entry for a service and a user in this store. Nothing is read or written: the credential need not
	--- exist. What a store accepts as a service or a user is its own (`invalid_input`).
	---
	--- Yields the calling coroutine while it waits.
	entry: (self: vnd_keyring_Store, service: string, user: string) -> (vnd_keyring_Entry?, vnd_keyring_Error?)
	--- The entries of the credentials that match `spec`, whose keys are the store's own: macOS takes
	--- `service` and `user` (exact, and every generic password of the login keychain without them), the
	--- Secret Service takes any attribute (`service`, `username`, ...), a mock store matches `service` and
	--- `user` as substrings. A store with no search (the Windows Credential Manager) is `unsupported`. On the
	--- Secret Service a search may ask the person to unlock.
	---
	--- Yields the calling coroutine while it waits.
	search: (self: vnd_keyring_Store, spec: { [string]: string }?) -> ({ vnd_keyring_Entry }?, vnd_keyring_Error?)
end

export type vnd_keyring = {
	--- The operating system's credential store: Keychain Services on macOS (the login keychain), the Credential
	--- Manager on Windows, the Secret Service on Linux and the other Unixes. A machine that has none, or whose
	--- store cannot be opened, is `no_store`. With `NEOC_KEYRING=mock` in the environment it is a mock store
	--- instead, one for the whole process (see `mock`); any other value of it is `invalid_input`. A script given
	--- this module is trusted with the secrets of the user it runs as.
	---
	--- Yields the calling coroutine while it waits.
	store: () -> (vnd_keyring_Store?, vnd_keyring_Error?),
	--- A new mock store, for tests: in memory, its own, and gone with the process. It takes any service and
	--- user, and `search` matches `service` and `user` as substrings.
	---
	--- ```luau
	--- local entry = assert(keyring.mock():entry("example.com", "ada"))
	--- assert(entry:set_password("secret"))
	--- assert(entry:get_password() == "secret")
	--- assert(entry:delete_credential() == true)
	--- assert(entry:get_password() == nil)
	--- ```
	---
	--- Raises `vnd_keyring_Error` when it fails; `pcall` catches it.
	mock: () -> vnd_keyring_Store,
}

-- ===== vnd:portable_pty =====

--- How a process ended.
export type vnd_portable_pty_ExitStatus = {
	--- The code it ended with: 0 to 255 on Unix, and 1 when a signal ended it.
	exit_code: number,
	--- The operating system's words for the signal that ended it, which differ between systems; none when it
	--- ended by itself, and always on Windows.
	signal: string?,
	--- It ended by itself with code 0.
	success: boolean,
}

--- A terminal and the process on it: what `spawn_command` returns. Copies of the handle are the same terminal;
--- it is closed when the last one is collected.
declare extern type vnd_portable_pty_Pty with
	--- Wait for output and return it: the bytes the process wrote, at most `max` of them (from 1 to 65536, the
	--- default), as soon as there are any. The bytes are what a terminal receives: text in the process's
	--- encoding with its escape sequences, and a read may end in the middle of a character.
	---
	--- `nil` without an error is the end of the output: every process that had the terminal open is gone (on
	--- Windows: the process `spawn_command` started is), or the terminal was closed. An error is a failure:
	--- `io` when reading failed (the read after it is the end), `invalid_input` for a `max` out of range. At
	--- most 256 KiB of output wait to be read: a process that writes more waits in its write until the script
	--- reads. A read that is abandoned takes nothing.
	---
	--- ```luau
	--- local function output(pty)
	---     local seen = ""
	---     while true do
	---         local bytes, err = pty:read()
	---         assert(err == nil, tostring(err))
	---         if bytes == nil then
	---             return seen
	---         end
	---         seen ..= bytes
	---     end
	--- end
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	read: (self: vnd_portable_pty_Pty, max: number?) -> (string?, vnd_portable_pty_PtyError?)
	--- Send bytes to the process as its input, as if typed: `true` once the terminal has taken them all. A
	--- line ends with `\r` or `\n` as the program on the terminal expects (a shell takes either; on Windows it
	--- is `\r`). At most 1 MiB a call (`invalid_input` past that). Writes are made one after the other, and a
	--- process that does not read its input makes the write wait.
	---
	--- `closed` after `close()`, also for a write that was waiting; `io` when the terminal refuses the bytes
	--- (every process on it is gone).
	---
	--- Yields the calling coroutine while it waits.
	write: (self: vnd_portable_pty_Pty, data: string) -> (boolean?, vnd_portable_pty_PtyError?)
	--- Tell the terminal its new size, each from 1 to 32767 (`invalid_input` otherwise): `true`. The process
	--- in the foreground is told by the operating system (`SIGWINCH` on Unix). `closed` after `close()`, and
	--- on Windows once the process has ended.
	resize: (self: vnd_portable_pty_Pty, rows: number, cols: number) -> (boolean?, vnd_portable_pty_PtyError?)
	--- The id of the process `spawn_command` started, while it runs. `nil` once it has ended or the terminal
	--- is closed: the number is then the operating system's to give to another process.
	process_id: (self: vnd_portable_pty_Pty) -> number?
	--- Wait for the process to end and return how it ended. It may be called again, and after `close()`: the
	--- answer is the same. On Unix the output can outlive the process (a child of it still writes): read to
	--- the end for all of it. `io` when the operating system does not say how the process ended.
	---
	--- Yields the calling coroutine while it waits.
	wait: (self: vnd_portable_pty_Pty) -> (vnd_portable_pty_ExitStatus?, vnd_portable_pty_PtyError?)
	--- End the process: on Unix it is sent a hangup (`SIGHUP`, what a terminal that goes away sends) and, if
	--- it still runs a quarter of a second later, the kill it cannot refuse (`SIGKILL`); on Windows it is
	--- terminated. It returns at once: `wait()` says when the process is gone. A process that has ended is
	--- left alone. The process's own children are not signalled here: the operating system hangs up those in
	--- the terminal's foreground when the process ends.
	kill: (self: vnd_portable_pty_Pty) -> ()
	--- End the process as `kill()` does and let go of the terminal: output not yet read is dropped, every
	--- `read`, waiting or later, returns `nil`, and `write` and `resize` fail with `closed`. `wait()` still
	--- says how the process ended. Closing again does nothing. A terminal is also closed when its handle is
	--- collected, and when the engine shuts down.
	close: (self: vnd_portable_pty_Pty) -> ()
end

--- The kinds of `vnd_portable_pty_PtyError`.
export type vnd_portable_pty_PtyErrorKind = "invalid_input" | "spawn" | "closed" | "io" | "other"

--- Why a call of this module failed. The kind is stable; `reason` is the crate's or the operating system's
--- wording, for a log, and may change.
export type vnd_portable_pty_PtyError =
	--- An option or an argument was refused before anything was started or sent.
	{ kind: "invalid_input", reason: string, message: string, op: string }
	--- The command could not be started: there is no such program, it is not executable, `cwd` is not a
	--- directory, or the operating system refused the terminal or the process.
	| { kind: "spawn", reason: string, message: string, op: string }
	--- The terminal was closed (by `close`, or with the engine).
	| { kind: "closed", message: string, op: string }
	--- Reading from the terminal or writing to it failed, or the operating system did not say how the process
	--- ended.
	| { kind: "io", reason: string, message: string, op: string }
	--- Anything else, reported and never hidden.
	| { kind: "other", reason: string, message: string, op: string }

--- What `spawn_command` starts, and the size of the terminal it starts it on.
export type vnd_portable_pty_Spawn = {
	--- The program: a path, or a name looked up in `PATH`. Without it the user's default shell is started,
	--- as a login shell: `$SHELL`, else the one of the password database, else `/bin/sh`; on Windows
	--- `%ComSpec%`.
	program: string?,
	--- The program's arguments, at most 1024. They need `program`: the default shell takes none.
	args: { string }?,
	--- The directory the command starts in; the user's home directory when not given (not the engine's working
	--- directory).
	cwd: string?,
	--- Variables added to the environment the engine's process has, replacing one of the same name; nothing is
	--- taken away. At most 1024. `TERM` is whatever that environment says unless it is set here
	--- (`xterm-256color` for a terminal that draws like xterm).
	env: { [string]: string }?,
	--- The rows of the terminal, from 1 to 32767; 24 when not given.
	rows: number?,
	--- The columns of the terminal, from 1 to 32767; 80 when not given.
	cols: number?,
}

export type vnd_portable_pty = {
	--- Open a pseudo-terminal and start a command on it: a `Pty`. Without options it is the user's default shell
	--- in their home directory, on a terminal of 24 rows by 80 columns.
	---
	--- The process runs as the engine's user and can do what that user can: a script given this module is trusted
	--- with the machine.
	---
	--- Errors: `invalid_input` for a command the operating system would not take (an empty program, a NUL byte,
	--- more than 1024 arguments or variables, `args` without `program`) and for a size of 0 or past 32767; `spawn`
	--- when the command could not be started (no such program, not executable, `cwd` is not a directory, or the
	--- system refused the terminal or the process).
	---
	--- The terminal is closed, and the process ended, by `close()`, when the handle is collected, and when the
	--- engine shuts down. A terminal opened after the engine has shut down is closed already.
	---
	--- On Windows nothing runs on the terminal before its first output, the question `"\27[6n"` (where is the
	--- cursor?), is answered: write `"\27[1;1R"`, or pass the output to a terminal emulator, which answers.
	---
	--- ```luau
	--- local pty, err = portable_pty.spawn_command({ program = "/nowhere/neoc-no-such-program" })
	--- assert(pty == nil and err ~= nil and err.kind == "spawn")
	--- ```
	---
	--- Yields the calling coroutine while it waits.
	spawn_command: (opts: vnd_portable_pty_Spawn?) -> (vnd_portable_pty_Pty?, vnd_portable_pty_PtyError?),
}

-- ===== vnd:quick_xml =====

--- The kinds of `vnd_quick_xml_DecodeError`.
export type vnd_quick_xml_DecodeErrorKind = "syntax" | "unexpected_eof" | "too_deep" | "invalid_utf8" | "unsupported"

--- Why a text is not an XML document this module reads.
export type vnd_quick_xml_DecodeError =
	--- The text is not well-formed XML: a tag that is not closed, an end tag that does not match, an entity that
	--- is not known.
	{ kind: "syntax", reason: string, message: string, op: string }
	--- The text ends before any element or text.
	| { kind: "unexpected_eof", message: string, op: string }
	--- The elements nest deeper than the parser reads.
	| { kind: "too_deep", max_depth: number, message: string, op: string }
	--- The text is not UTF-8.
	| { kind: "invalid_utf8", offset: number, message: string, op: string }
	--- The text is XML, but holds what plain data cannot.
	| { kind: "unsupported", reason: string, message: string, op: string }

--- The kinds of `vnd_quick_xml_EncodeError`.
export type vnd_quick_xml_EncodeErrorKind = "unsupported"

--- Why a value cannot be written as XML.
export type vnd_quick_xml_EncodeError =
	--- The value holds something XML has no form for: a key (or the root) that is not an XML name, say.
	{ kind: "unsupported", reason: string, message: string, op: string }

--- How `encode` writes a document.
export type vnd_quick_xml_EncodeOptions = {
	--- The root element's name. Default: `"root"`.
	root: string?,
}

--- The kinds of `vnd_quick_xml_ReadError`.
export type vnd_quick_xml_ReadErrorKind = "io" | "syntax" | "unexpected_eof" | "too_deep" | "invalid_utf8" | "unsupported"

--- Why a reader does not give an XML document this module reads.
export type vnd_quick_xml_ReadError =
	--- The reader failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The text is not well-formed XML: a tag that is not closed, an end tag that does not match, an entity that
	--- is not known.
	| { kind: "syntax", reason: string, message: string, op: string }
	--- The text ends before any element or text.
	| { kind: "unexpected_eof", message: string, op: string }
	--- The elements nest deeper than the parser reads.
	| { kind: "too_deep", max_depth: number, message: string, op: string }
	--- The text is not UTF-8.
	| { kind: "invalid_utf8", offset: number, message: string, op: string }
	--- The text is XML, but holds what plain data cannot.
	| { kind: "unsupported", reason: string, message: string, op: string }

--- The kinds of `vnd_quick_xml_WriteError`.
export type vnd_quick_xml_WriteErrorKind = "io" | "unsupported"

--- Why a value was not written to a writer as XML.
export type vnd_quick_xml_WriteError =
	--- The writer failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The value holds something XML has no form for: a key (or the root) that is not an XML name, say.
	| { kind: "unsupported", reason: string, message: string, op: string }

export type vnd_quick_xml = {
	--- Read `reader` to its end and parse what it gave as an XML document, as `decode_string` does.
	---
	--- ```luau
	--- local io = require("std:io")
	--- local doc = assert(quick_xml.decode(io.from_string("<user><name>ada</name></user>"))) :: { name: string }
	--- assert(doc.name == "ada")
	--- ```
	decode: (reader: std_io_Reader) -> (any, vnd_quick_xml_ReadError?),
	--- Parse an XML document as plain data: what its root element holds (a table, or the text of a root that holds
	--- only text).
	---
	--- ```luau
	--- local doc = assert(quick_xml.decode_string('<user id="7"><name>ada</name><tag>a</tag><tag>b</tag></user>'))
	--- local user = doc :: { ["@id"]: string, name: string, tag: { string } } -- this script's own knowledge
	--- assert(user["@id"] == "7" and user.name == "ada" and user.tag[2] == "b")
	--- local _, err = quick_xml.decode_string("<unclosed")
	--- assert(err ~= nil and err.kind == "syntax")
	--- ```
	decode_string: (text: string) -> (any, vnd_quick_xml_DecodeError?),
	--- Write a document (a table with string keys) as XML under one root element. A key is a child element, a key
	--- that starts with `@` an attribute, `$text` the element's own text; a list writes its element once per item.
	---
	--- ```luau
	--- local user = { ["@id"] = "7", name = "ada", tag = { "a", "b" } }
	--- assert(quick_xml.encode(user, { root = "user" }) == '<user id="7"><name>ada</name><tag>a</tag><tag>b</tag></user>')
	--- assert(quick_xml.encode({ name = "ada" }) == "<root><name>ada</name></root>")
	--- ```
	encode: (value: { [string]: any }, options: vnd_quick_xml_EncodeOptions?) -> (string?, vnd_quick_xml_EncodeError?),
	--- Write a document to `writer` as XML, as `encode` writes it. Nothing is written when the document cannot be
	--- encoded.
	encode_to: (value: { [string]: any }, writer: std_io_Writer, options: vnd_quick_xml_EncodeOptions?) -> (boolean?, vnd_quick_xml_WriteError?),
}

-- ===== vnd:rusqlite =====

--- A value of a row. INTEGER and REAL are numbers, TEXT and BLOB are strings.
export type vnd_rusqlite_Cell = number | string

--- An open SQLite database: one connection.
declare extern type vnd_rusqlite_Database with
	--- Run one statement; how many rows it changed (0 for a statement that changes none, such as
	--- `CREATE TABLE`).
	execute: (self: vnd_rusqlite_Database, sql: string, ...vnd_rusqlite_Param?) -> (number?, vnd_rusqlite_Error?)
	--- Run one SELECT; every row, in order.
	query: (self: vnd_rusqlite_Database, sql: string, ...vnd_rusqlite_Param?) -> ({ { [string]: vnd_rusqlite_Cell } }?, vnd_rusqlite_Error?)
	--- Run one SELECT; its first row, or `nil` when it has none.
	query_one: (self: vnd_rusqlite_Database, sql: string, ...vnd_rusqlite_Param?) -> ({ [string]: vnd_rusqlite_Cell }?, vnd_rusqlite_Error?)
	--- A statement to run many times on this database's connection. The SQL is not checked here: a mistake
	--- in it is the error of the statement's first call.
	---
	--- ```luau
	--- local db = assert(rusqlite.open(":memory:"))
	--- assert(db:execute("CREATE TABLE t (v TEXT)"))
	--- local insert = db:prepare("INSERT INTO t (v) VALUES (?)")
	--- assert(insert:execute("a") == 1)
	--- assert(insert:execute("b") == 1)
	--- ```
	prepare: (self: vnd_rusqlite_Database, sql: string) -> vnd_rusqlite_Statement
	--- Close the connection. Later calls on this database and on its statements fail with `closed`; closing
	--- again does nothing.
	close: (self: vnd_rusqlite_Database) -> ()
end

--- The kinds of `vnd_rusqlite_Error`.
export type vnd_rusqlite_ErrorKind = "closed" | "multiple_statements" | "empty_sql" | "parameter_count" | "constraint" | "busy" | "sql" | "other"

--- Why a statement failed.
export type vnd_rusqlite_Error =
	--- `close` was called on this database.
	{ kind: "closed", message: string, op: string }
	--- The SQL holds more than one statement. Nothing was run.
	| { kind: "multiple_statements", message: string, op: string }
	--- The SQL is empty or only a comment.
	| { kind: "empty_sql", message: string, op: string }
	--- The call gave more or fewer values than the statement has placeholders. Nothing was run.
	| { kind: "parameter_count", given: number, expected: number, message: string, op: string }
	--- A constraint refused the change: UNIQUE, NOT NULL, CHECK, FOREIGN KEY, PRIMARY KEY.
	| { kind: "constraint", reason: string, code: number, message: string, op: string }
	--- The database or a table is locked by another connection.
	| { kind: "busy", reason: string, message: string, op: string }
	--- SQLite refused the statement: a syntax error, a missing table, a full disk.
	| { kind: "sql", reason: string, code: number, message: string, op: string }
	--- Anything else: `execute` given a statement that returns rows, a value SQLite cannot hold.
	| { kind: "other", reason: string, message: string, op: string }

--- The kinds of `vnd_rusqlite_OpenError`.
export type vnd_rusqlite_OpenErrorKind = "cannot_open"

--- Why a database could not be opened.
export type vnd_rusqlite_OpenError =
	--- The file cannot be opened or created, or is not a database path SQLite accepts.
	{ kind: "cannot_open", path: string, reason: string, message: string, op: string }

--- A value bound to a placeholder. A boolean binds as 0 or 1, a whole number as INTEGER, any other number as
--- REAL, a string as TEXT when it is UTF-8 and as BLOB otherwise.
export type vnd_rusqlite_Param = boolean | number | string

--- SQL kept for many calls, made by `db:prepare(sql)`. It runs on the database's connection.
declare extern type vnd_rusqlite_Statement with
	--- Run the statement; how many rows it changed.
	execute: (self: vnd_rusqlite_Statement, ...vnd_rusqlite_Param?) -> (number?, vnd_rusqlite_Error?)
	--- Run the SELECT; every row, in order.
	query: (self: vnd_rusqlite_Statement, ...vnd_rusqlite_Param?) -> ({ { [string]: vnd_rusqlite_Cell } }?, vnd_rusqlite_Error?)
	--- Run the SELECT; its first row, or `nil` when it has none.
	query_one: (self: vnd_rusqlite_Statement, ...vnd_rusqlite_Param?) -> ({ [string]: vnd_rusqlite_Cell }?, vnd_rusqlite_Error?)
end

export type vnd_rusqlite = {
	--- Open a SQLite database file, creating it when it does not exist. `":memory:"` is a database in memory,
	--- gone when it is closed; a `file:` URI is read as one.
	---
	--- ```luau
	--- local db = assert(rusqlite.open(":memory:"))
	--- assert(db:execute("CREATE TABLE t (id INTEGER PRIMARY KEY, v TEXT)"))
	--- assert(db:execute("INSERT INTO t (v) VALUES (?)", "hello") == 1)
	--- local row = assert(db:query_one("SELECT id, v FROM t WHERE v = ?", "hello"))
	--- assert(row.id == 1 and row.v == "hello")
	--- db:close()
	--- ```
	open: (path: string) -> (vnd_rusqlite_Database?, vnd_rusqlite_OpenError?),
}

-- ===== vnd:serde_json =====

--- The kinds of `vnd_serde_json_DecodeError`.
export type vnd_serde_json_DecodeErrorKind = "syntax" | "eof"

--- Why a text is not JSON.
export type vnd_serde_json_DecodeError =
	--- The text breaks JSON's grammar, is not UTF-8, or nests deeper than the parser reads.
	{ kind: "syntax", line: number, column: number, reason: string, message: string, op: string }
	--- The text ends before the document does (an empty text, an unclosed string, array or object).
	| { kind: "eof", line: number, column: number, reason: string, message: string, op: string }

--- The kinds of `vnd_serde_json_EncodeError`.
export type vnd_serde_json_EncodeErrorKind = "too_deep"

--- Why a value cannot be written as JSON.
export type vnd_serde_json_EncodeError =
	--- The value nests deeper than `from_str` reads back.
	{ kind: "too_deep", max_depth: number, message: string, op: string }

--- The kinds of `vnd_serde_json_ReadError`.
export type vnd_serde_json_ReadErrorKind = "io" | "syntax" | "eof"

--- Why a reader does not give a JSON document.
export type vnd_serde_json_ReadError =
	--- The reader failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The text breaks JSON's grammar, is not UTF-8, or nests deeper than the parser reads.
	| { kind: "syntax", line: number, column: number, reason: string, message: string, op: string }
	--- The text ends before the document does (an empty text, an unclosed string, array or object).
	| { kind: "eof", line: number, column: number, reason: string, message: string, op: string }

--- The kinds of `vnd_serde_json_WriteError`.
export type vnd_serde_json_WriteErrorKind = "io" | "too_deep"

--- Why a value was not written to a writer as JSON.
export type vnd_serde_json_WriteError =
	--- The writer failed.
	{ kind: "io", reason: string, message: string, op: string }
	--- The value nests deeper than `from_str` reads back.
	| { kind: "too_deep", max_depth: number, message: string, op: string }

export type vnd_serde_json = {
	--- Read `reader` to its end and parse what it gave as a JSON text, as `from_str` does.
	---
	--- ```luau
	--- local io = require("std:io")
	--- local body = assert(serde_json.from_reader(io.from_string('{"name":"ada"}'))) :: lib_json_Object
	--- assert(body:get("name") == "ada")
	--- ```
	from_reader: (reader: std_io_Reader) -> (lib_json_Node?, vnd_serde_json_ReadError?),
	--- Parse a JSON text. An object or an array comes back as a `lib:json` handle, a string, number or boolean as a
	--- Lua value, and `null` as `nil` (with no error).
	---
	--- ```luau
	--- local body = assert(serde_json.from_str('{"name":"ada","tags":["a","b"]}')) :: lib_json_Object
	--- assert(body:get("name") == "ada" and body:at({ "tags", 2 }) == "b")
	--- local _, err = serde_json.from_str("{bad}")
	--- assert(err ~= nil and err.kind == "syntax" and err.line == 1)
	--- ```
	from_str: (text: string) -> (lib_json_Node?, vnd_serde_json_DecodeError?),
	--- Write a value as compact JSON: plain data (a table without holes is an array, any other table an object,
	--- `nil` is `null`) or a `lib:json` handle. A number that is not finite is written `null`.
	---
	--- ```luau
	--- assert(serde_json.to_string({ name = "ada", tags = { "a", "b" } }) == '{"name":"ada","tags":["a","b"]}')
	--- ```
	to_string: (value: lib_json_Input) -> (string?, vnd_serde_json_EncodeError?),
	--- Write a value as JSON over several lines, indented by two spaces.
	to_string_pretty: (value: lib_json_Input) -> (string?, vnd_serde_json_EncodeError?),
	--- Write a value to `writer` as compact JSON, as `to_string` writes it. Nothing is written when the value
	--- cannot be encoded.
	to_writer: (value: lib_json_Input, writer: std_io_Writer) -> (boolean?, vnd_serde_json_WriteError?),
}

