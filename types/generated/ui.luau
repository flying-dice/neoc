-- Maps a Luau list to children. `nil` results are skipped.
function ui.each<T>(list: { T }, body: (T, number) -> Node?): { Node }
	local out: { Node } = {}
	for index, item in list do
		local node = body(item, index)
		if node ~= nil then
			table.insert(out, node)
		end
	end
	return out
end

-- Expressions: the closed function set, evaluated on the client. `and`, `or` and `not` are Luau keywords.
-- Boolean negation.
function ui.negate(a: any): Fn
	return call("not", a)
end

-- True when every argument is truthy.
function ui.all(first: any, ...: any): Fn
	return call("and", first, ...)
end

-- True when any argument is truthy.
function ui.any(first: any, ...: any): Fn
	return call("or", first, ...)
end

-- Strict equality.
function ui.eq(a: any, b: any): Fn
	return call("eq", a, b)
end

-- Strict inequality.
function ui.ne(a: any, b: any): Fn
	return call("ne", a, b)
end

-- Less than.
function ui.lt(a: any, b: any): Fn
	return call("lt", a, b)
end

-- Greater than.
function ui.gt(a: any, b: any): Fn
	return call("gt", a, b)
end

-- Number addition.
function ui.add(a: any, b: any): Fn
	return call("add", a, b)
end

-- Number subtraction.
function ui.sub(a: any, b: any): Fn
	return call("sub", a, b)
end

-- `if(cond, then, else)`.
function ui.when(a: any, b: any, c: any): Fn
	return call("if", a, b, c)
end

-- The first argument that is not null or empty.
function ui.coalesce(first: any, ...: any): Fn
	return call("coalesce", first, ...)
end

-- Concatenate the arguments as text.
function ui.concat(first: any, ...: any): Fn
	return call("concat", first, ...)
end

-- Length of a string or list.
function ui.len(a: any): Fn
	return call("len", a)
end

-- True for null, an empty string or an empty list.
function ui.isEmpty(a: any): Fn
	return call("isEmpty", a)
