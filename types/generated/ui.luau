-- Formatting in the viewer's locale and time zone.
local fmt = {}
ui.fmt = fmt

-- Format a number in the viewer's locale.
function fmt.number(a: any, b: any?): Fn
	return call("fmt.number", a, b)
end

-- Format money in the viewer's locale.
function fmt.currency(a: any, b: any?, c: any?): Fn
	return call("fmt.currency", a, b, c)
end

-- Format a ratio as a percentage.
function fmt.percent(a: any, b: any?): Fn
	return call("fmt.percent", a, b)
end

-- Format a byte count (KB, MB, ...).
function fmt.bytes(a: any, b: any?): Fn
	return call("fmt.bytes", a, b)
end

-- Format a date or instant in the viewer's locale and time zone.
function fmt.date(a: any, b: any?): Fn
	return call("fmt.date", a, b)
end

-- Format a time of day.
function fmt.time(a: any, b: any?): Fn
	return call("fmt.time", a, b)
end

-- Format a date and time.
function fmt.dateTime(a: any, b: any?): Fn
	return call("fmt.dateTime", a, b)
end

-- Relative time ("2 minutes ago"), ticking from `env.now`.
function fmt.relative(a: any, b: any?): Fn
	return call("fmt.relative", a, b)
end

-- Pick a plural form: `fmt.plural(n, {one, other})`.
function fmt.plural(a: any, b: any): Fn
	return call("fmt.plural", a, b)
end

-- Join a list ("a, b and c").
function fmt.list(a: any, b: any?): Fn
	return call("fmt.list", a, b)
end

-- Client actions: run on the client with no round trip. Handlers take one, or a list mixing actions and functions.
local act = {}
ui.act = act

-- Write a client-managed or app-state ref.
function act.set(target: Ref<any>, value: any): Action
	return { ["do"] = "set", ref = refPath(target), value = value }
end

-- Flip a boolean ref.
function act.toggle(target: Ref<any>): Action
	return { ["do"] = "toggle", ref = refPath(target) }
end

-- Push a route (`{ name = "note", id = 7 }`) onto a navigation stack.
function act.push(route: { name: string, [string]: any }, stack: string?): Action
	return { ["do"] = "nav.push", stack = stack, route = route }
end

-- Pop the top route.
function act.pop(): Action
	return { ["do"] = "nav.pop" }
end

-- Pop to the root screen.
function act.popToRoot(): Action
	return { ["do"] = "nav.popToRoot" }
end

-- Move focus to the node with this key.
function act.focus(key: string): Action
	return { ["do"] = "focus", key = key }
end

-- Scroll to the node with this key.
function act.scrollTo(key: string): Action
	return { ["do"] = "scrollTo", key = key }
end

-- Copy text to the clipboard.
function act.copy(text: Expr<string>): Action
	return { ["do"] = "copy", text = text }
end

-- Report an event to the app (the handler of the node still runs on the host).
function act.emit(event: string?, payload: { [string]: any }?): Action
	return { ["do"] = "emit", event = event, payload = payload }
end

-- Run actions in order.
function act.seq(actions: { Action }): Action
	return { ["do"] = "seq", actions = actions }
end

return ui
