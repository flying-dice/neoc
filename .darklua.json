{
  "generator": "retain_lines",
  "bundle": {
    "require_mode": "path",
    "excludes": [
      "@agentos/*"
    ]
  },
  "rules": [
    "remove_comments",
    "remove_types",
    "remove_attribute",
    "remove_interpolated_string",
    "remove_compound_assignment",
    "remove_if_expression",
    "remove_floor_division",
    "remove_continue",
    "convert_luau_number"
  ]
}
