local _t       = require("lib:test")
local describe = _t.describe
local test     = _t.test
local expect   = _t.expect

local sqlx_postgres = require("vnd:sqlx_postgres")
local testcontainers_modules = require("vnd:testcontainers_modules")


local container = testcontainers_modules.postgres()
local POSTGRES_URL = container:url()

describe("sqlx_postgres", function()

    -- open ---------------------------------------------------------------------

    describe("open", function()
        test("returns a database handle for a valid URL", function()
            local db, err = sqlx_postgres.open(POSTGRES_URL)
            expect(err).toBeNil()
            expect(db).toBeTruthy()
            db:close()
        end)

        test("malformed URL returns error", function()
            local db, err = sqlx_postgres.open("not-a-url")
            expect(db).toBeNil()
            expect(err).toContain("sqlx_postgres.open:")
        end)
    end)

    -- execute ------------------------------------------------------------------

    describe("execute", function()
        test("CREATE/DROP returns rows_affected = 0", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS exec_create")
            local n, err = db:execute("CREATE TABLE exec_create (id INT PRIMARY KEY)")
            expect(err).toBeNil()
            expect(n).toBe(0)
            db:close()
        end)

        test("INSERT returns rows_affected", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS exec_insert")
            db:execute("CREATE TABLE exec_insert (id INT PRIMARY KEY, v TEXT)")
            local n, err = db:execute("INSERT INTO exec_insert (id, v) VALUES ($1, $2)", 1, "alice")
            expect(err).toBeNil()
            expect(n).toBe(1)
            db:close()
        end)

        test("UPDATE returns affected rows", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS exec_update")
            db:execute("CREATE TABLE exec_update (id INT PRIMARY KEY, v TEXT)")
            db:execute("INSERT INTO exec_update VALUES (1, 'a'), (2, 'b'), (3, 'a')")
            local n = db:execute("UPDATE exec_update SET v = $1 WHERE v = $2", "x", "a")
            expect(n).toBe(2)
            db:close()
        end)

        test("invalid SQL returns error", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            local n, err = db:execute("NOT VALID SQL")
            expect(n).toBeNil()
            expect(err).toContain("sqlx_postgres.execute:")
            db:close()
        end)

        test("nil binds as NULL (BIGINT column)", function()
            -- Postgres is strict about parameter types — nil binds as
            -- BIGINT NULL, so the receiving column must be numeric.
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS exec_null")
            db:execute("CREATE TABLE exec_null (id INT PRIMARY KEY, v BIGINT)")
            db:execute("INSERT INTO exec_null (id, v) VALUES ($1, $2)", 1, nil)
            local row = db:query_one("SELECT v FROM exec_null WHERE id = 1")
            expect(row.v).toBeNil()
            db:close()
        end)
    end)

    -- query --------------------------------------------------------------------

    describe("query", function()
        test("returns array of row tables", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS q_rows")
            db:execute("CREATE TABLE q_rows (id INT PRIMARY KEY, v TEXT)")
            db:execute("INSERT INTO q_rows VALUES (1, 'a'), (2, 'b')")
            local rows, err = db:query("SELECT id, v FROM q_rows ORDER BY id")
            expect(err).toBeNil()
            expect(#rows).toBe(2)
            expect(rows[1].id).toBe(1)
            expect(rows[1].v).toBe("a")
            expect(rows[2].id).toBe(2)
            expect(rows[2].v).toBe("b")
            db:close()
        end)

        test("empty result returns empty array", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS q_empty")
            db:execute("CREATE TABLE q_empty (id INT PRIMARY KEY)")
            local rows, err = db:query("SELECT * FROM q_empty")
            expect(err).toBeNil()
            expect(#rows).toBe(0)
            db:close()
        end)

        test("WHERE with parameters", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS q_where")
            db:execute("CREATE TABLE q_where (id INT PRIMARY KEY, v TEXT)")
            db:execute("INSERT INTO q_where VALUES (1, 'a'), (2, 'b')")
            local rows = db:query("SELECT v FROM q_where WHERE v = $1", "b")
            expect(#rows).toBe(1)
            expect(rows[1].v).toBe("b")
            db:close()
        end)

        test("DOUBLE PRECISION columns become numbers", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS q_real")
            db:execute("CREATE TABLE q_real (id INT PRIMARY KEY, x DOUBLE PRECISION)")
            db:execute("INSERT INTO q_real VALUES (1, $1)", 3.14)
            local row = db:query_one("SELECT x FROM q_real WHERE id = 1")
            expect(row.x).toBe(3.14)
            db:close()
        end)

        test("BYTEA round-trips through bytes", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS q_bytea")
            db:execute("CREATE TABLE q_bytea (id INT PRIMARY KEY, b BYTEA)")
            db:execute("INSERT INTO q_bytea VALUES (1, $1)", "\0\1\2\254\255")
            local row = db:query_one("SELECT b FROM q_bytea WHERE id = 1")
            expect(row.b).toBe("\0\1\2\254\255")
            db:close()
        end)

        test("BOOLEAN columns become booleans", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS q_bool")
            db:execute("CREATE TABLE q_bool (id INT PRIMARY KEY, b BOOL)")
            db:execute("INSERT INTO q_bool VALUES (1, $1), (2, $2)", true, false)
            local rows = db:query("SELECT id, b FROM q_bool ORDER BY id")
            expect(rows[1].b).toBe(true)
            expect(rows[2].b).toBe(false)
            db:close()
        end)
    end)

    -- query_one ----------------------------------------------------------------

    describe("query_one", function()
        test("returns single row table", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS qo_row")
            db:execute("CREATE TABLE qo_row (id INT PRIMARY KEY, v TEXT)")
            db:execute("INSERT INTO qo_row VALUES (1, 'alice')")
            local row, err = db:query_one("SELECT id, v FROM qo_row WHERE id = $1", 1)
            expect(err).toBeNil()
            expect(row.id).toBe(1)
            expect(row.v).toBe("alice")
            db:close()
        end)

        test("returns nil on no match", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:execute("DROP TABLE IF EXISTS qo_none")
            db:execute("CREATE TABLE qo_none (id INT PRIMARY KEY)")
            local row, err = db:query_one("SELECT * FROM qo_none WHERE id = $1", 999)
            expect(err).toBeNil()
            expect(row).toBeNil()
            db:close()
        end)
    end)

    -- close --------------------------------------------------------------------

    describe("close", function()
        test("subsequent calls return error", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:close()
            local n, err = db:execute("SELECT 1")
            expect(n).toBeNil()
            expect(err).toContain("database is closed")
        end)

        test("idempotent", function()
            local db = sqlx_postgres.open(POSTGRES_URL)
            db:close()
            db:close()
        end)
    end)

end)

container:stop()
