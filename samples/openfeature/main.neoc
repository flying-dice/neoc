//! Demo entry point: wires up a provider, registers flags, and evaluates them.
//!
//! Build the whole sample with `neoc build samples/openfeature/main.neoc`; the
//! `use` graph pulls in every `openfeature::*` module. This file is the only
//! one that touches an I/O `ext` (`print`), keeping the rest of the
//! implementation host-agnostic.

use openfeature::client::Client;

use openfeature::client::client_new;

use openfeature::context::Attribute;

use openfeature::context::EvaluationContext;

use openfeature::context::anonymous_context;

use openfeature::evaluation::EvaluationDetails;

use openfeature::flags::FlagDefinition;

use openfeature::flags::Rule;

use openfeature::flags::Variant;

use openfeature::flags::flag_bool;

use openfeature::flags::flag_number;

use openfeature::flags::flag_string;

use openfeature::hooks::HookLog;

use openfeature::hooks::LoggingHook;

use openfeature::provider::InMemoryProvider;

use openfeature::provider::provider_new;

/// The runtime's line-printing primitive. Bound by the host; the only seam
/// between this program and the world outside neoc.
ext fn print(s: string);

/// Builds the flag catalogue the demo evaluates against.
///
/// - `new-welcome-banner` (boolean): off by default, on for beta-group users —
///   exercises a targeting match and the static default.
/// - `api-url` (string): a single static variant — exercises the `STATIC`
///   reason with no rules.
/// - `cart-limit` (number): disabled — exercises the `DISABLED` reason.
fn catalogue() -> [FlagDefinition] {
    let banner = FlagDefinition { key: "new-welcome-banner", variants: [Variant { name: "on", value: flag_bool(true) }, Variant { name: "off", value: flag_bool(false) }], default_variant: "off", rules: [Rule { attribute: "group", expected: "beta", variant: "on" }], enabled: true };
    let api_url = FlagDefinition { key: "api-url", variants: [Variant { name: "prod", value: flag_string("https://api.example.com") }], default_variant: "prod", rules: [], enabled: true };
    let cart_limit = FlagDefinition { key: "cart-limit", variants: [Variant { name: "standard", value: flag_number(50) }], default_variant: "standard", rules: [], enabled: false };
    [banner, api_url, cart_limit]
}

/// The hook-log sink: prints each stage line indented under its evaluation.
/// `log` is the imported `HookLog`; its fields are bound to annotated `string`
/// locals so the line stays string concatenation (see the README note on
/// cross-module type-directed lowering).
fn trace(log: HookLog) {
    let stage: string = log.stage;
    let message: string = log.message;
    print("  [" + stage + "] " + message);
}

/// Prints an evaluation's final result, separated by a blank line.
fn report(details: EvaluationDetails) {
    let rendered: string = details.render();
    print("=> " + rendered);
    print("");
}

fn main() {
    let provider = provider_new(catalogue());
    let client = client_new(provider, [LoggingHook]);

    // A beta-group user: the banner flag's targeting rule matches, so the flag
    // resolves `on` with reason TARGETING_MATCH.
    let beta = EvaluationContext { targeting_key: "user-42", attributes: [Attribute { key: "group", value: "beta" }] };
    print("# boolean, targeting match");
    report(client.get_boolean_details("new-welcome-banner", false, beta, trace));

    // An anonymous context: no rule matches, so the banner falls back to its
    // default variant `off` with reason STATIC.
    let anon = anonymous_context();
    print("# boolean, static default");
    report(client.get_boolean_details("new-welcome-banner", false, anon, trace));

    // A plain static string flag.
    print("# string, static");
    report(client.get_string_details("api-url", "http://localhost", anon, trace));

    // A disabled flag: returns the caller's default with reason DISABLED.
    print("# number, disabled flag");
    report(client.get_number_details("cart-limit", 10, anon, trace));

    // Requesting a boolean flag as a number: TYPE_MISMATCH, default returned.
    print("# number, type mismatch");
    report(client.get_number_details("new-welcome-banner", 0, anon, trace));

    // An unknown flag key: FLAG_NOT_FOUND, default returned.
    print("# string, flag not found");
    report(client.get_string_details("does-not-exist", "fallback", anon, trace));
}
