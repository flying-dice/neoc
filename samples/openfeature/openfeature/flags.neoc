//! Flag definitions, variants, and targeting rules.
//!
//! A feature flag is a named switch whose evaluated value depends on the
//! caller's context. Because neoc has one structural sum type — the `enum` —
//! a flag's value is modelled as a `FlagValue` tagged union spanning the three
//! primitive shapes OpenFeature evaluates: boolean, string, and number. The
//! object/structure shape from the specification is omitted (see the README);
//! everything else maps cleanly onto these three.
//!
//! A `FlagDefinition` carries its variants (named, typed values), the variant
//! served by default, and a list of targeting rules. A rule matches one
//! attribute of the evaluation context against an expected value and, on a
//! match, selects a variant — the in-memory analogue of a targeting engine.

/// Bridges to the runtime's number-to-string conversion so a numeric flag
/// value can be rendered into a message. The host binds this to its stringify
/// primitive; nothing about that binding is visible to neoc beyond this form.
ext fn tostring(n: number) -> string;

/// A resolved flag value. OpenFeature evaluates boolean, string, and numeric
/// flags; each maps to one variant here. The tag is the value's type, read by
/// the typed evaluation methods to detect a type mismatch.
pub enum FlagValue {
    Bool(bool),
    Str(string),
    Num(number),
}

impl FlagValue {
    /// The specification's type name for this value, used in type-mismatch
    /// messages and for debugging.
    fn type_name(self) -> string {
        match self {
            FlagValue::Bool(_) => "bool",
            FlagValue::Str(_) => "string",
            FlagValue::Num(_) => "number",
        }
    }

    /// Whether this value is a boolean. Used by the client to enforce the
    /// requested type without matching `FlagValue` outside this module.
    fn is_bool(self) -> bool {
        match self {
            FlagValue::Bool(_) => true,
            _ => false,
        }
    }

    /// Whether this value is a string.
    fn is_string(self) -> bool {
        match self {
            FlagValue::Str(_) => true,
            _ => false,
        }
    }

    /// Whether this value is a number.
    fn is_number(self) -> bool {
        match self {
            FlagValue::Num(_) => true,
            _ => false,
        }
    }

    /// A human-readable rendering of the value, for demo output.
    fn render(self) -> string {
        match self {
            FlagValue::Bool(b) => if b {
                "true"
            } else {
                "false"
            },
            FlagValue::Str(s) => s,
            FlagValue::Num(n) => tostring(n),
        }
    }
}

/// Wraps a boolean as a `FlagValue`. Provided as a free function because an
/// importing module cannot construct an imported enum's variant directly
/// (`FlagValue::Bool(b)` from another module degrades in lowering); calling a
/// constructor defined here keeps the variant construction in this module.
pub fn flag_bool(b: bool) -> FlagValue {
    FlagValue::Bool(b)
}

/// Wraps a string as a `FlagValue`. See `flag_bool` for why this is a free
/// function.
pub fn flag_string(s: string) -> FlagValue {
    FlagValue::Str(s)
}

/// Wraps a number as a `FlagValue`. See `flag_bool` for why this is a free
/// function.
pub fn flag_number(n: number) -> FlagValue {
    FlagValue::Num(n)
}

/// A named value a flag can take. The `name` is the specification's "variant"
/// identifier carried through to evaluation details; `value` is what the
/// variant resolves to.
pub struct Variant {
    name: string,
    value: FlagValue,
}

/// A single targeting rule: when the context attribute named `attribute`
/// equals `expected`, serve the variant named `variant`. This is the simplest
/// useful targeting predicate — equality on one attribute — and composes into
/// a rule list evaluated in order.
pub struct Rule {
    attribute: string,
    expected: string,
    variant: string,
}

/// A flag's full definition: its key, the variants it can serve, the variant
/// served when no rule matches (`default_variant`), its targeting rules in
/// priority order, and whether the flag is enabled. A disabled flag short-
/// circuits to the caller's default with reason `DISABLED`.
pub struct FlagDefinition {
    key: string,
    variants: [Variant],
    default_variant: string,
    rules: [Rule],
    enabled: bool,
}

impl FlagDefinition {
    /// Looks up a variant by name. Returns `None` when no variant carries that
    /// name — a misconfigured flag whose `default_variant` or a rule names a
    /// variant that does not exist.
    fn variant_named(self, name: string) -> Option<Variant> {
        for v in self.variants {
            if v.name == name {
                return Some(v);
            }
        }
        None
    }
}
