//! The provider abstraction and an in-memory implementation.
//!
//! A `Provider` is the source of flag values. OpenFeature defines a typed
//! resolve method per flag type; this implementation collapses them into a
//! single `resolve` returning a `ResolutionDetails`, because neoc's `FlagValue`
//! is already a tagged union over the types. The client's typed methods
//! (`evaluation` / `client`) recover the per-type contract by checking the
//! returned value's tag against the requested type.
//!
//! `InMemoryProvider` holds a list of `FlagDefinition`s and evaluates them
//! against the context: a disabled flag returns the default with reason
//! `DISABLED`; an enabled flag's rules are tried in order, and the first
//! matching rule's variant wins with reason `TARGETING_MATCH`; with no match,
//! the flag's `default_variant` wins with reason `STATIC`.

use openfeature::context::EvaluationContext;

use openfeature::evaluation::ResolutionDetails;

use openfeature::evaluation::resolution_disabled;

use openfeature::evaluation::resolution_flag_not_found;

use openfeature::evaluation::resolution_parse_error;

use openfeature::evaluation::resolution_static;

use openfeature::evaluation::resolution_targeting_match;

use openfeature::flags::FlagDefinition;

use openfeature::flags::FlagValue;

use openfeature::flags::Rule;

use openfeature::flags::Variant;

/// The source of flag values. An implementer resolves a flag key against an
/// evaluation context, returning the value and the reason it was chosen. The
/// caller's `default` is handed in so the provider can return it on any error
/// path, honouring the specification's rule that evaluation never throws and
/// always yields a usable value.
pub trait Provider {
    /// The provider's name, for metadata and diagnostics.
    fn name(self) -> string;

    /// Resolves `key` against `context`, falling back to `default` on error.
    fn resolve(self, key: string, default: FlagValue, context: EvaluationContext) -> ResolutionDetails;
}

/// A provider backed by a list of flag definitions held in memory. The list is
/// searched linearly by key; a real provider would index it, but linear search
/// keeps the implementation dependency-free and the behaviour obvious.
pub struct InMemoryProvider {
    flags: [FlagDefinition],
}

/// Builds a provider over the given flag definitions. A free function because
/// an associated function would not resolve when called from another module
/// (see the README note on cross-module lowering).
pub fn provider_new(flags: [FlagDefinition]) -> InMemoryProvider {
    InMemoryProvider { flags: flags }
}

impl InMemoryProvider {
    /// Finds a flag definition by key. Returns `None` when no flag carries that
    /// key, which the resolver maps to a `FLAG_NOT_FOUND` error.
    fn find(self, key: string) -> Option<FlagDefinition> {
        for f in self.flags {
            if f.key == key {
                return Some(f);
            }
        }
        None
    }

    /// The variant selected by the first matching targeting rule, if any. A
    /// rule matches when the context carries its attribute with the expected
    /// value. Returns the variant name to serve, or `None` for no match.
    fn match_rule(self, flag: FlagDefinition, context: EvaluationContext) -> Option<string> {
        for rule in flag.rules {
            let matched = match context.attribute(rule.attribute) {
                Some(actual) => actual == rule.expected,
                None => false,
            };
            if matched {
                return Some(rule.variant);
            }
        }
        None
    }

    /// Resolves a flag that exists: a disabled flag returns the caller's
    /// default with reason `DISABLED`; an enabled flag goes through rule
    /// matching and the static default.
    fn resolve_found(self, flag: FlagDefinition, default: FlagValue, context: EvaluationContext) -> ResolutionDetails {
        if flag.enabled {
            self.resolve_enabled(flag, default, context)
        } else {
            resolution_disabled(default)
        }
    }

    /// Resolves an enabled flag: try the targeting rules, then fall back to the
    /// flag's default variant. A variant named by a rule or by
    /// `default_variant` that does not exist is a configuration error, surfaced
    /// as `PARSE_ERROR`.
    fn resolve_enabled(self, flag: FlagDefinition, default: FlagValue, context: EvaluationContext) -> ResolutionDetails {
        match self.match_rule(flag, context) {
            Some(name) => self.serve(flag, name, default, true),
            None => self.serve(flag, flag.default_variant, default, false),
        }
    }

    /// Serves the named variant of a flag, or reports a `PARSE_ERROR` when the
    /// variant is absent from the flag's definition. `targeting` chooses the
    /// success reason: `TARGETING_MATCH` when a rule selected the variant,
    /// `STATIC` when it is the flag's default. The reason is built by the
    /// `evaluation` module's constructors, never named here — `Reason`'s
    /// variants cannot be constructed outside their own module (see the README).
    fn serve(self, flag: FlagDefinition, name: string, default: FlagValue, targeting: bool) -> ResolutionDetails {
        let key: string = flag.key;
        match flag.variant_named(name) {
            Some(variant) => if targeting {
                resolution_targeting_match(variant.value, variant.name)
            } else {
                resolution_static(variant.value, variant.name)
            },
            None => resolution_parse_error(default, "variant `" + name + "` is not defined on flag `" + key + "`"),
        }
    }
}

impl Provider for InMemoryProvider {
    fn name(self) -> string {
        "InMemoryProvider"
    }

    fn resolve(self, key: string, default: FlagValue, context: EvaluationContext) -> ResolutionDetails {
        match self.find(key) {
            Some(flag) => self.resolve_found(flag, default, context),
            None => resolution_flag_not_found(default, "flag `" + key + "` is not defined"),
        }
    }
}
