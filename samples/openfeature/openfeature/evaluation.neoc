//! Reasons, error codes, and evaluation details.
//!
//! These types are the vocabulary the evaluation flow speaks. A provider
//! produces a `ResolutionDetails` (the value plus why it was chosen); the
//! client wraps it into an `EvaluationDetails` by stamping on the flag key.
//! `Reason` and `ErrorCode` are the specification's enumerations, modelled as
//! neoc `enum`s so a `match` over them is exhaustive by construction.

use openfeature::flags::FlagValue;

/// Why a flag resolved to the value it did. These are the OpenFeature standard
/// reasons. `Cached`, `Split`, `Stale`, and `Unknown` are part of the
/// specification but unused by this in-memory provider; they are included so a
/// caller pattern-matching on `Reason` sees the full set.
pub enum Reason {
    /// A static value with no dynamic evaluation.
    Static,
    /// Fell back to the caller-supplied default value.
    Default,
    /// Selected by a targeting rule matching the evaluation context.
    TargetingMatch,
    /// Selected by pseudorandom assignment (a split).
    Split,
    /// Served from a cache.
    Cached,
    /// The flag is disabled in the management system.
    Disabled,
    /// The reason could not be determined.
    Unknown,
    /// The value is possibly out of date.
    Stale,
    /// The value is the result of an error.
    Error,
}

impl Reason {
    /// The specification's wire label for this reason, as it appears in
    /// evaluation details.
    fn label(self) -> string {
        match self {
            Reason::Static => "STATIC",
            Reason::Default => "DEFAULT",
            Reason::TargetingMatch => "TARGETING_MATCH",
            Reason::Split => "SPLIT",
            Reason::Cached => "CACHED",
            Reason::Disabled => "DISABLED",
            Reason::Unknown => "UNKNOWN",
            Reason::Stale => "STALE",
            Reason::Error => "ERROR",
        }
    }
}

/// What went wrong, when a resolution carries an error. These are the
/// OpenFeature standard error codes. A successful resolution carries
/// `ErrorCode::None`, which has no specification label and signals the absence
/// of an error — neoc has no null, so absence is a variant, not a missing
/// value.
pub enum ErrorCode {
    /// No error: the resolution succeeded.
    None,
    /// The provider was queried before it finished initialising.
    ProviderNotReady,
    /// The flag key does not exist.
    FlagNotFound,
    /// The flag's configuration could not be parsed.
    ParseError,
    /// The flag's type does not match the requested type.
    TypeMismatch,
    /// The evaluation context is missing a required targeting key.
    TargetingKeyMissing,
    /// The evaluation context is otherwise invalid.
    InvalidContext,
    /// An unspecified error.
    General,
}

impl ErrorCode {
    /// The specification's wire label for this error code. `None` has no label
    /// — it is not an error — and renders as the empty string.
    fn label(self) -> string {
        match self {
            ErrorCode::None => "",
            ErrorCode::ProviderNotReady => "PROVIDER_NOT_READY",
            ErrorCode::FlagNotFound => "FLAG_NOT_FOUND",
            ErrorCode::ParseError => "PARSE_ERROR",
            ErrorCode::TypeMismatch => "TYPE_MISMATCH",
            ErrorCode::TargetingKeyMissing => "TARGETING_KEY_MISSING",
            ErrorCode::InvalidContext => "INVALID_CONTEXT",
            ErrorCode::General => "GENERAL",
        }
    }

    /// Whether this code denotes an actual error. Used by hooks to decide
    /// between the `after` (success) and `error` (failure) stages.
    fn is_error(self) -> bool {
        match self {
            ErrorCode::None => false,
            _ => true,
        }
    }
}

/// What a provider returns from a `resolve` call: the value and the metadata
/// explaining it. This is the specification's "resolution details" — the
/// subset of evaluation details a provider produces, before the client stamps
/// on the flag key. `variant` is the name of the served variant (empty when no
/// variant applies); `error_message` elaborates on `error_code`.
pub struct ResolutionDetails {
    value: FlagValue,
    reason: Reason,
    variant: string,
    error_code: ErrorCode,
    error_message: string,
}

/// A successful resolution with an explicit reason and variant. No error.
///
/// These constructors are free functions, not associated functions, and they
/// take the `Reason`/`ErrorCode` as a value built *in this module* — an
/// importing module can neither call an imported type's associated function nor
/// construct an imported enum's variant (both degrade in lowering; see the
/// README). So the reason/error-code-specific wrappers below
/// (`resolution_targeting_match`, `resolution_parse_error`, …) exist to keep
/// every `Reason`/`ErrorCode` construction inside this module.
fn resolution_ok(value: FlagValue, reason: Reason, variant: string) -> ResolutionDetails {
    ResolutionDetails { value: value, reason: reason, variant: variant, error_code: ErrorCode::None, error_message: "" }
}

/// A successful resolution chosen by a targeting rule (reason
/// `TARGETING_MATCH`).
pub fn resolution_targeting_match(value: FlagValue, variant: string) -> ResolutionDetails {
    resolution_ok(value, Reason::TargetingMatch, variant)
}

/// A successful resolution served as the flag's static default (reason
/// `STATIC`).
pub fn resolution_static(value: FlagValue, variant: string) -> ResolutionDetails {
    resolution_ok(value, Reason::Static, variant)
}

/// A disabled-flag resolution: the caller's default value with reason
/// `DISABLED` and no error. Per the specification a disabled flag is not an
/// error — the management system simply chose to serve nothing.
pub fn resolution_disabled(default: FlagValue) -> ResolutionDetails {
    ResolutionDetails { value: default, reason: Reason::Disabled, variant: "", error_code: ErrorCode::None, error_message: "" }
}

/// A failed resolution: the caller's default value (the specification requires
/// evaluation to return the default on error), reason `ERROR`, and the error
/// code and message describing the failure.
fn resolution_fail(default: FlagValue, code: ErrorCode, message: string) -> ResolutionDetails {
    ResolutionDetails { value: default, reason: Reason::Error, variant: "", error_code: code, error_message: message }
}

/// A `FLAG_NOT_FOUND` failure: the requested flag key does not exist.
pub fn resolution_flag_not_found(default: FlagValue, message: string) -> ResolutionDetails {
    resolution_fail(default, ErrorCode::FlagNotFound, message)
}

/// A `PARSE_ERROR` failure: the flag's configuration is malformed (here, a
/// variant name that is not defined).
pub fn resolution_parse_error(default: FlagValue, message: string) -> ResolutionDetails {
    resolution_fail(default, ErrorCode::ParseError, message)
}

/// A `TYPE_MISMATCH` failure: the flag's value type does not match the
/// requested type.
pub fn resolution_type_mismatch(default: FlagValue, message: string) -> ResolutionDetails {
    resolution_fail(default, ErrorCode::TypeMismatch, message)
}

/// The full result of evaluating a flag through the client: a resolution plus
/// the flag key it was evaluated for. This is the specification's "evaluation
/// details", the value returned by the client's `*Details` methods.
pub struct EvaluationDetails {
    flag_key: string,
    details: ResolutionDetails,
}

/// Builds evaluation details by stamping `flag_key` onto a provider's
/// resolution. A free function for the same cross-module reason as
/// `resolution_ok`.
pub fn evaluation_of(flag_key: string, details: ResolutionDetails) -> EvaluationDetails {
    EvaluationDetails { flag_key: flag_key, details: details }
}

impl EvaluationDetails {
    /// A one-line rendering of the evaluation, for demo output: the flag key,
    /// the resolved value, the reason, and — when present — the variant and
    /// error code.
    fn render(self) -> string {
        // `value` is the imported `FlagValue`; binding its rendering to an
        // annotated `string` local keeps the `+` below string concatenation —
        // see the README note on cross-module type-directed lowering.
        let value: string = self.details.value.render();
        let head = self.flag_key + " = " + value + " (" + self.details.reason.label() + ")";
        let with_variant = if self.details.variant != "" {
            head + " variant=" + self.details.variant
        } else {
            head
        };
        if self.details.error_code.is_error() {
            with_variant + " error=" + self.details.error_code.label() + ": " + self.details.error_message
        } else {
            with_variant
        }
    }
}
