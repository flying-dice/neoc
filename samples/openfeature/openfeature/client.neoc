//! The evaluation client: the typed flag-evaluation API.
//!
//! The client is what application code calls. It holds a provider and a list
//! of hooks, and for each evaluation it runs the hook stages around the
//! provider's `resolve`, enforces the requested type, and returns evaluation
//! details. The specification's typed methods are realised as
//! `get_boolean` / `get_string` / `get_number` (value) and their `*_details`
//! variants.
//!
//! Type enforcement is the client's job: the provider returns a `FlagValue`
//! whose tag is its actual type; if that tag does not match the requested type
//! the client replaces the resolution with a `TYPE_MISMATCH` error carrying the
//! caller's default, exactly as the specification requires (return the default,
//! never throw).
//!
//! Hook output flows through a `fn(HookLog)` sink the caller supplies, rather
//! than a returned list: neoc has no list-append operator, and a sink also
//! lets each stage's line surface in real firing order. The demo's sink prints;
//! a test's sink could collect.

use openfeature::context::EvaluationContext;

use openfeature::evaluation::ErrorCode;

use openfeature::evaluation::EvaluationDetails;

use openfeature::evaluation::ResolutionDetails;

use openfeature::evaluation::evaluation_of;

use openfeature::evaluation::resolution_type_mismatch;

use openfeature::flags::FlagValue;

use openfeature::flags::flag_bool;

use openfeature::flags::flag_number;

use openfeature::flags::flag_string;

use openfeature::hooks::Hook;

use openfeature::hooks::HookContext;

use openfeature::hooks::HookLog;

use openfeature::hooks::LoggingHook;

use openfeature::provider::InMemoryProvider;

use openfeature::provider::Provider;

/// Builds the `TYPE_MISMATCH` resolution for a value whose type did not match
/// the request. An already-failed resolution (the provider reported its own
/// error) is passed through unchanged so the original, more specific error code
/// survives. Defined ahead of the functions that call it: a private `fn`
/// referenced before its definition does not resolve at runtime (see the
/// README note on definition order).
fn type_mismatch(resolved: ResolutionDetails, default: FlagValue, requested: string) -> ResolutionDetails {
    if resolved.error_code.is_error() {
        resolved
    } else {
        // `value` is the imported `FlagValue`; bind its type name to an
        // annotated `string` local so the message stays string concatenation.
        let actual: string = resolved.value.type_name();
        resolution_type_mismatch(default, "flag is " + actual + ", requested " + requested)
    }
}

/// Coerces a resolution to a boolean: passes a boolean value through
/// unchanged, turns any other type into a `TYPE_MISMATCH` carrying the default.
/// The default is always a boolean here, so the error path still returns a
/// usable value. The type test is `FlagValue::is_bool`, a method on the value's
/// own module — an importing module cannot match `FlagValue`'s variants
/// directly (see the README note on cross-module lowering).
fn coerce_bool(resolved: ResolutionDetails, default: FlagValue) -> ResolutionDetails {
    if resolved.value.is_bool() {
        resolved
    } else {
        type_mismatch(resolved, default, "bool")
    }
}

/// Coerces a resolution to a string.
fn coerce_string(resolved: ResolutionDetails, default: FlagValue) -> ResolutionDetails {
    if resolved.value.is_string() {
        resolved
    } else {
        type_mismatch(resolved, default, "string")
    }
}

/// Coerces a resolution to a number.
fn coerce_number(resolved: ResolutionDetails, default: FlagValue) -> ResolutionDetails {
    if resolved.value.is_number() {
        resolved
    } else {
        type_mismatch(resolved, default, "number")
    }
}

/// The evaluation client. Holds the provider that resolves flags and the hooks
/// that wrap each evaluation.
pub struct Client {
    provider: InMemoryProvider,
    hooks: [LoggingHook],
}

/// Builds a client over a provider and a list of hooks. A free function for
/// the same cross-module reason as `resolution_ok`.
pub fn client_new(provider: InMemoryProvider, hooks: [LoggingHook]) -> Client {
    Client { provider: provider, hooks: hooks }
}

impl Client {
    /// Emits an optional hook log to the sink, if the stage produced one.
    fn emit(self, sink: fn(HookLog), produced: Option<HookLog>) {
        match produced {
            Some(log) => sink(log),
            None => {},
        }
    }

    /// Runs the `before` stage for every hook, emitting each produced line.
    fn run_before(self, context: HookContext, sink: fn(HookLog)) {
        for hook in self.hooks {
            self.emit(sink, hook.before(context));
        }
    }

    /// Runs the success/failure stage for every hook — `after` when the
    /// evaluation succeeded, `error` when it failed — then `finally` for all,
    /// emitting each produced line.
    fn run_after(self, context: HookContext, details: EvaluationDetails, sink: fn(HookLog)) {
        let failed = details.details.error_code.is_error();
        for hook in self.hooks {
            let stage = if failed {
                hook.error(context, details)
            } else {
                hook.after(context, details)
            };
            self.emit(sink, stage);
            self.emit(sink, hook.finally(context));
        }
    }

    /// The core evaluation flow shared by every typed method: build the hook
    /// context, run `before`, resolve through the provider, coerce the result
    /// to the requested type, run `after`/`error`/`finally`, and return the
    /// details. Hook lines flow to `sink` in firing order.
    fn evaluate(self, key: string, flag_type: string, default: FlagValue, context: EvaluationContext, coerce: fn(ResolutionDetails, FlagValue) -> ResolutionDetails, sink: fn(HookLog)) -> EvaluationDetails {
        let hook_context = HookContext { flag_key: key, flag_type: flag_type };
        self.run_before(hook_context, sink);
        let resolved = self.provider.resolve(key, default, context);
        let typed = coerce(resolved, default);
        let details = evaluation_of(key, typed);
        self.run_after(hook_context, details, sink);
        details
    }

    /// Evaluates a boolean flag, returning full details. A non-boolean resolved
    /// value becomes a `TYPE_MISMATCH` carrying `default`.
    fn get_boolean_details(self, key: string, default: bool, context: EvaluationContext, sink: fn(HookLog)) -> EvaluationDetails {
        self.evaluate(key, "bool", flag_bool(default), context, coerce_bool, sink)
    }

    /// Evaluates a string flag, returning full details.
    fn get_string_details(self, key: string, default: string, context: EvaluationContext, sink: fn(HookLog)) -> EvaluationDetails {
        self.evaluate(key, "string", flag_string(default), context, coerce_string, sink)
    }

    /// Evaluates a numeric flag, returning full details.
    fn get_number_details(self, key: string, default: number, context: EvaluationContext, sink: fn(HookLog)) -> EvaluationDetails {
        self.evaluate(key, "number", flag_number(default), context, coerce_number, sink)
    }
}
