# Rust build output
/target

# CI — cargo cache and build artifacts land here during pipeline runs
/.cargo
/artifacts

# OS / editor metadata
.DS_Store
**/.DS_Store
.idea/
*.swp
*.swo

# Test scratch
.tmp/

# JavaScript, apps and Storybook (vos: client, packages, e2e)
node_modules
dist
.eslintcache
*.log*
.playwright-mcp
storybook-static
*storybook.log
test-results
playwright-report
# Screenshots are never kept in the repository: the specs write theirs under test-results/screenshots, as evidence of a
# run, and nothing compares against them (no baselines)
__screenshots__

# Per-developer Claude Code settings (project skills/workflows are committed)
.claude/settings.local.json
.claude/worktrees/

# The app kit build output (packages/kit: bun run build:kit); Vite copies it into client/dist/kit
/client/public/kit

# Generated editor types for the kit's type fixtures (scripts/kit-types.test.ts)
/packages/kit/fixtures/**/generated
