{
  "name": "@vos/kit",
  "version": "0.1.0",
  "private": true,
  "description": "The vos app kit: design tokens and web components (Lit) that every app frame loads from /kit/tokens.css and /kit/kit.js",
  "type": "module",
  "types": "./src/index.ts",
  "scripts": {
    "build": "vite build && cem analyze --config custom-elements-manifest.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "storybook": "storybook dev -p 6007 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "lit": "3.3.2"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/web-components-vite": "10.6.7",
    "@types/react": "19",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "prettier": "^3.9.10",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.4"
  }
}
