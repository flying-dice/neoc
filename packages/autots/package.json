{
  "name": "@neoc-sh/autots",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Generate a .neoc ext header from a TypeScript project's public surface, for neoc <-> TS interop.",
  "type": "module",
  "bin": {
    "autots": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/generate.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "neoc",
    "typescript",
    "ts-morph",
    "codegen",
    "ffi",
    "interop"
  ],
  "license": "MIT",
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/yargs": "^17.0.35",
    "typescript": "^6.0.3"
  }
}
