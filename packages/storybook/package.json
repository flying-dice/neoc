{
  "name": "@agentos/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Storybook setup for every AgentOS app: config factory, preview (tokens, themes, a11y), and the AppWindow frame",
  "type": "module",
  "exports": {
    "./main": "./main.ts",
    "./preview": "./preview.ts",
    "./AppWindow.svelte": {
      "types": "./AppWindow.svelte",
      "svelte": "./AppWindow.svelte",
      "default": "./AppWindow.svelte"
    }
  },
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@agentos/sdk": "workspace:*",
    "@agentos/ui": "workspace:*"
  },
  "peerDependencies": {
    "storybook": "10.6.7",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3"
  }
}
