{
  "name": "@agentos/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "AgentOS SDK: the contract between app modules, the PWA client and the Bun server (manifest, app server/client APIs, JSON-RPC host protocol, bundle format, bundle build)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./app/server": {
      "types": "./src/app/server.ts",
      "default": "./src/app/server.ts"
    },
    "./app/client": {
      "types": "./src/app/client.ts",
      "svelte": "./src/app/client.ts",
      "default": "./src/app/client.ts"
    },
    "./host/protocol": {
      "types": "./src/host/protocol.ts",
      "default": "./src/host/protocol.ts"
    },
    "./host/server": {
      "types": "./src/host/server.ts",
      "default": "./src/host/server.ts"
    },
    "./host/client": {
      "types": "./src/host/client.ts",
      "default": "./src/host/client.ts"
    },
    "./rpc": {
      "types": "./src/rpc/index.ts",
      "default": "./src/rpc/index.ts"
    },
    "./bundle": {
      "types": "./src/bundle.ts",
      "default": "./src/bundle.ts"
    },
    "./build": {
      "types": "./src/build/index.ts",
      "default": "./src/build/index.ts"
    },
    "./testing": {
      "types": "./src/testing/index.ts",
      "default": "./src/testing/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "zod": "^4.0.0",
    "electron": ">=30"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "svelte": "^5.57.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7",
    "@types/bun": "^1.4.4"
  },
  "dependencies": {
    "@agentos/ui": "workspace:*",
    "@agentclientprotocol/sdk": "2.7.0"
  }
}
