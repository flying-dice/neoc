{
  "name": "@agentos/ui",
  "version": "0.1.0",
  "private": true,
  "description": "AgentOS UI kit \u2014 iOS / iPadOS (pre-Liquid Glass) design language for Svelte 5",
  "type": "module",
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./atoms": {
      "types": "./src/atoms/index.ts",
      "svelte": "./src/atoms/index.ts",
      "default": "./src/atoms/index.ts"
    },
    "./molecules": {
      "types": "./src/molecules/index.ts",
      "svelte": "./src/molecules/index.ts",
      "default": "./src/molecules/index.ts"
    },
    "./organisms": {
      "types": "./src/organisms/index.ts",
      "svelte": "./src/organisms/index.ts",
      "default": "./src/organisms/index.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "svelte": "./src/templates/index.ts",
      "default": "./src/templates/index.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test ./src",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/svelte-vite": "10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "storybook": "10.6.7",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "marked": "18.1.2"
  }
}
