// The application, in pure neoc — the controllers.
//
// This file is 100% neoc: business logic over the autosql DAO, generic over the
// `SqlExecutor` *port*. There is no host concern here — no HTTP, no `bun:sqlite`,
// no entry point, no `ext` adapter wiring. `neoc build` transpiles the project
// rooted at this module to `main.js` + `main.d.ts` (plus the autosql modules and
// the shared `neoc-lib.{js,d.ts}` carrying the `Result`/`Option`/`SqlValue`
// helpers). The TypeScript host imports these typed controllers, *implements*
// the `SqlExecutor` port over `bun:sqlite`, and dispatches HTTP routes to them.
use autosql::ports::SqlExecutor;
use autosql::migrate::migrate;
use autosql::add_note::add_note;
use autosql::list_notes::ListNotesRow;
use autosql::list_notes::list_notes;

// Create the schema. The host calls this once at startup.
pub fn init<E: SqlExecutor>(db: E) -> Result<number, string> {
    migrate(db)
}

// Every note, in id order.
pub fn list<E: SqlExecutor>(db: E) -> Result<[ListNotesRow], string> {
    list_notes(db)
}

// Add a note. The business rule lives here, in neoc: an empty body is rejected
// before it ever reaches the database.
pub fn create<E: SqlExecutor>(db: E, body: string) -> Result<number, string> {
    if body == "" {
        Err("body must not be empty")
    } else {
        add_note(db, body)
    }
}
